{
  "name": "polski",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm search-index && pnpm dict:publish && pnpm drills && nuxt dev",
    "build": "nuxt build",
    "generate": "pnpm validate && pnpm search-index && pnpm dict:publish && pnpm drills && tsx scripts/preview-refresh.ts --snapshot && nuxt generate && tsx scripts/preview-refresh.ts --commit",
    "preview": "serve .output/public -l 4173",
    "preview:refresh": "tsx scripts/preview-refresh.ts",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "validate": "tsx scripts/validate-content.ts",
    "search-index": "tsx scripts/build-search-index.ts",
    "drills": "tsx scripts/build-drills.ts",
    "test:e2e": "playwright test",
    "dict:fetch": "tsx scripts/dictionary/cli/fetch.ts",
    "dict:fixtures": "tsx scripts/dictionary/cli/fixtures.ts",
    "dict:rank": "tsx scripts/dictionary/cli/rank.ts",
    "dict:draft": "tsx scripts/dictionary/cli/draft.ts",
    "dict:build": "tsx scripts/dictionary/cli/build.ts",
    "dict:publish": "tsx scripts/dictionary/cli/publish.ts",
    "dict:status": "tsx scripts/dictionary/cli/status.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/sitemap": "^8.5.1",
    "minisearch": "^7.2.0",
    "nuxt": "^4.5.2",
    "zod": "^3.25.76"
  }
}
