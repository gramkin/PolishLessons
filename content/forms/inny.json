  "tatoeba": {
    "349059": {
      "pl": "Mogę się tylko domyślać, czy tak samo sądzą inni.",
      "ru": "Я могу только догадываться, так ли это и для всех остальных."
    },
    "364803": {
      "pl": "Nie szukaj błędów w innych.",
      "ru": "Не ищи недостатки у других."
    },
    "366204": {
      "pl": "Jedni lubią czerwone wino, inni białe.",
      "ru": "Одни любят красное вино, другие белое."
    },
    "366761": {
      "pl": "Innymi słowy, to leń.",
      "ru": null
    },
    "393336": {
      "pl": "Bądź uprzejmy dla innych.",
      "ru": "Будь добр с другими."
    },
