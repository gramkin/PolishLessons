    },
    "733096": {
      "pl": "Jedni wolą morze, inni góry.",
      "ru": "Одни предпочитают море, другие — горы."
    },
    "950997": {
      "pl": "Kto inny nie będzie w stanie wykonać mojej pracy.",
      "ru": "Я не думаю, что кто-либо другой сможет сделать мою работу."
    },
    "3093099": {
      "pl": "Zróbmy coś innego.",
      "ru": "Давай сделаем что-нибудь другое."
    },
    "3660808": {
