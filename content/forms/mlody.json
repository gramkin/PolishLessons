  "tatoeba": {
    "349629": {
      "pl": "Jesteś młodym Amerykaninem.",
      "ru": "Ты молодой американец."
    },
    "351977": {
      "pl": "Mój młodszy brat jeszcze śpi.",
      "ru": "Мой младший брат ещё спит."
    },
    "353143": {
      "pl": "Jestem najmłodszy w rodzinie.",
      "ru": null
    },
    "354106": {
      "pl": "Jej najmłodsze dziecko ma 5 lat.",
      "ru": null
    },
    "355305": {
      "pl": "Młodemu inżynierowi brakowało doświadczenia.",
      "ru": null
    },
    "521317": {
      "pl": "To ojciec panny młodej.",
      "ru": null
    },
    "612977": {
      "pl": "Dałem słownik młodszemu bratu.",
      "ru": null
    },
    "659734": {
      "pl": "Byliśmy wtedy młodsi.",
      "ru": null
    },
    "982922": {
      "pl": "Pomiatal młodszym bratem.",
      "ru": null
    },
    "999196": {
      "pl": "Wielu młodych Rzymian jeździło do Grecji.",
      "ru": "Много молодых римлян ездило в Грецию."
    },
    "999388": {
      "pl": "Niektóre zwierzęta pożerają swoje młode.",
      "ru": "Некоторые животные поедают своих детёнышей."
    },
    "1853815": {
      "pl": "Była młoda i niewinna.",
      "ru": "Она была молода и невинна."
    },
    "2139047": {
      "pl": "Nie mogę odróżnić od siebie Toma i jego młodszego brata.",
      "ru": "Я не могу отличить Тома от его младшего брата."
    },
    "2495839": {
      "pl": "Jezioro, usiane wyspami, przyciągało uwagę młodych podróżników.",
      "ru": "Озеро, усеянное островами, привлекло внимание юных путешественников."
    },
    "2519059": {
      "pl": "Mój młodszy brat głośno krzyczy.",
      "ru": "Мой младший брат очень громко плачет."
    },
    "2809335": {
      "pl": "Byłeś młody.",
      "ru": "Ты был молод."
    },
    "3298163": {
      "pl": "Jestem najmłodszy w swojej pracy.",
      "ru": "На своей работе я самый младший."
    },
    "3313260": {
      "pl": "Jest pięć lat młodsza ode mnie.",
      "ru": "Она на пять лет младше меня."
    },
    "3542164": {
      "pl": "Chłopaki, nie warto otwierać tego tematu. Jesteście młodzi, żartobliwi, dla was wszystko jest łatwe. To nie jest. To nie jest Czikatiło i nawet nie archiwa służb specjalnych. Tutaj lepiej nie włazić. Poważnie, każdy z was będzie żałować. Najlepiej zamknijcie temat i zapomnijcie, co się tu pisało. Całkiem rozumiem, że tą wiadomością wywołam dodatkowe zainteresowanie, ale chcę od razu ostrzec dociekliwych - stop. Pozostałych po prostu nie znajdą.",
      "ru": "Ребята, не стоит вскрывать эту тему. Вы молодые, шутливые, вам все легко. Это не то. Это не Чикатило и даже не архивы спецслужб. Сюда лучше не лезть. Серьезно, любой из вас будет жалеть. Лучше закройте тему и забудьте, что тут писалось. Я вполне понимаю, что данным сообщением вызову дополнительный интерес, но хочу сразу предостеречь пытливых – стоп. Остальных просто не найдут."
    },
    "3703866": {
      "pl": "Młodzi ludzie z reguły są pełni energii.",
      "ru": "Молодые люди, как правило, полны энергии."
    },
    "3743777": {
      "pl": "Tomasz jest młody.",
      "ru": "Том молодой."
    },
    "4101650": {
      "pl": "Ulice pełne były młodych par.",
      "ru": null
    },
    "4406439": {
      "pl": "Nowa dziewczyna Toma jest bardzo młoda.",
      "ru": "Новая девушка Тома очень молода."
    },
    "5183800": {
      "pl": "Jest młodą studentką.",
      "ru": "Она молодая студентка."
    },
    "6160206": {
      "pl": "Sadzonki to młode rośliny.",
      "ru": null
    },
    "6309252": {
      "pl": "Co u twojej młodszej siostry?",
      "ru": null
    },
    "6313151": {
      "pl": "Jesteśmy młodzi.",
      "ru": "Мы молоды."
    },
    "6670172": {
      "pl": "Mam młodszą siostrę.",
      "ru": null
    },
    "6671552": {
      "pl": "Mam młodszego brata.",
      "ru": null
    },
    "6729874": {
      "pl": "Mam trzy młodsze siostry.",
      "ru": null
    },
    "8623171": {
      "pl": "Jestem najmłodszym dzieckiem.",
      "ru": "Я самый младший ребёнок."
    },
    "9008211": {
      "pl": "Ona jest młodsza od niego.",
      "ru": null
    },
    "10768404": {
      "pl": "Jestem trzy lata od niego młodsza.",
      "ru": "Я на три года моложе его."
    },
    "10793798": {
      "pl": "Jestem najmłodsza w moim oddziale.",
      "ru": null
    },
    "11835157": {
      "pl": "On ma piękną, młodą żonę.",
      "ru": null
    },
    "12312150": {
      "pl": "Jest panem młodym.",
      "ru": null
    },
    "12312151": {
      "pl": "Czy znasz pana młodego?",
      "ru": null
    },
    "12470143": {
      "pl": "Sen to młodszy brat śmierci.",
      "ru": "Сон - младший брат смерти."
    },
    "12470522": {
      "pl": "Jesteś jeszcze na to za młoda.",
      "ru": "Ты для этого ещё слишком молода."
    },
