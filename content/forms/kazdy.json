  "tatoeba": {
    "357286": {
      "pl": "Każdy ma swoje wady.",
      "ru": "У каждого есть свои недостатки."
    },
    "415227": {
      "pl": "Każdemu żal umierać.",
      "ru": null
    },
    "636046": {
      "pl": "Każde dziecko dostało upominek.",
      "ru": "Каждому ребёнку дали подарок."
    },
    "660363": {
      "pl": "Każde zdanie w tej książce jest ważne.",
      "ru": "В этой книге каждое предложение важно."
    },
    "692605": {
      "pl": "Podzieliła ciasto na sześć kawałków i dała po jednym każdemu dziecku.",
      "ru": "Она разрезала торт на шесть кусков и дала каждому ребёнку по одному."
    },
    "1353468": {
      "pl": "Bierze kąpiel każdego ranka.",
      "ru": "Он принимает ванну каждое утро."
    },
    "1449603": {
      "pl": "Wybierzcie przedstawiciela każdej z grup.",
      "ru": "Выберите представителя от каждой группы."
    },
    "1794051": {
      "pl": "Każdy decyduje za siebie.",
      "ru": "Каждый решает для себя сам."
    },
    "1913840": {
      "pl": "Każdy to może zrobić.",
      "ru": "Это любой может сделать."
    },
    "3750229": {
      "pl": "Mogę zacząć w każdej chwili.",
      "ru": "Я могу начать в любую минуту."
    },
    "3786689": {
      "pl": "Każdego ranka golę się.",
      "ru": "Я бреюсь каждое утро."
    },
    "3936698": {
      "pl": "W każdym z nas śpi geniusz.",
      "ru": "В каждом из нас спит гений."
    },
    "4482463": {
      "pl": "Idź na spacer każdego dnia.",
      "ru": "Гуляй каждый день."
    },
    "6109675": {
      "pl": "Każdy może się pomylić.",
      "ru": "Каждый может ошибиться."
    },
    "6155769": {
      "pl": "Biedronka każdemu kojarzy się z małym owadem o jaskrawo czerwonym pancerzyku, ozdobionym kilkoma czarnymi kropkami.",
      "ru": "Божья коровка у каждого ассоциируется с маленьким насекомым с ярко-красным панцирем, украшенным несколькими чёрными точками."
    },
    "6160701": {
      "pl": "W każdej chwili.",
      "ru": null
    },
    "6207810": {
      "pl": "Czy każda kobieta jest stworzona do macierzyństwa?",
      "ru": "Каждая ли женщина создана для материнства?"
    },
    "6207859": {
      "pl": "Twierdzą, że ramach gwarancji naprawiona zostanie każda usterka, niezależnie czy było to uszkodzenie mechaniczne, czy wada fabryczna.",
      "ru": "Они утверждают, что в рамках гарантии будет отремонтирована каждая неисправность, независимо от того, было ли это механическое повреждение или заводской брак."
    },
    "11517749": {
      "pl": "Każde państwo ma swój rząd.",
      "ru": "У каждого государства есть своё правительство."
    },
    "12227370": {
      "pl": "Każda bajka ma swój koniec.",
      "ru": "У каждой сказки свой конец."
    },
    "12454008": {
      "pl": "Podpisz każdą stronę.",
      "ru": null
    },
    "12696348": {
      "pl": "Słabnę z każdym dniem.",
      "ru": "Я слабею с каждым днём."
    },
    "13784968": {
      "pl": "Oni w każdym razie muszą zachować twarz.",
      "ru": "Им в любом случае надо сохранить лицо."
    }
  }
