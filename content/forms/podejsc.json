  "tatoeba": {
    "535459": {
      "pl": "Podszedłem do drzwi wejściowych.",
      "ru": null
    },
    "568247": {
      "pl": "Podszedł do niej.",
      "ru": null
    },
    "611627": {
      "pl": "Podszedł do mnie.",
      "ru": null
    },
    "751561": {
      "pl": "Ona ma podejście do dzieci.",
      "ru": null
    },
    "840269": {
      "pl": "Wstała i podeszła do okna.",
      "ru": null
    },
    "907953": {
      "pl": "Kiedy wszedł do sali, podeszło do niego dwóch mężczyzn.",
      "ru": null
    },
    "1735708": {
      "pl": "A później podejdziemy i zobaczymy.",
      "ru": "А потом мы подойдём и посмотрим."
    },
    "1736217": {
      "pl": "Spróbujemy podejść, zrobimy jedno zajście, ale prawdopodobnie nic z tego nie będzie.",
      "ru": "Попробуем подойти, сделаем один заход, скорее всего, ничего из этого не получится."
    },
    "1736693": {
      "pl": "W przypadku nieudanego podejścia, odchodzimy w automacie.",
      "ru": "В случае неудачного захода, уходим на автомате."
    },
    "3750193": {
      "pl": "Podeszłam, aby przyjrzeć się temu z bliska.",
      "ru": null
    },
    "5999407": {
      "pl": "Problemy obecnych czasów wymagają nowego podejścia.",
      "ru": null
    },
    "6327931": {
      "pl": "Podejdź bliżej.",
      "ru": null
    },
    "6406198": {
      "pl": "Podeszłam do mężczyzny pijącego piwo.",
      "ru": "Я подошла к мужчине, пившему пиво."
    },
    "9532932": {
      "pl": "To jest nowe podejście.",
      "ru": "Это новый подход."
    },
    "9805801": {
      "pl": "Udało mi się za pierwszym podejściem.",
      "ru": null
    },
    "10202662": {
      "pl": "Dzik zabił już kilku myśliwych, którzy podeszli zbyt blisko.",
      "ru": "Кабан уже убил несколько охотников, которые слишком близко подошли."
    },
    "10596733": {
      "pl": "Podejdźcie bliżej.",
      "ru": null
    },
    "11624902": {
      "pl": "Proszę tu podejść.",
      "ru": null
    },
    "12359752": {
      "pl": "Podejdź.",
      "ru": null
    },
    "12476578": {
      "pl": "Kara klacz podeszła do ogrodzenia.",
      "ru": null
    },
    "12959972": {
      "pl": "Powieść, którą opublikował w zeszłym roku zgłębia uniwersalne tematy, ale z wyjątkowym i osobistym podejściem.",
      "ru": null
    },
    "13430288": {
      "pl": "Napisz mi, kiedy podejdziesz.",
      "ru": null
    },
    "13659494": {
      "pl": "Serce podeszło mi do gardła.",
