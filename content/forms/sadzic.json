  "tatoeba": {
    "349059": {
      "pl": "Mogę się tylko domyślać, czy tak samo sądzą inni.",
      "ru": "Я могу только догадываться, так ли это и для всех остальных."
    },
    "357042": {
      "pl": "Sądziliśmy, że ten plan skończy się porażką.",
      "ru": null
    },
    "360201": {
      "pl": "Sądząc po wyglądzie nieba, może padać.",
      "ru": null
    },
    "361649": {
      "pl": "Sądził, że jest szczęśliwa.",
      "ru": null
    },
    "529960": {
      "pl": "Nie sądzisz?",
      "ru": null
    },
    "600389": {
      "pl": "Sądzimy, że Wenecja to fascynujące miasto.",
      "ru": null
    },
    "631446": {
      "pl": "Co sądzisz o jego pomyśle?",
      "ru": "Что ты думаешь о его идее?"
    },
    "708122": {
      "pl": "Dawniej ludzie nie sądzili, że Ziemia jest kulista.",
      "ru": null
    },
    "716730": {
      "pl": "Nie sądziła, że jej marzenia się spełnią.",
      "ru": null
    },
    "768796": {
      "pl": "Nie sądź po pozorach.",
      "ru": null
    },
    "830386": {
      "pl": "Co sądzicie o tym projekcie?",
      "ru": null
    },
    "852765": {
      "pl": "Nie sądziłem, że przyjdzie.",
      "ru": null
    },
    "919311": {
      "pl": "Dzieci Łazarza sądzą, że ich matka Felicja jest najpiękniejszą kobietą na świecie.",
      "ru": "Дети Лазажа думают, что их мама Фелиция — самая красивая женщина на свете."
    },
    "948015": {
      "pl": "Co pan sądzi?",
      "ru": null
    },
    "982791": {
      "pl": "Ona sądzi, że zawsze ma rację.",
      "ru": "Она думает, что всегда права."
    },
    "1353245": {
      "pl": "Nie sądzę, by ktokolwiek potrafił naprawić ten zegarek.",
      "ru": "Я не думал, что хоть кто-то сможет починить эти часы."
    },
    "3188033": {
      "pl": "Kiedyś sądzono, że Ziemia jest centrum wszechświata.",
      "ru": "Когда-то считалось, что Земля — центр Вселенной."
    },
    "6327929": {
      "pl": "Też tak sądzę.",
      "ru": "Я тоже так считаю."
    },
    "6327938": {
      "pl": "Co pani o tym sądzi?",
      "ru": "Что вы об этом думаете?"
    },
    "6328294": {
      "pl": "Powiedz, co o tym sądzisz.",
      "ru": "Скажи, что ты об этом думаешь."
    },
    "9686257": {
      "pl": "Co Mary i Tom o tym sądzą?",
      "ru": null
    },
    "11577918": {
      "pl": "Nie sądźcie, abyście nie byli sądzeni.",
      "ru": null
    },
    "12060469": {
      "pl": "Nie sądziłam, że jesteś samotny.",
      "ru": null
    },
    "13030211": {
      "pl": "Ówcześnie sądzono, że to niemożliwe.",
      "ru": null
    },
    "13573529": {
      "pl": "Nie masz prawa sądzić tych ludzi.",
      "ru": null
    },
    "13660043": {
      "pl": "Nie sądzę, żeby Tom zrozumiał.",
      "ru": "Не думаю, что Том понял."
    }
  }
