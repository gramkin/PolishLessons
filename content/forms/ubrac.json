    "529541": {
      "pl": "Te dwie dziewczyny ubrały take same suknie na tańce.",
      "ru": null
    },
    "540039": {
      "pl": "Aby uniknąć zamieszania, drużyny ubrały stroje w różnych kolorach.",
      "ru": null
    },
    "603342": {
      "pl": "Mayuko zaprojektowała swoje ubranie.",
      "ru": "Маюко сама разработала дизайн своей одежды."
    },
    "831850": {
      "pl": "Moje ubranie jest szare.",
