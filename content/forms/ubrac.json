  "tatoeba": {
    "363548": {
      "pl": "Wydaję na ubrania mniej niż moja siostra.",
      "ru": "Я трачу меньше денег на одежду, чем моя сестра."
    },
    "527528": {
      "pl": "Jakiego rodzaju biżuterię ubierzesz do tej sukni.",
      "ru": null
    },
    "529534": {
      "pl": "Meg była jedyną dziewczyną ubraną w dżinsy.",
      "ru": null
