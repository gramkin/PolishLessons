    },
    "2679343": {
      "pl": "Ucho mnie swędzi.",
      "ru": null
    },
    "2831813": {
      "pl": "Mówca to ktoś kto sprawia że ludzie widzą uszami.",
      "ru": null
    },
    "3085218": {
      "pl": "Tom wyjął zatyczki do uszu.",
      "ru": null
    },
    "3997787": {
      "pl": "Nie mogłem uwierzyć swoim uszom.",
