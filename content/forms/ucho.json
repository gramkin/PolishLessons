  "tatoeba": {
    "360062": {
      "pl": "Jej głos wciąż brzmi mi w uszach.",
      "ru": null
    },
    "363170": {
      "pl": "Nie wierzył własnym uszom.",
      "ru": null
    },
    "363538": {
      "pl": "Dzwoni mi w uszach.",
      "ru": null
    },
    "502338": {
      "pl": "Ściany mają uszy, drzwi mają oczy.",
      "ru": "У стен есть уши, у дверей есть глаза."
    },
    "529144": {
      "pl": "Króliki mają długie uszy.",
      "ru": "У кроликов длинные уши."
    },
    "776052": {
      "pl": "Przyłożyłem słuchawkę do ucha.",
      "ru": null
    },
    "898761": {
      "pl": "Słyszymy uszami.",
      "ru": null
    },
    "960715": {
      "pl": "Królik ma długie uszy i krótki ogon.",
      "ru": "У кролика длинные уши и короткий хвост."
    },
    "1085562": {
      "pl": "W uszach slyszę jeszcze jej głos.",
      "ru": null
    },
    "1187827": {
      "pl": "Kot ma dwoje uszu.",
      "ru": "У кошки два уха."
    },
    "1197569": {
      "pl": "Nadstawiłem uszu.",
