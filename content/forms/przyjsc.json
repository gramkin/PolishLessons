  "tatoeba": {
    "354088": {
      "pl": "Nie przyszedłbyś?",
      "ru": null
    },
    "356963": {
      "pl": "Grupa ruszyła zaraz po jego przyjściu.",
      "ru": null
    },
    "365143": {
      "pl": "Kiedy przyszedłem do domu, moja siostra grała na gitarze.",
      "ru": "Когда я пришёл домой, моя сестра играла на гитаре."
    },
    "366194": {
      "pl": "Przyjdź jak najszybciej.",
      "ru": "Приди как можно быстрее."
    },
    "366249": {
      "pl": "Czekam na przyjście kolegi.",
      "ru": null
    },
    "366688": {
      "pl": "Przyszła wiosna.",
      "ru": "Наступила весна."
    },
    "369692": {
      "pl": "Przyszedłem, zobaczyłem, zwyciężyłem.",
