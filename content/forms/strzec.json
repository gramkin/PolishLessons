  "tatoeba": {
    "760349": {
      "pl": "Strzeżonego pan Bóg strzeże.",
      "ru": null
    },
    "2164696": {
      "pl": "Strzeż się psa!",
      "ru": null
    },
    "4799836": {
      "pl": "To świetnie strzeżony grobowiec.",
      "ru": null
    },
    "5890570": {
      "pl": "Strzeż się id marcowych!",
      "ru": null
    },
    "12286185": {
      "pl": "Najlepiej strzeżoną tajemnicą jest ta, której nikt nie ujawnia.",
      "ru": null
    },
    "12470597": {
      "pl": "Łabędzie zaciekle strzegą swoich piskląt.",
      "ru": null
    },
    "12586577": {
      "pl": "Prawdę mówiąc, chciałabym być księżniczką i żyć w wierzy, strzeżonej przez siedem smoków, i żeby książę na białym koniu odciął smokom głowy, żeby mnie uwolnić.",
      "ru": "На самом деле, я хотела быть принцессой и жить в башне, охраняемой семью драконами, и чтобы принц на белом коне отрубил драконам головы и освободил меня."
    }
  }
