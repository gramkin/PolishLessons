  "tatoeba": {
    "358926": {
      "pl": "Leżeli na sztucznej trawie.",
      "ru": null
    },
    "365493": {
      "pl": "Leżący na boku samochód blokował przejazd.",
      "ru": null
    },
    "450809": {
      "pl": "Musiał leżeć w łóżku.",
      "ru": null
    },
    "533671": {
      "pl": "Jezioro leżało tuż obok jego domu.",
      "ru": null
    },
    "585569": {
      "pl": "Gdy się obudziłem, znajdowałem się w pozycji leżącej na podłodze.",
      "ru": null
    },
    "590552": {
      "pl": "Leżała w łóżku na brzuchu.",
      "ru": null
    },
    "744077": {
      "pl": "Nie możesz leżeć w łóżku.",
      "ru": null
    },
    "749504": {
      "pl": "W południe oni leżeli w lesie, dla odpoczynku.",
      "ru": null
    },
    "757225": {
      "pl": "Znalazła ojca leżącego w kuchni.",
      "ru": null
    },
    "921707": {
      "pl": "Mary i ja wczoraj leżeliśmy w łóżku z chorobą.",
      "ru": null
    },
    "933063": {
      "pl": "Leżałem w łóżku z grypą.",
      "ru": null
    },
    "968989": {
      "pl": "Tom leżał na wznak.",
      "ru": null
    },
    "1133620": {
      "pl": "Czy dobrze leżą?",
      "ru": null
    },
    "1166352": {
      "pl": "Kiedy się obudzili, ujrzeli kamień leżący obok nich.",
      "ru": null
    },
    "1501496": {
      "pl": "Chciałbyś może jeszcze dostać klucz do mieszkania, w którym leżą pieniądze?",
      "ru": "Может быть, тебе дать ещё ключ от квартиры, где деньги лежат?"
    },
    "1925937": {
      "pl": "Klucz leży na stole.",
      "ru": "Ключ лежит на столе."
    },
    "3084392": {
      "pl": "Policja znalazła Toma leżącego na podłodze z dziurą po kuli na środku czoła.",
      "ru": null
    },
    "3616077": {
      "pl": "Leżał na plecach.",
      "ru": null
    },
    "3806040": {
      "pl": "Doskonale nauczył się języka angielskiego leżąc na sofie i pijąc piwo.",
      "ru": null
    },
    "5627142": {
      "pl": "Leż spokojnie.",
      "ru": null
    },
    "6155819": {
      "pl": "Na półkach leżały bele aksamitu.",
      "ru": "На полках лежали кипы бархата."
    },
    "6157533": {
      "pl": "Leżę na moim łóżku.",
      "ru": null
    },
    "6300556": {
      "pl": "Leżałam na plecach i patrzyłam na chmury.",
      "ru": "Я лежала на спине и смотрела на облака."
    },
    "7710794": {
      "pl": "Wszędzie na podłodze leżały płatki.",
      "ru": null
    },
    "7960576": {
      "pl": "Z jakiegoś powodu książka, której szukałam, leżała na półce z czasopismami.",
      "ru": "По какой-то причине книга, которую я искала, лежала на полке с журналами."
    },
    "8617235": {
      "pl": "Leż!",
      "ru": null
    },
    "8652404": {
      "pl": "Wystrzelił z pozycji leżącej.",
      "ru": null
    },
    "8658899": {
      "pl": "Na stole leżało dużo pieniędzy.",
      "ru": "На столе лежало много денег."
    },
    "8730429": {
      "pl": "Leżałem.",
      "ru": null
    },
    "8768452": {
      "pl": "Tom leży w łóżku.",
      "ru": "Том лежит в постели."
    },
    "12471289": {
      "pl": "Wracając do domu, natrafiłem na martwą kunę, leżącą na środku chodnika.",
      "ru": "По пути домой я наткнулся на мёртвую куницу, лежащую посреди тротуара."
    }
