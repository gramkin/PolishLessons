  "tatoeba": {
    "360518": {
      "pl": "Jest starszym z dwojga.",
      "ru": null
    },
    "524535": {
      "pl": "On ma dwie córki.",
      "ru": "У него две дочери."
    },
    "528482": {
      "pl": "Ogród jest wspólny dla dwu domów.",
      "ru": null
    },
    "528932": {
      "pl": "Mam dwie córki.",
      "ru": "У меня две дочери."
    },
    "531916": {
      "pl": "Masz dwa kwiaty.",
      "ru": "У тебя два цветка."
    },
    "588396": {
      "pl": "Kto napisał te dwa listy?",
