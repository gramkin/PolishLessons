  "tatoeba": {
    "352645": {
      "pl": "Pokrój łososia na małe kawałki.",
      "ru": "Разрежьте лосось на мелкие кусочки."
    },
    "365552": {
      "pl": "Ile kawałków mięsa chcesz?",
      "ru": null
    },
    "692605": {
      "pl": "Podzieliła ciasto na sześć kawałków i dała po jednym każdemu dziecku.",
      "ru": "Она разрезала торт на шесть кусков и дала каждому ребёнку по одному."
    },
    "716909": {
      "pl": "Przecięła sobie palec kawałkami szkła.",
      "ru": null
    },
    "733629": {
      "pl": "Chcę kawałek ciasta.",
      "ru": null
    },
    "739002": {
      "pl": "Rozwalili pudełko na kawałki.",
      "ru": null
    },
    "914937": {
      "pl": "Poczta jest kawałek stąd.",
      "ru": null
    },
    "952212": {
      "pl": "Pudełko owinięte jest dużym kawałkiem papieru.",
      "ru": null
    },
    "997664": {
      "pl": "Chcesz kawałek?",
      "ru": "Хочешь кусочек?"
    },
    "3038578": {
      "pl": "Ale, ja nie jem nawet małego kawałka mięsa.",
      "ru": null
    },
    "3711176": {
      "pl": "Tom nakarmił psa kawałkiem swojej kanapki.",
      "ru": null
    },
    "3936235": {
      "pl": "Chcę jedynie kubka kawy i kawałka tosta.",
      "ru": null
    },
    "8633071": {
      "pl": "Podarła list na kawałki.",
      "ru": null
    },
    "10235339": {
      "pl": "Podzieliła tort na pięć kawałków.",
      "ru": null
    },
    "10999656": {
      "pl": "I potem obudziłem się w rozkładanym fotelu z kawałkiem tortu urodzinoweko na piersi.",
      "ru": "И потом я проснулся в кресле с куском праздничного торта на груди."
    },
