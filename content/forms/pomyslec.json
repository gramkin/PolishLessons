  "tatoeba": {
    "529345": {
      "pl": "Ona pomyślała, że John ją kochał.",
      "ru": null
    },
    "1563956": {
      "pl": "Nie mów nic, zanim pomyślisz.",
      "ru": null
    },
    "2798572": {
      "pl": "\"Dziś jest dobry dzień na śmierć.\" - pomyślał ogórek-zabójca.",
      "ru": "\"Сегодня хороший день, чтобы умереть\", - подумал огурец-убийца."
    },
    "3107027": {
      "pl": "Pomyślcie o zaletach i wadach, zanim zdecydujecie!",
      "ru": null
    },
    "3433298": {
      "pl": "Nigdy o tym nie pomyślałem.",
      "ru": null
    },
    "3495452": {
      "pl": "Dlaczego wcześniej o tym nie pomyślałem?",
      "ru": "Почему я раньше об этом не подумал?"
    },
    "3631824": {
      "pl": "Czy pomyślałeś nad tym?",
      "ru": null
    },
    "3886434": {
      "pl": "Pomyśleliśmy, że mógłbyś chcieć iść z nami.",
      "ru": null
    },
    "4454597": {
      "pl": "Pomyślałaś kiedyś jak to jest - być mną?",
      "ru": null
    },
    "5379457": {
      "pl": "Co pomyślą sąsiedzi?",
      "ru": "Что подумают соседи?"
    },
    "6553781": {
      "pl": "Nie pomyślałbym o tym.",
      "ru": null
    },
    "7701472": {
      "pl": "Oczywiście, że o tym pomyślimy.",
      "ru": null
    },
    "9678466": {
      "pl": "O tym nie pomyślałam.",
      "ru": null
    },
    "9845786": {
      "pl": "Niech pomyślę.",
      "ru": null
    },
    "12450061": {
      "pl": "Pomyśl!",
      "ru": null
    },
    "12469864": {
      "pl": "Kto by pomyślał!",
      "ru": null
    },
    "12567466": {
      "pl": "Daj mi pomyśleć.",
      "ru": "Дай мне подумать."
    },
    "13560553": {
      "pl": "Aby język giętki powiedział wszystko, co pomyśli głowa.",
      "ru": null
    }
