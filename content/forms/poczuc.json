  "tatoeba": {
    "357230": {
      "pl": "Jeśli zażyjesz to lekarstwo, poczujesz się lepiej.",
      "ru": null
    },
    "359191": {
      "pl": "Zupełnie zatracił poczucie obowiązku.",
      "ru": null
    },
    "360127": {
      "pl": "Poczułem nagły ból głowy.",
      "ru": null
    },
    "364035": {
      "pl": "Masz poczucie humoru.",
      "ru": null
    },
    "366985": {
      "pl": "Poczuli głód.",
      "ru": null
    },
    "458059": {
      "pl": "Szkoda, że on nie ma poczucia humoru.",
      "ru": "Жаль, что у него нет чувства юмора."
    },
    "484588": {
      "pl": "Poczujesz się lepiej, jak weźmiesz te tabletki.",
      "ru": null
    },
    "524599": {
      "pl": "Poczuł się źle.",
      "ru": null
    },
    "760367": {
      "pl": "Poczuł zew przygody.",
      "ru": null
    },
    "898841": {
      "pl": "Poczuła to szóstym zmysłem.",
      "ru": null
    },
    "1351155": {
      "pl": "Poczuliśmy ulgę, gdy ujrzeliśmy światło w oddali.",
      "ru": null
    },
    "1357199": {
      "pl": "Czy uważasz to za nietakt i czy poczułbyś się urażony ?",
      "ru": null
    },
    "2625442": {
      "pl": "Brakuje mu poczucia moralności.",
      "ru": null
    },
    "3140005": {
      "pl": "Gdy greccy bogowie poczują chłód, przyodziewają liście figowe.",
      "ru": null
    },
    "3493486": {
      "pl": "Tom powiedział Mary, żeby została w domu, dopóki nie poczuje się lepiej.",
      "ru": null
    },
    "3897321": {
      "pl": "Poczułem okropny zapach.",
      "ru": null
    },
    "3933804": {
      "pl": "Tom ma nadzieję, że Mary wkrótce poczuje się lepiej.",
      "ru": null
    },
    "3954977": {
      "pl": "Rozumiem, jak się poczułeś.",
      "ru": null
    },
    "4953208": {
      "pl": "To sprawiło, że poczułam się lepiej.",
      "ru": null
    },
    "5220073": {
      "pl": "Wystarczy, ze spojrzę na cytrynę by poczuć jej kwaśny smak w ustach.",
      "ru": null
    },
    "5627152": {
      "pl": "Poczuj to.",
      "ru": null
    },
    "5650317": {
      "pl": "Poczuli.",
      "ru": null
    },
    "6154834": {
      "pl": "Ona poczuła głęboki smutek.",
      "ru": null
    },
    "7868693": {
      "pl": "Poczułam się bardzo urażona twoimi komentarzami.",
      "ru": null
    },
    "7969945": {
      "pl": "Poczułem pragnienie.",
      "ru": null
    },
    "8881785": {
      "pl": "Ludzie szanują ludzi z wysokim poczuciem wartości.",
      "ru": null
    },
    "12333867": {
      "pl": "Poczuł ulgę, gdy jego matka zmarła.",
      "ru": "Он испытал облегчение, когда умерла его мать."
    },
    "12454775": {
      "pl": "Poczuła się uwięziona.",
      "ru": null
    },
    "13225485": {
      "pl": "Bycie Niemcem niekoniecznie oznacza brak poczucia humoru.",
