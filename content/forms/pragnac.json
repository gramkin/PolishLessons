    },
    "3498219": {
      "pl": "Pragnę zobaczyć Rzym.",
      "ru": null
    },
    "3657592": {
      "pl": "Są na świecie takie rzeczy, które nie spełnią, nie ważne jak mocno by się ich pragnęło.",
      "ru": null
    },
    "4441324": {
      "pl": "Dam ci wszystko czego pragniesz.",
      "ru": null
    },
    "4620748": {
      "pl": "Pragniemy pokoju na świecie.",
      "ru": null
    },
    "6154983": {
      "pl": "Cały świat pragnie pokoju.",
