      "pl": "Dobre wiadomości podniosły go na duchu.",
      "ru": null
    },
    "983385": {
      "pl": "Duch nagle zniknął.",
      "ru": null
    },
    "2233999": {
      "pl": "Nie opowiadaj dziecku bajek o duchach, on bez tego jest bardzo strachliwy.",
      "ru": null
    },
    "2346300": {
      "pl": "Nie jestem duchem, przekonaj się!",
      "ru": null
    },
    "2700077": {
      "pl": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.",
      "ru": null
    },
    "2972497": {
      "pl": "Czy jesteś duchem?",
      "ru": null
    },
    "3230854": {
      "pl": "Wyglądała, jakby zobaczyła ducha.",
      "ru": null
    },
    "3604786": {
      "pl": "Jesteś blady jak duch.",
      "ru": "Ты бледный как привидение."
    },
    "3752565": {
      "pl": "Ona próbuje udowodnić istnienie duchów.",
      "ru": null
    },
    "4116507": {
      "pl": "Nie boję się duchów.",
      "ru": null
    },
    "4926397": {
      "pl": "W Imię Ojca i Syna, i Ducha Świętego.",
      "ru": "Во имя Отца и Сына и Святого Духа."
    },
