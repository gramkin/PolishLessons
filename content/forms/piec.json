  "tatoeba": {
    "591531": {
      "pl": "Dam ci pięć dolarów.",
      "ru": "Я дам тебе пять долларов."
    },
    "723793": {
      "pl": "On ma przynajmniej pięcioro dzieci.",
      "ru": null
    },
    "948005": {
      "pl": "Ten tłumacz włada pięcioma językami.",
      "ru": "Этот переводчик владеет пятью языками."
    },
    "999422": {
      "pl": "Wychowała pięcioro dzieci.",
      "ru": "Она вырастила пятерых детей."
    },
    "3286167": {
      "pl": "Ta opera składa się z pięciu aktów.",
      "ru": "Эта опера состоит из пяти актов."
    },
    "3697780": {
      "pl": "On potrafi mówić w pięciu językach.",
      "ru": "Он может говорить на пяти языках."
    },
    "5974884": {
      "pl": "Kobieta ma pięcioro dzieci.",
      "ru": "У женщины пятеро детей."
    },
    "6769196": {
      "pl": "Tom potrafi żonglować pięcioma piłeczkami.",
      "ru": null
    },
    "11268995": {
      "pl": "To zajmie pięć sekund.",
      "ru": "Это займёт пять секунд."
