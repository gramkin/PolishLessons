  "tatoeba": {
    "363024": {
      "pl": "Dach został uszkodzony podczas burzy.",
      "ru": "Крыша была повреждена штормом."
    },
    "415387": {
      "pl": "Widziałem dom z czerwonym dachem.",
      "ru": null
    },
    "660346": {
      "pl": "Widzę ptaka na dachu.",
      "ru": "Я вижу на крыше птицу."
    },
    "1579299": {
      "pl": "Który dach jest zielony?",
      "ru": "Какая крыша зеленая?"
    },
    "2677073": {
      "pl": "On nie miał dachu nad głową.",
      "ru": "У него не было крыши над головой."
    },
    "2982002": {
      "pl": "Byliśmy zbyt różni i pod jednym dachem prowadziliśmy odrębne życie.",
      "ru": null
