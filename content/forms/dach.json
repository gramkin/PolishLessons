    "3049776": {
      "pl": "Ten dom z zielonym dachem jest mój.",
      "ru": null
    },
    "3481872": {
      "pl": "W tej starej wsi gniazdują bociany na dachach.",
      "ru": null
    },
    "4716919": {
      "pl": "Dach przecieka.",
      "ru": "Крыша протекает."
