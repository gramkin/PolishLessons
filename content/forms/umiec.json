  "tatoeba": {
    "352875": {
      "pl": "Kiedy była mała, umiała ładnie śpiewać.",
      "ru": null
    },
    "353868": {
      "pl": "Psy umieją pływać.",
      "ru": null
    },
    "354116": {
      "pl": "Umiał przekonać do swoich pomysłów.",
      "ru": null
    },
    "355897": {
      "pl": "Umiesz grać w szachy?",
      "ru": "Ты умеешь играть в шахматы?"
    },
    "357825": {
      "pl": "On nie umie pływać.",
      "ru": "Он не умеет плавать."
    },
    "358787": {
      "pl": "On umie pływać.",
      "ru": "Он умеет плавать."
    },
    "363685": {
      "pl": "Umiała czytać, kiedy miała cztery lata.",
      "ru": null
    },
    "364873": {
      "pl": "Umiem prowadzić, a Tom nie.",
      "ru": "Я умею водить, а Том нет."
    },
    "412923": {
      "pl": "Chciałbym umieć mówić po angielsku.",
      "ru": null
    },
    "516486": {
      "pl": "Nikt nie umiał dać poprawnej odpowiedzi.",
      "ru": null
    },
    "568461": {
      "pl": "Strusie nie umieją latać.",
      "ru": null
    },
    "599889": {
      "pl": "Chciałbym umieć pływać.",
      "ru": null
    },
    "704038": {
      "pl": "Różnimy się od zwierząt tym, że umiemy mówić.",
      "ru": null
    },
    "732988": {
      "pl": "Czy oni będą umieli przeczytać te słowa?",
      "ru": null
    },
    "744239": {
      "pl": "Biegłem najszybciej jak umiałem.",
      "ru": null
    },
    "751598": {
      "pl": "Każdy powinien umieć pływać.",
      "ru": null
    },
    "760451": {
      "pl": "Musimy wykonać tę pracę najlepiej jak umiemy.",
      "ru": null
    },
    "831700": {
      "pl": "Umiałem odpowiedzieć na jego pytanie.",
      "ru": null
    },
    "924491": {
      "pl": "Nie byłbym w stanie atakować chrześcijaństwa, tak jak nie umiałbym krytykować wilkołaków.",
      "ru": null
    },
    "951354": {
      "pl": "Jeśli umiecie przeczytać to zdanie, znaczy, że umiecie czytać.",
      "ru": null
    },
    "956981": {
      "pl": "Nie umiem latać.",
      "ru": "Я не умею летать."
    },
    "1294633": {
      "pl": "Nie umiałem sobie z nim poradzić.",
      "ru": null
    },
    "2183377": {
      "pl": "Ten ptak umie latać.",
      "ru": "Эта птица умеет летать."
    },
    "2264538": {
      "pl": "Króliki umieją pływać?",
      "ru": "Кролики умеют плавать?"
    },
    "2406023": {
      "pl": "Umiesz gwizdać?",
      "ru": "Ты умеешь свистеть?"
    },
    "2495934": {
      "pl": "Umiem czytać w myślach.",
      "ru": "Я могу читать мысли."
    },
    "3746167": {
      "pl": "Tom powinien umieć to zrobić.",
      "ru": null
    },
    "3786705": {
      "pl": "Dlaczego nie umiemy żyć razem w pokoju?",
      "ru": null
    },
    "4468694": {
      "pl": "Przetłumaczyłam wiersz tak dobrze, jak tylko umiałam.",
      "ru": null
    },
    "5201386": {
      "pl": "Oni wiedzieli, że on to zrobił, ale nie umieli tego udowodnić.",
      "ru": null
    },
    "5336646": {
      "pl": "Umiesz pisać?",
      "ru": "Ты умеешь писать?"
    },
    "5960539": {
      "pl": "Dwaj bracia nie umieli się ze sobą dogadać.",
      "ru": null
    },
    "8734648": {
      "pl": "Nie umiała pływać.",
      "ru": null
    },
    "8763053": {
      "pl": "Tom nie umiał pływać.",
      "ru": null
    },
    "10590294": {
      "pl": "Umiecie pływać, prawda?",
      "ru": null
    },
    "11006410": {
      "pl": "Dlaczego u licha myślałaś, że Tom umiałby prowadzić?",
      "ru": null
    },
    "12360013": {
      "pl": "Tom umiałby to zrobić.",
      "ru": null
    },
    "13830839": {
      "pl": "Nie umiem kłamać.",
      "ru": "Я не умею врать."
    }
