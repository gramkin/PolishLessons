  "tatoeba": {
    "366643": {
      "pl": "Widziałem, jak wchodzi na górę.",
      "ru": null
    },
    "516521": {
      "pl": "Przez wchodzenie i schodzenie ze wzgórza zabrakło mi tchu.",
      "ru": null
    },
    "712355": {
      "pl": "Porzućcie nadzieję, którzy tu wchodzicie.",
      "ru": null
    },
    "756899": {
      "pl": "Uśmiechnęła się do mnie, wchodząc do pokoju.",
      "ru": null
    },
    "768841": {
      "pl": "Wchodzę w to.",
      "ru": null
    },
    "826674": {
      "pl": "Widziałem jak wchodził do pokoju.",
      "ru": null
    },
    "965044": {
      "pl": "Nie usłyszałem, jak wchodzisz.",
      "ru": null
    },
    "989456": {
      "pl": "Wchodząc na tę górę, stanie pan twarzą w twarz z niebezpieczeństwem.",
      "ru": null
    },
    "1185495": {
      "pl": "Nie wchodź do mojego pokoju bez pukania.",
      "ru": "Не входи в мою комнату без стука."
    },
    "1350341": {
      "pl": "Wchodzenie surowo wzbronione.",
      "ru": "Вход строго запрещен."
    },
    "1780462": {
      "pl": "Wchodzę do domu.",
      "ru": null
    },
    "2987385": {
      "pl": "Anglik, Belg i Holender wchodzą do pubu i siadają przy barze. Barman pyta, \"Chwila, to jakiś żart czy co?\"",
      "ru": "Англичанин, бельгиец и голландец заходят в паб и садятся за стойку. Бармен: \"Не понял, это что, анекдот?\""
    },
    "3034130": {
      "pl": "Spotkałam go na schodach, jak wchodziłam na górę.",
      "ru": null
    },
    "3407278": {
      "pl": "Wchodzę pierwszy.",
      "ru": null
    },
    "3656613": {
      "pl": "Liczne czynniki wchodzą w grę.",
      "ru": null
    },
    "3660736": {
      "pl": "Widziano go wchodzącego do pokoju.",
      "ru": "Его видели входящим в комнату."
    },
    "4921556": {
      "pl": "Nie wchodzić.",
      "ru": "Не входить."
    },
    "5240096": {
      "pl": "Tom wchodzi po schodach.",
      "ru": null
    },
    "5894857": {
      "pl": "Nowe podatki wchodzą w życie w przyszłym roku.",
      "ru": null
    },
    "6553774": {
      "pl": "Nie wchodziłabym tam.",
      "ru": null
    },
    "6729731": {
      "pl": "Wchodzisz?",
      "ru": null
    },
    "7949759": {
      "pl": "Nie wchodziłem w szczegóły.",
      "ru": null
    },
    "7949771": {
      "pl": "Nie wchodźmy w szczegóły.",
      "ru": null
    },
    "8607321": {
      "pl": "Wchodź!",
      "ru": null
    },
    "8617146": {
      "pl": "Proszę wchodzić.",
      "ru": null
    },
    "8721125": {
      "pl": "Wchodzisz czy nie?",
      "ru": null
    },
    "8801296": {
      "pl": "Wchodzimy.",
      "ru": null
    },
    "11215657": {
      "pl": "Wspieraj swoich klientów podczas wchodzenia i wychodzenia z kąpieli.",
      "ru": null
    },
    "11264398": {
      "pl": "Nie wchodzicie?",
      "ru": null
    },
    "11305458": {
      "pl": "Prawo wchodzi w życie.",
      "ru": null
    },
    "12053365": {
      "pl": "Czy wchodzenie po schodach jest trudne?",
      "ru": null
    },
    "12062150": {
      "pl": "Wchodzimy tu.",
      "ru": null
    },
    "12564146": {
      "pl": "Ile republik wchodziło w skład Związku Radzieckiego?",
      "ru": "Сколько республик входило в состав Советского Союза?"
    },
    "13045919": {
      "pl": "Wchodź, ale pamiętaj - o szóstej muszę lecieć.",
