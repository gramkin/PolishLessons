    "10768446": {
      "pl": "Skąd twoja inspiracja?",
      "ru": "Чем ты вдохновлялся?"
    },
    "11240423": {
      "pl": "Mam dość twej błazenady.",
      "ru": null
    },
    "12334298": {
      "pl": "Nikt nie pyta o twoją opinię.",
      "ru": "Твоего мнения никто не спрашивает."
