    },
    "629845": {
      "pl": "Poznałem kiedyś twego ojca.",
      "ru": null
    },
    "706869": {
      "pl": "Mam nadzieję, że twe życzenie się spełni.",
      "ru": null
    },
    "734269": {
      "pl": "Wkrótce pożałujesz twych nieprzemyślanych działań.",
      "ru": null
    },
    "739021": {
      "pl": "Dziwię się twemu nieodpowiedzialnemu zachowaniu.",
      "ru": null
    },
    "817821": {
      "pl": "To nie twoja sprawa.",
      "ru": "Это не твоё дело."
    },
    "1353358": {
      "pl": "Jedzenie ryb jest dobre dla twego zdrowia.",
      "ru": "Употребление рыбы полезно для здоровья."
    },
    "1353391": {
      "pl": "Doceniam twą troskę.",
      "ru": null
    },
    "1769547": {
      "pl": "Jestem twoim ojcem.",
      "ru": "Я твой отец."
    },
    "2218876": {
      "pl": "Nie zapominaj, że palenie szkodzi twojemu zdrowiu.",
      "ru": "Не забывайте, что курение опасно для вашего здоровья."
    },
    "2284805": {
      "pl": "Zmęczyłem się już twoimi kłamstwami!",
      "ru": null
    },
    "2495814": {
      "pl": "Polubiłem twoich przyjaciół.",
      "ru": "Мне понравились твои друзья."
    },
    "2630869": {
      "pl": "Widzę to w twoich oczach.",
      "ru": "Я вижу это в твоих глазах."
    },
    "3032015": {
      "pl": "Gdzie są twoi rodzice?",
      "ru": "Где твои родители?"
    },
    "3410647": {
      "pl": "Jestem twoim słońcem.",
      "ru": "Я твоё солнце."
    },
    "3416035": {
      "pl": "Przesadnie palenie zaszkodzi twojemu zdrowiu.",
      "ru": null
    },
    "3477038": {
      "pl": "Szczęście puka do twych drzwi.",
      "ru": null
    },
    "3525144": {
      "pl": "Nie jestem twoim synem.",
      "ru": "Я не твой сын."
    },
    "3605034": {
      "pl": "Jak miło z twojej strony!",
      "ru": "Как мило с твоей стороны!"
    },
    "3657569": {
      "pl": "Liczymy na twoją pomoc.",
      "ru": "Мы рассчитываем на твою помощь."
    },
    "3951182": {
      "pl": "To był twój błąd.",
      "ru": "Это была твоя ошибка."
    },
    "4719319": {
      "pl": "O to i twoje klucze.",
      "ru": "Вот твои ключи."
    },
    "4785636": {
      "pl": "Nie robię nic za twoimi plecami.",
      "ru": null
    },
    "5528890": {
      "pl": "Mam twoje bilety.",
      "ru": "Твои билеты у меня."
    },
    "6328165": {
      "pl": "Znam twój sekret.",
      "ru": "Я знаю твой секрет."
    },
    "6484990": {
      "pl": "Ładnie wygląda z twoimi spodniami.",
      "ru": null
    },
    "6765696": {
      "pl": "Kim są twoi sąsiedzi?",
      "ru": null
    },
    "6934110": {
      "pl": "Tom znalazł twoje klucze.",
      "ru": "Том нашёл твои ключи."
    },
    "10747448": {
