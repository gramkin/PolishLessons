      "pl": "Jeśli stracę twą miłość, stracę wszystko.",
      "ru": null
    },
    "362927": {
      "pl": "Liczymy tylko na twoją pomoc.",
      "ru": "Мы рассчитываем только на твою помощь."
    },
    "365461": {
      "pl": "To zagraża twojemu zdrowiu.",
      "ru": null
    },
    "383638": {
      "pl": "Nie pamiętam twojego imienia.",
      "ru": "Не помню твоего имени."
