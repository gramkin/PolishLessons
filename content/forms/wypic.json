    },
    "2246728": {
      "pl": "Popełnił błąd i wypił truciznę.",
      "ru": "Он совершил ошибку и выпил яд."
    },
    "2736441": {
      "pl": "Wypiłeś ten sok pomarańczowy?",
      "ru": null
    },
    "2784680": {
      "pl": "Wypiłam dzisiaj zbyt dużo kawy.",
      "ru": null
    },
    "3296986": {
      "pl": "Wypił piwo.",
      "ru": null
    },
    "3363147": {
      "pl": "Wypijmy kawę w czasie przerwy.",
