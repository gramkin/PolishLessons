    },
    "1165929": {
      "pl": "Wypiłam dwie filiżanki kawy.",
      "ru": null
    },
    "1274210": {
      "pl": "Pana ból ustanie, jeśli wypije Pan to lekarstwo.",
      "ru": null
    },
    "1474276": {
      "pl": "Nie miałbym nic przeciwko wypiciu drinka.",
      "ru": null
    },
    "1920886": {
      "pl": "Wypiliśmy sporo.",
      "ru": null
    },
    "2238618": {
      "pl": "Trochę wypiliśmy i zaczęliśmy ble, ble, ble.",
