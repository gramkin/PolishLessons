    },
    "777719": {
      "pl": "Chcę wypić kawę.",
      "ru": null
    },
    "852287": {
      "pl": "Jak wypijesz herbatę, ćwicz dalej.",
      "ru": null
    },
    "931556": {
      "pl": "Można pić za dużo, ale nigdy nie wypije się dość.",
      "ru": null
    },
    "960922": {
      "pl": "Więcej piwa nie wypiję.",
      "ru": null
    },
    "980603": {
      "pl": "Dziś rano wypiłem szklankę mleka.",
