  "tatoeba": {
    "368993": {
      "pl": "Na koniec obiadu wypiła kawę.",
      "ru": null
    },
    "403220": {
      "pl": "Wypiłem kawę w kawiarni.",
      "ru": null
    },
    "416269": {
      "pl": "Wypił całą butelkę mleka.",
      "ru": "Он выпил целую бутылку молока."
    },
    "484589": {
      "pl": "Poczujesz się lepiej, jeśli wypijesz ten lek.",
      "ru": null
    },
    "511584": {
      "pl": "Wypijmy za zdrowie i szczęście!",
      "ru": null
    },
    "525780": {
      "pl": "Chodź, wypijmy na mój koszt.",
      "ru": null
    },
