  "tatoeba": {
    "351536": {
      "pl": "Z wiekiem zacząłem inaczej patrzeć na różne sprawy.",
      "ru": "Я стал старше, поэтому я стал смотреть на вещи по-другому."
    },
    "525166": {
      "pl": "Wyszła za mąż w wieku siedemnastu lat.",
      "ru": "Она вышла замуж в семнадцать лет."
    },
    "575768": {
      "pl": "Jaki jest jego wiek?",
      "ru": null
    },
    "792368": {
      "pl": "Mądrzejemy z wiekiem.",
      "ru": null
    },
    "984506": {
      "pl": "Wieki cię nie widziałem.",
      "ru": null
    },
    "1350207": {
      "pl": "Wszystko zaczęło się w początkach XII wieku.",
      "ru": "Всё началось в начале XII века."
    },
    "1575681": {
      "pl": "Czuję mój wiek.",
      "ru": null
    },
    "2484460": {
      "pl": "Wiek uczestników bez ograniczeń.",
      "ru": "Возраст участников без ограничений."
    },
    "3154584": {
      "pl": "Przed piętnastym wiekiem wierzono, iż Ziemia jest centrum wszechświata.",
      "ru": "До пятнадцатого века считалось, что Земля - центр Вселенной."
    },
    "3237715": {
      "pl": "Minęły wieki, odkąd ostatni raz się widzieliśmy.",
      "ru": null
    },
    "3516174": {
      "pl": "W twoim wieku byłem już żonaty.",
      "ru": "В твоём возрасте я уже был женат."
    },
    "6320731": {
      "pl": "Wieki się nie widzieliśmy.",
      "ru": null
    },
    "6995442": {
      "pl": "Obaj są w tym samym wieku.",
      "ru": "Они оба одного возраста."
    },
    "7184949": {
      "pl": "Od wieków go nie widziałem.",
      "ru": null
    },
    "12159503": {
      "pl": "\"Niech będzie pochwalony Jezus Chrystus!\" \"Na wieki wieków!\"",
      "ru": null
