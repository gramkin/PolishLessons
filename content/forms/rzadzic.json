  "tatoeba": {
    "440272": {
      "pl": "Ty tu rządzisz.",
      "ru": null
    },
    "532754": {
      "pl": "Pieniądz rządzi światem.",
      "ru": null
    },
    "544517": {
      "pl": "Jeden, by wszystkimi rządzić.",
      "ru": null
    },
    "551572": {
      "pl": "Birma rządzona jest przez wojskową juntę.",
      "ru": null
    },
    "725589": {
      "pl": "W Wielkiej Brytanii król panuje, ale nie rządzi.",
      "ru": "В Великобритании король царствует, но не управляет."
    },
    "742558": {
      "pl": "Republika to kraj rządzony nie przez króla czy królową, ale przez prezydenta.",
      "ru": "Республика — это страна, управляемая не королём или королевой, а президентом."
    },
    "754207": {
      "pl": "Partia rządząca jest skorumpowana, ale opozycja jest niewiele lepsza.",
      "ru": null
    },
    "872308": {
      "pl": "Jaki rząd jest najlepszy? Ten, który uczy nas rządzić samym sobą.",
      "ru": null
    },
    "982935": {
      "pl": "Tym krajem rządziła francuska arystokracja.",
      "ru": null
    },
    "998639": {
      "pl": "W nadchodzących wyborach wygra chyba partia rządząca.",
      "ru": null
    },
    "2288311": {
      "pl": "Życiem miasta rządziła kopalnia.",
      "ru": null
    },
    "2679394": {
      "pl": "Dziel i rządź.",
      "ru": null
    },
    "3109627": {
      "pl": "Król rządził swoim ludem przez czterdzieści lat.",
      "ru": null
    },
    "3127240": {
      "pl": "Kto tutaj rządzi?",
      "ru": null
    },
    "3428167": {
      "pl": "Indie były rządzone przez Wielką Brytanię przez wiele lat.",
      "ru": null
    },
    "5488163": {
      "pl": "\"Pieniądze muszą służyć, nie rządzić.\"",
      "ru": null
    },
    "8195766": {
      "pl": "Hiszpania rządziła Kubą w tamtym czasie.",
      "ru": null
    },
    "9952244": {
      "pl": "Koty rządzą światem.",
      "ru": "Коты правят миром."
    },
    "10593966": {
      "pl": "Pieniądze rządzą światem.",
      "ru": null
    },
    "10631711": {
      "pl": "Król rządził swoim królestwem sprawiedliwie.",
      "ru": "Король правил своим королевством справедливо."
    },
    "11264377": {
      "pl": "Partia rządząca nie ma właściwie żadnego programu.",
      "ru": null
    },
    "12728326": {
      "pl": "Nie chcę żyć w świecie rządzonym przez bogaczy.",
      "ru": null
    },
    "13429712": {
      "pl": "Kiedyś Napoleon Bonaparte rządził całą Francją.",
      "ru": null
    },
    "13662134": {
      "pl": "Dziel i rządź!",
