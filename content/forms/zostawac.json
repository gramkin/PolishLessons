    },
    "981792": {
      "pl": "Idziesz czy zostajesz?",
      "ru": "Ты идёшь или остаёшься?"
    },
    "3660842": {
      "pl": "On zostaje na długo za każdym razem, kiedy przyjeżdża.",
      "ru": "Он остается надолго всякий раз, как приедет."
    },
    "3828585": {
      "pl": "Nie mam zamiaru zostawać tu w Bostonie.",
      "ru": null
    },
    "3886415": {
      "pl": "Przez trzy lata zostawałem pracownikiem roku.",
      "ru": null
    },
    "3897612": {
      "pl": "Po prostu nie lubię zostawać z tyłu.",
      "ru": null
    },
    "4516045": {
      "pl": "Ona odwiedza go częściej, ale nigdy długo nie zostawała.",
      "ru": null
    },
    "4746932": {
      "pl": "Nie zostawaj w tyle!",
      "ru": null
    },
    "4953547": {
      "pl": "Zimą zostajemy chętnie w domu.",
      "ru": null
    },
    "5326063": {
      "pl": "Zostaję w domu.",
      "ru": null
    },
    "8725854": {
      "pl": "Zostajesz tam.",
      "ru": null
    },
    "8746803": {
      "pl": "Zostajemy.",
      "ru": null
    },
    "10756408": {
      "pl": "W dzisiejszych czasach wszyscy nosimy maski, a Ci którzy odważą się je zdjąć zostają odtrąceni.",
      "ru": null
    },
    "12905149": {
      "pl": "Oni zostają, ja idę.",
