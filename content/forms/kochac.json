  "tatoeba": {
    "348633": {
      "pl": "On ją kocha.",
      "ru": "Он ее любит."
    },
    "348818": {
      "pl": "Kocham cię.",
      "ru": "Я люблю тебя!"
    },
    "521308": {
      "pl": "Ludzie kochani przez wielu umierają młodo.",
      "ru": null
    },
    "525219": {
      "pl": "Kochać i być kochanym to największe szczęście.",
      "ru": null
    },
    "526560": {
      "pl": "Lepiej być znienawidzonym za to kim się jest niż być kochanym za to kim się nie jest.",
      "ru": null
    },
    "567472": {
      "pl": "Ann kocha czekoladę.",
      "ru": "Энн любит шоколад."
    },
    "629819": {
      "pl": "Aż tak się kochacie?",
      "ru": null
    },
    "718983": {
      "pl": "My kochamy piękno.",
      "ru": "Мы любим прекрасное."
    },
    "765736": {
      "pl": "Miło jest widzieć kochających się starszych państwa.",
      "ru": null
    },
    "788057": {
      "pl": "Kochałaś kiedyś kogoś?",
      "ru": null
    },
    "822126": {
      "pl": "Kochali się zeszłej nocy.",
      "ru": null
    },
    "964953": {
      "pl": "Umiem kochać.",
      "ru": null
    },
    "1111152": {
      "pl": "Zawsze będę cię kochać.",
      "ru": "Я всегда буду любить тебя."
    },
    "1115020": {
      "pl": "Kochasz mnie?",
      "ru": "Ты меня любишь?"
    },
    "1409819": {
      "pl": "Kocham naturę.",
      "ru": "Я люблю природу."
    },
    "1660277": {
      "pl": "Bądź kochany.",
      "ru": null
    },
    "2391318": {
      "pl": "Byłem kochany.",
      "ru": null
    },
    "2403106": {
      "pl": "Rodzina Toma kochała Mary.",
      "ru": "Семья Тома любила Мэри."
    },
    "2671592": {
      "pl": "Kochasz ją?",
      "ru": "Ты её любишь?"
    },
    "3017948": {
      "pl": "Zawsze będzie ją kochał.",
      "ru": "Он всегда будет любить её."
    },
    "3420945": {
      "pl": "Kochaj ją.",
      "ru": "Люби её."
    },
    "3656747": {
      "pl": "Chcę żyć w świecie, gdzie ludzie kochają się nawzajem.",
      "ru": "Я хочу жить в мире, где люди любят друг друга."
    },
    "3749972": {
      "pl": "Wszyscy kochaliśmy Toma.",
      "ru": null
    },
    "4716959": {
      "pl": "Tom jest jedynym mężczyzną, którego Mary kiedykolwiek kochała.",
      "ru": "Том — единственный мужчина, которого Мэри когда-либо любила."
    },
    "5190343": {
      "pl": "Kochałam chodzić na plażę.",
      "ru": "Я любила ходить на пляж."
    },
    "6207822": {
      "pl": "Jesteś stworzona, by być kochaną i podziwianą.",
      "ru": null
    },
    "8459642": {
      "pl": "Kochałeś mnie?",
      "ru": null
    },
    "8750012": {
      "pl": "Miłość przychodzi od miłości, gdy chcę by mnie kochano powinienem pokochać pierwszy.",
      "ru": null
    },
    "8764858": {
      "pl": "Kochałaś Toma?",
      "ru": null
    },
    "9367536": {
      "pl": "Byłam kochana.",
      "ru": null
    },
    "9686303": {
      "pl": "Kiedyś to kochałeś.",
      "ru": null
    },
    "9803463": {
      "pl": "Kochałem ją.",
      "ru": null
    },
    "10202319": {
      "pl": "Ja ich kochałam.",
      "ru": "Я их любила."
    },
    "10202320": {
      "pl": "Ja ich kochałem.",
      "ru": "Я их любил."
    },
    "10566161": {
      "pl": "Kochamy to.",
      "ru": null
    },
    "10963563": {
      "pl": "Kochajcie siebie wzajemnie, jak ja was umiłowałem.",
      "ru": null
    },
    "11855271": {
      "pl": "Kiedyś kochaliśmy się, aż się zmęczyliśmy.",
      "ru": null
    },
    "12061938": {
      "pl": "Udowodnijcie, że mnie kochacie.",
      "ru": null
    },
    "12202534": {
      "pl": "Bądź kochana.",
      "ru": null
    },
    "12232778": {
      "pl": "Kochaj mnie czule.",
      "ru": null
    },
    "12359722": {
      "pl": "Cześć, kochanie.",
      "ru": null
    },
    "12453922": {
      "pl": "Jej rodzice mnie kochali.",
      "ru": null
    },
    "12470547": {
      "pl": "Ludzie, którzy cię kochają, zaakceptują cię taką, jaka jesteś.",
      "ru": "Люди, которые тебя любят, примут тебя такой, какая ты есть."
    },
    "13487476": {
      "pl": "Kochaj swoich rodziców, swoją siostrę, swoją rodzinę, a nauczysz się, że kochanie bliźniego i siebie samego jest w rzeczywistości kochaniem Boga i Natury.",
      "ru": null
    },
    "13627125": {
      "pl": "Kochanie człowieka oznacza bycie gotowym żeby się z nim zestarzeć.",
      "ru": "Любить человека означает быть готовым с ним состариться."
    },
    "13786620": {
      "pl": "On naprawdę mnie kochał.",
      "ru": "Он по-настоящему меня любил."
    },
    "13789211": {
      "pl": "Dziękuję za pomoc, jesteś naprawdę kochaną osobą.",
