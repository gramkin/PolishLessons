    "355480": {
      "pl": "Przypływy i odpływy zależą od ruchu Księżyca.",
      "ru": null
    },
    "364814": {
      "pl": "To zależy od kontekstu.",
      "ru": "Это зависит от контекста."
    },
    "368083": {
      "pl": "Nie powinieneś zależeć od innych.",
      "ru": null
    },
    "368092": {
      "pl": "Za bardzo zależysz od innych.",
      "ru": null
    },
    "636091": {
      "pl": "Twoja pensja będzie zależała od ilości wykonanej pracy.",
      "ru": null
    },
    "713507": {
      "pl": "Zastanówmy się na spokojnie, w jakim stopniu zależymy od energii jądrowej.",
      "ru": null
    },
    "972868": {
      "pl": "Zastanawiam się, czy kiedykolwiek ci na mnie zależało.",
      "ru": null
    },
    "1160634": {
      "pl": "Wartość monet zależała od wagi użytego metalu.",
      "ru": null
    },
    "6156050": {
      "pl": "Głębokość przyjaźni nie zależy od długości znajomości.",
      "ru": "Глубина дружбы не зависит от продолжительности знакомства."
    },
    "6368386": {
      "pl": "Samiemu na niczym nie zależało.",
      "ru": null
    },
    "8666086": {
      "pl": "Od tego zależy moja przyszłość.",
      "ru": "От этого зависит моё будущее."
    },
    "10817622": {
      "pl": "To całkowicie będzie zależało od niego.",
      "ru": "Это будет целиком зависеть от него."
    }
  }
