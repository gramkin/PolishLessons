    },
    "3571686": {
      "pl": "Giordano Bruno został spalony żywcem w 1600 roku.",
      "ru": null
    },
    "5227474": {
      "pl": "Musimy spalić wszystkie te listy.",
      "ru": null
    },
    "5651897": {
      "pl": "Spalili.",
      "ru": null
    },
    "6156481": {
      "pl": "Dom się spalił doszczętnie.",
      "ru": null
    },
    "6672550": {
      "pl": "Oba budynki się spaliły.",
      "ru": null
    },
    "7180694": {
      "pl": "Uważnie przeczytał list, po czym go spalił.",
      "ru": "Он внимательно прочёл письмо, после чего сжёг его."
    },
    "7180695": {
      "pl": "A potem spalił wszystko.",
      "ru": "А потом он всё сжёг."
    },
    "8652369": {
      "pl": "Spaliłem to.",
      "ru": null
    },
    "8755758": {
      "pl": "Spaliło się.",
      "ru": null
    },
    "10477290": {
      "pl": "Chwyć mięso, zanim się spali!",
      "ru": null
    },
    "10572698": {
      "pl": "Spal to!",
      "ru": null
    },
    "10667443": {
      "pl": "Hunowie splądrowali wioskę i doszczętnie ją spalili.",
      "ru": null
    },
    "11012190": {
      "pl": "Spaliła moje zdjęcie.",
      "ru": null
    },
    "11319290": {
      "pl": "Twarz Toma jest spalona.",
      "ru": null
    },
    "11319292": {
      "pl": "Twarz Tomka jest spalona.",
      "ru": null
    },
    "12569952": {
      "pl": "Zanim przyjechała straż pożarna, cały budynek był już spalony.",
      "ru": null
    },
    "12710029": {
      "pl": "Spaliłem wszystkie swoje stare książki.",
      "ru": "Я сжёг все свои старые книги."
    },
    "12904763": {
      "pl": "Jeśli spalisz swój dom, musisz spać na zewnątrz.",
