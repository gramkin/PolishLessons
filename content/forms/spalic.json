    },
    "722234": {
      "pl": "Szpieg spalił dokumenty.",
      "ru": null
    },
    "722290": {
      "pl": "Grunt był suchy i twardy, spalony słońcem.",
      "ru": null
    },
    "1333614": {
      "pl": "Ponieważ już nigdy nie chcę oglądać tego faceta na oczy, podarłam jego zdjęcia na drobne kawałki i spaliłam.",
      "ru": null
    },
    "2247295": {
      "pl": "Spal te śmieci.",
