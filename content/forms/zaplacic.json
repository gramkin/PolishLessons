    "355810": {
      "pl": "Zapłacono mu 1000 dolarów.",
      "ru": null
    },
    "356991": {
      "pl": "Za zakupy zapłaciłem gotówką.",
      "ru": "Я заплатил за покупку наличными."
    },
    "366795": {
      "pl": "Zapłaciłem mu w zeszłym tygodniu.",
      "ru": "Я ему заплатил на прошлой неделе."
    },
    "456987": {
      "pl": "Nie, chcę zapłacić gotówką.",
      "ru": "Нет. Я хочу заплатить наличными."
    },
    "529546": {
      "pl": "Ona zapłaciła krawcowi za swoją suknię.",
      "ru": null
    },
    "547730": {
      "pl": "Ja zapłacę.",
      "ru": "Я заплачу."
    },
    "591963": {
      "pl": "Zrobię to jeśli mi zapłacą.",
      "ru": null
    },
    "730575": {
      "pl": "Chciałbym zapłacić gotówką.",
      "ru": "Я бы хотел заплатить наличными."
    },
    "977279": {
      "pl": "Skreśl nazwiska osób, które zapłaciły składkę.",
      "ru": null
    },
    "1573126": {
      "pl": "Kto zapłaci?",
      "ru": null
    },
    "2151444": {
      "pl": "Faktura musi być zapłacona do pierwszego dnia następnego miesiąca.",
      "ru": "Счёт должен быть оплачен к первому числу следующего месяца."
    },
    "3017702": {
      "pl": "To, ile ci zapłacimy, zależy od twoich umiejętności.",
      "ru": null
    },
    "3495475": {
      "pl": "Zapłacisz gotówką?",
      "ru": "Заплатишь наличными?"
    },
    "4550568": {
      "pl": "Już zapłaciłeś.",
      "ru": null
    },
    "5221465": {
      "pl": "Kto zapłaci czynsz?",
      "ru": "Кто заплатит за аренду?"
    },
    "5221474": {
      "pl": "Nie mogę zapłacić czynszu.",
      "ru": "Я не могу оплатить аренду."
    },
    "5233098": {
      "pl": "Czesne muszą być zapłacone nie później niż 25 dnia tego miesiąca.",
      "ru": null
    },
    "5233101": {
      "pl": "Dziś jest ostatni dzień na zapłacenie czesnego, a ja nie mam pieniędzy na karcie kredytowej.",
      "ru": null
    },
    "5629833": {
      "pl": "Tom zapłacił.",
      "ru": "Том заплатил."
    },
    "5868591": {
      "pl": "Już zapłaciłaś.",
      "ru": null
    },
    "6119529": {
      "pl": "Zapłaciłem za ten samochód szesnaście tysięcy złotych.",
      "ru": "Я заплатил за эту машину шестнадцать тысяч злотых."
    },
    "6369806": {
      "pl": "Zapłacisz?",
