    "3807869": {
      "pl": "Nie uwierzyłbyś, gdybym ci powiedział.",
      "ru": null
    },
    "6156456": {
      "pl": "Kto mu uwierzy?",
      "ru": null
    },
    "6300180": {
      "pl": "Uwierzyliśmy mu.",
      "ru": null
    },
    "6328302": {
      "pl": "Nie uwierzyłeś mu chyba?",
      "ru": null
    },
    "6406241": {
      "pl": "Nie uwierzyłyśmy mu.",
      "ru": null
    },
    "7703693": {
      "pl": "Uwierzyli we wszystko co im powiedziałem.",
      "ru": null
    },
    "8231486": {
      "pl": "Komu uwierzysz?",
      "ru": null
    },
    "12201687": {
      "pl": "Uwierz.",
      "ru": null
    },
    "13360937": {
      "pl": "On nie uwierzył Maryi.",
      "ru": "Он не поверил Мэри."
    },
    "13660065": {
      "pl": "Uwierzcie mi, chcę wam pomóc.",
      "ru": "Поверьте мне, я хочу вам помочь."
    },
    "13785921": {
      "pl": "Tylko nienormalny by w coś takiego uwierzył.",
      "ru": "В это только ненормальный поверил бы."
    },
