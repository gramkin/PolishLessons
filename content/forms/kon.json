  "tatoeba": {
    "349198": {
      "pl": "Nie można jechać na dwóch koniach jednocześnie.",
      "ru": null
    },
    "502241": {
      "pl": "On dobrze jeździ na koniu.",
      "ru": null
    },
    "539970": {
      "pl": "Darowanemu koniowi nie patrzy się w zęby.",
      "ru": null
    },
    "754539": {
      "pl": "Na zmianę zajmowaliśmy się końmi.",
      "ru": null
    },
    "943621": {
      "pl": "Nie stawiać wozu przed koniem.",
      "ru": null
    },
    "951192": {
      "pl": "Dałem koniowi biec wolno.",
      "ru": null
    },
    "998890": {
      "pl": "On umie się obchodzić z końmi.",
      "ru": null
    },
    "2908728": {
      "pl": "Mam białego konia.",
      "ru": "У меня есть белый конь."
    },
    "3656217": {
      "pl": "Zejdź ze swojego konia.",
      "ru": "Слезай с твоей лошади."
    },
    "5416829": {
      "pl": "Ile zębów ma koń?",
      "ru": "Сколько зубов у лошади?"
    },
    "5416831": {
      "pl": "On zaplata grzywę swego konia w warkoczyki.",
      "ru": "Он заплетает гриву своей лошади в косички."
    },
    "5909117": {
      "pl": "Koń stary, ale zdrowy.",
      "ru": "Конь старый, но здоровый."
    },
    "6305758": {
      "pl": "Konie jedzą trawę.",
      "ru": "Лошади едят траву."
    },
    "6322219": {
      "pl": "Koty, psy i konie są zwierzętami.",
      "ru": "Собаки, кошки и лошади — животные."
    },
    "6935644": {
      "pl": "Mary kocha jeździć na swoim koniu.",
      "ru": null
    },
    "8664473": {
      "pl": "Dlaczego wielbłądy nienawidzą koni?",
      "ru": "Почему верблюды ненавидят лошадей?"
    },
    "8774126": {
      "pl": "Gdzie jest mój koń?",
      "ru": "Где моя лошадь?"
    },
    "9039809": {
      "pl": "Siano jest dla koni.",
      "ru": null
    },
    "11534945": {
      "pl": "Chłopiec bawi się drewnianym koniem.",
      "ru": null
    },
    "12196495": {
      "pl": "Nie sprzedam koni.",
      "ru": null
    },
    "12470076": {
      "pl": "Konie szybko biegają.",
      "ru": "Лошади быстро бегают."
    },
    "12586577": {
      "pl": "Prawdę mówiąc, chciałabym być księżniczką i żyć w wierzy, strzeżonej przez siedem smoków, i żeby książę na białym koniu odciął smokom głowy, żeby mnie uwolnić.",
      "ru": "На самом деле, я хотела быть принцессой и жить в башне, охраняемой семью драконами, и чтобы принц на белом коне отрубил драконам головы и освободил меня."
    }
  }
