  "tatoeba": {
    "352679": {
      "pl": "Ona zawsze chlubi się swymi dokonaniami akademickimi.",
      "ru": null
    },
    "353125": {
      "pl": "Awansował dzięki swym zdolnościom.",
      "ru": null
    },
    "357086": {
      "pl": "Dobrze się dogaduje ze swymi pracownikami.",
      "ru": null
    },
    "357286": {
      "pl": "Każdy ma swoje wady.",
      "ru": "У каждого есть свои недостатки."
    },
    "357381": {
      "pl": "Mary dumna była ze swej urody.",
      "ru": null
    },
    "364894": {
      "pl": "Jest znany ze swej mądrości.",
      "ru": null
    },
    "368461": {
      "pl": "Postępuj zgodnie ze swym sumieniem.",
      "ru": null
    },
    "368881": {
      "pl": "Poszerzył zakres swych badań.",
      "ru": null
    },
    "369054": {
      "pl": "Była gotowa stawić czoła swemu losowi.",
      "ru": null
    },
    "520094": {
      "pl": "Wtedy swe miecze przekują na lemiesze, a swoje włócznie na sierpy. Naród przeciw narodowi nie podniesie miecza, nie będą się więcej zaprawiać do wojny.",
      "ru": "И перекуют мечи свои на орала, и копья свои - на серпы; не поднимет народ на народ меча, и не будут более учиться воевать."
    },
    "520095": {
      "pl": "I przekują miecze swe na lemiesze, a włócznie swe na sierpy; nie podniesie naród przeciw narodowi miecza, ani się będą ćwiczyć do bitwy.",
      "ru": "И перекуют мечи свои на орала, и копья свои - на серпы; не поднимет народ на народ меча, и не будут более учиться воевать."
    },
    "526863": {
      "pl": "(On) postawił wiele pytań swojemu nauczycielowi.",
      "ru": "Он задал несколько вопросов своему учителю."
    },
    "538332": {
      "pl": "Pokładała dumę w swojej córce.",
      "ru": "Она гордится дочерью."
    },
    "610826": {
      "pl": "Był opętany swoimi ideami.",
      "ru": null
    },
    "676685": {
      "pl": "Chciałbym wyrazić swą wdzięczność za to, co uczyniłeś dla tego miasta.",
      "ru": "Я хотел бы выразить свою благодарность за то, что Вы сделали для нашего города."
    },
    "704000": {
      "pl": "Londyn znany jest ze swej mgły.",
      "ru": null
    },
    "742353": {
      "pl": "On gra w swoim pokoju.",
      "ru": "Он играет в своей комнате."
    },
    "766185": {
      "pl": "Są dumni ze swego mostu.",
      "ru": "Они гордятся своим мостом."
    },
    "775919": {
      "pl": "Pokazał język swojemu nauczycielowi.",
      "ru": "Он показал учителю язык."
    },
    "814602": {
      "pl": "Estonia ma swój hymn.",
      "ru": "У Эстонии есть свой гимн."
    },
    "898737": {
      "pl": "Zwykle dawał swemu psu tanią karmę.",
      "ru": null
    },
    "898738": {
      "pl": "Pawłow dzwonił dzwonkiem przed karmieniem swych psów.",
      "ru": "Павлов звонил в звонок перед тем, как покормить своих собак."
    },
    "948057": {
      "pl": "Tata szczyci się swym wzrostem i urodą.",
      "ru": null
    },
    "1002731": {
      "pl": "Orzeł runął w dół za swą zdobyczą.",
      "ru": null
    },
    "1353406": {
      "pl": "Umyj swą twarz.",
      "ru": null
    },
    "1918684": {
      "pl": "Należy kochać swych sąsiadów.",
      "ru": null
    },
    "2097188": {
      "pl": "Kocham swoje miasto.",
      "ru": "Я люблю свой город."
    },
    "2809339": {
      "pl": "Nie umyłem swoich włosów.",
      "ru": "Я не помыл голову."
    },
    "3464135": {
      "pl": "Bił swoje dzieci.",
      "ru": "Он бил своих детей."
    },
    "3516162": {
      "pl": "Szukam swojego klucza.",
      "ru": "Я ищу свой ключ."
    },
    "3630938": {
      "pl": "Tom dał swojemu psu kość.",
      "ru": "Том дал своему псу кость."
    },
    "3703927": {
      "pl": "Tom lubi swoją pracę.",
      "ru": "Том любит свою работу."
    },
    "4328008": {
      "pl": "Czekam na swoją kolej.",
      "ru": "Я жду своей очереди."
    },
    "4491090": {
      "pl": "Tom zjadł swój obiad.",
      "ru": "Том съел свой обед."
    },
    "4716869": {
      "pl": "On nie słucha swoich nauczycieli.",
      "ru": "Он не слушает своих учителей."
    },
    "5416831": {
      "pl": "On zaplata grzywę swego konia w warkoczyki.",
      "ru": "Он заплетает гриву своей лошади в косички."
    },
    "5662158": {
      "pl": "Podzieliłem się z Tomem swoimi wątpliwościami.",
      "ru": "Я поделился с Томом своими сомнениями."
    },
    "6154937": {
      "pl": "Jest podobna do swojej matki.",
      "ru": "Она похожа на свою мать."
    },
    "6324447": {
      "pl": "Uniwersytet nosi imię swego założyciela.",
      "ru": "Университет носит имя своего основателя."
    },
    "6694862": {
      "pl": "Zdradziłeś swój kraj.",
      "ru": "Ты предал свою страну."
    },
    "6993821": {
      "pl": "Ona pomogła swoim przyjaciołom.",
      "ru": "Она помогла своим друзьям."
    },
    "7960591": {
      "pl": "Dzieci spędzą ten dzień ze swoimi mamami.",
      "ru": "Дети проведут этот день со своими мамами."
    },
    "8666110": {
      "pl": "Odmieniona po remoncie świątynia otworzyła swe wrota dla prawosławnych wiernych i turystów.",
      "ru": "Преображённый после ремонта храм открыл двери для православных верующих и туристов."
    },
    "10747473": {
      "pl": "Kocham swojego syna.",
      "ru": "Я люблю своего сына."
    },
    "11519293": {
      "pl": "Królowa jest w swoim zamku.",
      "ru": "Королева в своём замке."
    },
    "12470368": {
      "pl": "Wszystko ma swoją cenę.",
      "ru": "У всего есть своя цена."
    },
    "12680444": {
      "pl": "Kochasz swojego brata?",
      "ru": "Ты любишь своего брата?"
    },
    "12681804": {
      "pl": "Nienawidzę swojej teściowej.",
      "ru": "Я ненавижу свою тёщу."
    },
    "13282893": {
      "pl": "Mery nadała swemu psu imię Ciasteczko.",
      "ru": null
    },
    "13547096": {
      "pl": "Tom nie zakluczył swoich drzwi.",
      "ru": "Том не запер свою дверь."
    }
  }
}
