  "tatoeba": {
    "363008": {
      "pl": "To, kim dziś jestem, zawdzięczam wykształceniu.",
      "ru": null
    },
    "366193": {
      "pl": "Powinieneś wykształcić w sobie nawyk używania słowników.",
      "ru": null
    },
    "461118": {
      "pl": "On ma wykształcenie klasyczne.",
      "ru": null
    },
    "540642": {
      "pl": "Wszyscy wykształceni Amerykanie prędzej czy później jadą do Europy.",
      "ru": null
    },
    "551650": {
      "pl": "Odrobina wykształcenia to niebezpieczna rzecz.",
      "ru": null
    },
    "760379": {
      "pl": "Ona odebrała klasyczne wykształcenie.",
      "ru": null
    },
    "760380": {
      "pl": "Ona jest osobą wykształconą klasycznie.",
      "ru": null
    },
    "765832": {
      "pl": "Powinieneś wykształcić w sobie zwyczaj wczesnego wstawania.",
      "ru": null
    },
    "921444": {
      "pl": "Poglądy człowieka zdeterminowane są jego wykształceniem, płcią, pozycją społeczną, wiekiem i innymi cechami.",
      "ru": null
    },
    "967635": {
      "pl": "Dzięki wykształceniu jestem tym, kim jestem.",
      "ru": null
    },
    "968941": {
      "pl": "To wuj go wykształcił.",
      "ru": null
    },
    "1920879": {
      "pl": "Wyraźnie odczułem potrzebę wykształcenia.",
      "ru": null
    },
    "3107112": {
      "pl": "Masz przewagę dobrego wykształcenia.",
      "ru": null
    },
    "5489644": {
      "pl": "Jest wykształconą dziewczyną.",
      "ru": null
    },
    "5489646": {
      "pl": "Ona jest wykształconą dziewczyną.",
      "ru": null
    },
    "8737513": {
      "pl": "Wykształcenie jest ważnym czynnikiem.",
      "ru": "Образование — важный фактор."
    },
    "10203188": {
      "pl": "Kalafior to nic innego jak kapusta z wyższym wykształceniem.",
