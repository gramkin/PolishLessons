  "tatoeba": {
    "367639": {
      "pl": "Słońce kryje się za zachodnim horyzontem.",
      "ru": null
    },
    "438405": {
      "pl": "Ona nie kryje wobec mnie wrogości.",
      "ru": null
    },
    "440616": {
      "pl": "W jej oczach kryło się współczucie.",
      "ru": null
    },
    "448856": {
      "pl": "W jego słowach kryje się jakaś zagadka.",
      "ru": "В его словах кроется какая-то загадка."
    },
    "716874": {
      "pl": "Kiedy wybuchł skandal, popierający go posłowie nie kryli wściekłości.",
      "ru": null
    },
    "914709": {
      "pl": "Nie zauważył, że za tą pochwałą kryła się ironia.",
      "ru": null
    },
    "1351006": {
      "pl": "Czy w tym mieście jest kryty basen?",
      "ru": null
    },
    "2707326": {
      "pl": "Nie kryje, że jest gejem.",
      "ru": null
    },
    "5652093": {
      "pl": "Kryć się!",
      "ru": null
    },
    "8756129": {
      "pl": "Piramidy wciąż kryją wiele tajemnic.",
      "ru": null
    },
    "8756135": {
      "pl": "Ciemność i cisza nocy kryją w sobie najskrytsze myśli.",
      "ru": null
    },
    "10597453": {
      "pl": "Kryj mnie.",
      "ru": null
    },
    "12040951": {
      "pl": "Nie zdawałem sobie sprawy, jak wiele kunsztu może kryć się w kanapce.",
      "ru": null
    }
  }
