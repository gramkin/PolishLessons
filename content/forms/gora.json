  "tatoeba": {
    "348788": {
      "pl": "Byłem w górach.",
      "ru": null
    },
    "350143": {
      "pl": "Chcemy się wspiąć na tamtą górę.",
      "ru": "Мы хотим забраться на ту гору."
    },
    "351528": {
      "pl": "Tę górę przez cały rok pokrywa śnieg.",
      "ru": "Эта гора покрыта снегом круглый год."
    },
    "353863": {
      "pl": "Góra jest pokryta śniegiem.",
      "ru": "Гора укрыта снегом."
    },
    "366800": {
      "pl": "Przebito tunel pod górą.",
      "ru": null
    },
    "383644": {
      "pl": "Wszystko jest do góry nogami.",
      "ru": "Всё вверх ногами."
    },
    "577497": {
      "pl": "Nie patrz na innych z góry.",
      "ru": "Не смотри на других свысока."
    },
    "669616": {
      "pl": "Księżyc wschodzi nad górami.",
      "ru": null
    },
    "733096": {
      "pl": "Jedni wolą morze, inni góry.",
      "ru": "Одни предпочитают море, другие — горы."
    },
    "745335": {
      "pl": "Miasto leży u stóp gór.",
      "ru": null
    },
    "956869": {
      "pl": "Z góry spadł kamień.",
      "ru": "Сверху упал камень."
