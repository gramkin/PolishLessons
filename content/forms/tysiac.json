      "pl": "Tysiąc Jenów wystarczy?",
      "ru": null
    },
    "3457079": {
      "pl": "Gdzie wy byliście w dwa tysiące trzecim roku?",
      "ru": "Где вы были в две тысячи третьем году?"
    },
    "3479798": {
      "pl": "Ma dwa tysiące książek.",
      "ru": "У неё есть две тысячи книг."
    },
    "4328659": {
      "pl": "Każdego roku eksportuje się około tysiąca ton mąki.",
      "ru": "Ежегодно экспортируется около тысячи тонн муки."
    },
    "6018074": {
      "pl": "Pojawił się na świecie w tysiąc dziewięćset sześćdziesiątym roku.",
