    },
    "11728934": {
      "pl": "Kto czyta, żyje tysiącem istnień.",
      "ru": null
    },
    "12748825": {
      "pl": "Daj mi tysiąc pocałunków.",
      "ru": "Дай мне тысячу поцелуев."
    },
    "13264472": {
      "pl": "Tysiące ludzi ucieka przed wojną.",
      "ru": "Тысячи людей бегут от войны."
    },
