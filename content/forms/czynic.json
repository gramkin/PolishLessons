  "tatoeba": {
    "352004": {
      "pl": "Trudno jest określać, co dobre, a co złe, ale należy to czynić.",
      "ru": "Нелегко решать, что правильно, а что нет, но приходится это делать."
    },
    "566157": {
      "pl": "Aktywnie czyń ludziom dobro.",
      "ru": null
    },
    "580048": {
      "pl": "Wybacz im, bo nie wiedzą, co czynią.",
      "ru": null
    },
    "592380": {
      "pl": "Jedna jaskółka nie czyni wiosny.",
      "ru": "Одна ласточка весны не делает."
    },
    "610017": {
      "pl": "Czyń zawsze to co jest słuszne.",
      "ru": null
    },
    "670423": {
      "pl": "Mądrze jest czynić przygotowania na czarną godzinę.",
      "ru": null
    },
    "734107": {
      "pl": "Mam do czynienia z tym problemem.",
      "ru": null
    },
    "749431": {
      "pl": "Pewne rodzaje pożywienia czynią nas spragnionymi.",
      "ru": null
    },
    "1356612": {
      "pl": "Wszystko należy czynić starannie.",
      "ru": null
    },
    "1430399": {
      "pl": "Wiara czyni cuda!",
      "ru": "Вера творит чудеса!"
    },
    "1458687": {
      "pl": "Tak czynią wszystkie.",
      "ru": null
    },
    "1863864": {
      "pl": "Czyńcie dobro tym, którzy was nienawidzą.",
      "ru": null
    },
    "2148306": {
      "pl": "Prawa ręka nie wie co czyni lewa.",
      "ru": "Правая рука не ведает, что творит левая."
    },
    "2576022": {
      "pl": "Świat nie jest idealny. Czy to nie właśnie z tego powodu robimy co w naszej mocy i właśnie w ten sposób czynimy go wspaniałym?",
      "ru": null
    },
    "4719265": {
      "pl": "Nie wiecie, z kim macie do czynienia!",
      "ru": "Вы не знаете, с кем имеете дело!"
    },
    "11570258": {
      "pl": "Czyń tak dobrze jak ja!",
