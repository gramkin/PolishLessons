  "tatoeba": {
    "357978": {
      "pl": "Twoje badania przyniosą owoce.",
      "ru": null
    },
    "364836": {
      "pl": "Co mam przynieść?",
      "ru": null
    },
    "415221": {
      "pl": "Jego odkrycie przyniosło rewolucję w transporcie.",
      "ru": null
    },
    "527606": {
      "pl": "Przynieś mi magazyny.",
      "ru": "Принеси мне журналы."
    },
    "659097": {
      "pl": "Przynieś mi moje okulary.",
      "ru": "Принеси мне мои очки."
    },
    "865972": {
      "pl": "Przyniesiesz mi filiżankę kawy?",
      "ru": null
    },
    "880232": {
      "pl": "Przyniosę wino.",
      "ru": null
    },
    "880234": {
      "pl": "Przyniosę butelkę białego wina.",
      "ru": "Я принесу бутылку белого вина."
    },
    "881976": {
      "pl": "Jaki wynik przyniosły nasze obrady?",
      "ru": null
    },
    "989416": {
      "pl": "Helena posmutniała, zobaczywszy, że nie przynieśliśmy żadnego prezentu.",
      "ru": null
    },
    "1583718": {
      "pl": "Ona mnie przyniosła kubek herbaty bez cukru.",
      "ru": "Она принесла мне чашку чая без сахара."
    },
    "3718064": {
      "pl": "Zobaczmy co przyniesie ta noc.",
      "ru": null
    },
    "3743736": {
      "pl": "Przynieś coś do czytania!",
      "ru": "Принеси чего-нибудь почитать!"
    },
    "3749789": {
      "pl": "Kto to przyniósł?",
      "ru": null
    },
    "4196793": {
      "pl": "Przynieś mi gaśnicę.",
      "ru": "Принеси мне огнетушитель."
    },
    "4546880": {
      "pl": "Chcę, żeby przyniesiono mi obiad do pokoju.",
      "ru": null
    },
    "6313385": {
      "pl": "Przyniosłem wam jeszcze jedną kołdrę.",
      "ru": "Я принёс вам ещё одно одеяло."
    },
    "6313387": {
      "pl": "Przyniosłem ci jeszcze jeden koc.",
      "ru": "Я принёс вам ещё одно одеяло."
    },
    "6313396": {
      "pl": "Przyniosłem ci jeszcze jedną kołdrę.",
      "ru": "Я принёс тебе ещё одно одеяло."
    },
    "7960429": {
      "pl": "Tom mówi wszystko, co mu ślina na język przyniesie.",
      "ru": "Том говорит всё, что ему в голову взбредёт."
    },
