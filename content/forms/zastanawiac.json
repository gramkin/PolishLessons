  "tatoeba": {
    "366607": {
      "pl": "Wszyscy zastanawialiśmy się, co się stało.",
      "ru": null
    },
    "367087": {
      "pl": "Nikt nie zastanawia się nad motywacjami.",
      "ru": null
    },
    "448913": {
      "pl": "Zastanawiał się, jaką pójść drogą.",
      "ru": null
    },
    "536115": {
      "pl": "Zastanawiała się, gdzie mogła podziać portfel.",
      "ru": null
    },
    "591867": {
      "pl": "Nad czym się zastanawiasz?",
      "ru": null
    },
    "719687": {
      "pl": "Zastanawiał się, dlaczego żona go opuściła.",
      "ru": "Он раздумывал, почему жена его бросила."
    },
    "746204": {
      "pl": "Zastanawiam się, czy on przyjdzie.",
      "ru": null
    },
    "751537": {
      "pl": "Zastanawiała się, co ma włożyć na przyjęcie.",
      "ru": null
    },
    "888190": {
      "pl": "Nie mogę przestać się zastanawiać czy przyjdzie na czas.",
      "ru": null
    },
    "959153": {
      "pl": "Zastanawiasz się, do czego doszliśmy?",
      "ru": null
    },
    "959177": {
      "pl": "Kiedy zbliżały się tygrysy, zastanawialiśmy się, kogo zjedzą najpierw.",
      "ru": null
    },
    "1160624": {
      "pl": "Zastanawialiśmy się, kto to był, a okazuje się, że to ty!",
      "ru": null
    },
    "1170253": {
      "pl": "Czy zastanawiałeś się kiedyś ile gwiazd jest na niebie?",
      "ru": null
    },
    "2810117": {
      "pl": "Zastanawiamy się nad kupnem nowego samochodu.",
      "ru": null
    },
    "3009375": {
      "pl": "Zastanawiam się, co się wydarzy.",
      "ru": null
    },
    "3679802": {
      "pl": "Zastanawia mnie, gdzie Tom mógłby być.",
      "ru": null
    },
    "3760152": {
      "pl": "Szczęście jest wtedy, kiedy nie zastanawiamy się nad tym, co to szczęście.",
      "ru": null
    },
    "3884259": {
      "pl": "Zastanawiam się, co powie Tom.",
      "ru": null
    },
    "3900142": {
      "pl": "Zastanawiałem się, co robisz.",
      "ru": null
    },
    "3922732": {
      "pl": "Tom zastanawiał się, co Mary tu robi.",
      "ru": null
    },
    "3941193": {
      "pl": "Zastanawiałem się, kto to jest.",
      "ru": null
    },
    "4746972": {
      "pl": "Zawsze mnie zastanawiało, dlaczego Hiszpania nie podbiła Portugalii.",
      "ru": "Меня всегда было интересно, почему Испания не завоевала Португалию."
    },
    "5223299": {
      "pl": "Mary się zastanawiała czy Tom na prawdę ją kocha.",
      "ru": null
    },
    "6156365": {
      "pl": "Zastanawiasz się jaką będziesz mamą?",
      "ru": null
    },
    "6373397": {
      "pl": "Zastanawiamy się dlaczego.",
      "ru": null
    },
    "6441413": {
      "pl": "Nie zastanawiałem się zbyt długo.",
      "ru": null
    },
    "9686575": {
      "pl": "Zastanawia mnie, czemu Tom kłamie.",
      "ru": null
    },
    "10774366": {
      "pl": "Czy zastanawiałaś się kiedyś, jak ryby przeżywają w chłodnej zimowej pogodzie, czy też dokąd odpływują, kiedy jeziora i stawy zamarzają?",
      "ru": null
    },
    "11264383": {
      "pl": "Nie zastanawiaj się za długo, bo sprzedam to komuś innemu!",
      "ru": null
    },
    "12085334": {
      "pl": "Zastanawiałam się, co to jest.",
      "ru": null
    },
    "12470594": {
      "pl": "Zastanawiałeś się kiedyś, jak ryby radzą sobie zimą albo dokąd się udają, kiedy jeziora i stawy zamarzają?",
      "ru": null
    },
    "12470595": {
