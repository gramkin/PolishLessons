  "tatoeba": {
    "356992": {
      "pl": "Byliśmy zdziwieni jego zachowaniem.",
      "ru": null
    },
    "358814": {
      "pl": "Wspaniale się zachował.",
      "ru": null
    },
    "361771": {
      "pl": "Jego zachowanie mnie zdumiało.",
      "ru": null
    },
    "366240": {
      "pl": "Musisz poprawić swoje zachowanie.",
      "ru": null
    },
    "440653": {
      "pl": "Zachowała się dość głupio.",
      "ru": null
    },
    "599437": {
      "pl": "Co sądzisz o jego zachowaniu?",
      "ru": null
    },
    "676716": {
      "pl": "W jego labolatorium było zachowanych ponad tysiąc notatników.",
      "ru": null
    },
    "734296": {
      "pl": "Syn wstydzi się swego zachowania.",
      "ru": null
    },
    "739021": {
      "pl": "Dziwię się twemu nieodpowiedzialnemu zachowaniu.",
      "ru": null
    },
    "911546": {
      "pl": "Jestem zniesmaczony pańskim zachowaniem.",
      "ru": null
    },
    "915155": {
      "pl": "Nie wiedząc, co powiedzieć, zachowałem milczenie.",
      "ru": null
    },
    "936395": {
      "pl": "Myślę, że ważne jest, byśmy zachowali spokój.",
      "ru": null
    },
    "951016": {
      "pl": "Nie spodziewałem się, że tak się zachowasz.",
      "ru": null
    },
    "961068": {
      "pl": "Anglik zachowałby się zupełnie inaczej.",
      "ru": null
    },
    "1350208": {
      "pl": "Powody takiego zachowania są trzy.",
      "ru": null
    },
    "1473125": {
      "pl": "Było jej wstyd, kiedy jej dziecko bardzo źle zachowało się publicznie.",
      "ru": "Ей было стыдно, когда её ребенок вел себя плохо на публике."
    },
    "1603872": {
      "pl": "Zachowałem spokój i nic nie powiedziałem.",
      "ru": null
    },
    "1844958": {
      "pl": "Zachowaj ciszę.",
      "ru": null
    },
    "2274453": {
      "pl": "Nie umiem wyjaśnić jego zachowania.",
      "ru": null
    },
    "2417194": {
      "pl": "Zachował się głupio.",
      "ru": null
    },
    "2706157": {
      "pl": "Zaczęłam myśleć, że zachowałam się głupio.",
      "ru": null
    },
    "3049815": {
      "pl": "Musimy zachować spokój.",
      "ru": "Мы должны сохранять спокойствие."
    },
    "3580772": {
      "pl": "Jestem zaskoczony twoim zachowaniem.",
      "ru": null
    },
    "3713578": {
      "pl": "Zachowała się niezwykle odważnie.",
      "ru": null
    },
    "3744913": {
      "pl": "Jego zachowanie było dziwne i niepokojące.",
      "ru": "Его поведение было странным и беспокойным."
    },
    "4657050": {
      "pl": "Tom poprosił, żebyśmy zachowali ciszę/milczenie.",
      "ru": null
    },
    "4923183": {
      "pl": "Źle się zachował.",
      "ru": null
    },
    "5627227": {
      "pl": "Zachowaj spokój.",
      "ru": null
    },
    "5879298": {
      "pl": "Zachowałem się głupio.",
      "ru": null
    },
    "7053931": {
      "pl": "Tom po prostu próbuje zachować twarz.",
      "ru": "Том просто пытается сохранить лицо."
    },
    "7881188": {
      "pl": "Zachowała tę tajemnicę dla siebie.",
      "ru": null
    },
    "10606391": {
      "pl": "Zachowaj tajemnicę.",
      "ru": null
    },
    "12209655": {
      "pl": "Zachowałeś równowagę.",
      "ru": null
    },
    "12225644": {
      "pl": "Zachowam to dla nich.",
      "ru": null
    },
    "12476609": {
      "pl": "Na pana miejscu zachowałbym czujność.",
      "ru": "Я бы на вашем месте насторожился."
    },
    "12476612": {
      "pl": "Na twoim miejscu zachowałbym czujność.",
      "ru": "Я бы на твоём месте насторожился."
    },
    "13430304": {
      "pl": "Co myślisz o takim zachowaniu?",
      "ru": null
    },
    "13784967": {
      "pl": "W takiej sytuacji bardzo trudno zachować twarz.",
