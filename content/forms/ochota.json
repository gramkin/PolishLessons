  "tatoeba": {
    "357974": {
      "pl": "Już nie mam ochoty na słodycze.",
      "ru": "Мне уже не хочется сладкого."
    },
    "361279": {
      "pl": "Nie mam ochoty go widzieć.",
      "ru": null
    },
    "931120": {
      "pl": "Możesz przyjść, jeśli masz ochotę.",
      "ru": "Можешь прийти, если есть желание."
    },
    "3433417": {
      "pl": "W sercu człowieka kryją się dwa sprzeczne ze sobą uczucia. Oczywiście nie ma osoby, która nie współczułaby bliźniemu w nieszczęściu. Jeśli jednak jest ona w stanie położyć kres jego niedoli, czuje się, jakby czegoś jej brakowało. Trochę hiperbolizując, można powiedzieć, że nachodzi ją ochota, by wpędzić tego człowieka ponownie w te same kłopoty. Co prawda nie jest tego świadoma, jednak ostatecznie zaczyna czuć do niego pewną wrogość.",
      "ru": null
    },
    "5985111": {
      "pl": "Nie mam ochoty tańczyć.",
      "ru": null
    },
    "6017180": {
      "pl": "Tom nie miał ochoty spotkać się z Mary.",
      "ru": "У Тома не было желания встречаться с Мэри."
    },
    "6320842": {
      "pl": "Masz ochotę na coś mocniejszego?",
      "ru": "Хочешь чего-нибудь покрепче?"
    },
    "8493344": {
      "pl": "Mam ochotę na coś słodkiego.",
      "ru": "Мне хочется чего-нибудь сладкого."
    },
    "12624947": {
      "pl": "Miał ochotę podzielić się ze wszystkimi swoim żalem.",
      "ru": "Ему хотелось поделиться со всеми своим горем."
    }
  }
