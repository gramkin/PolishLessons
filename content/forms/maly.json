  "tatoeba": {
    "351479": {
      "pl": "Mój pokój jest bardzo mały.",
      "ru": "Моя комната очень маленькая."
    },
    "355256": {
      "pl": "Holandia to mały kraj.",
      "ru": "Голландия — маленькая страна."
    },
    "404475": {
      "pl": "Nie ma najmniejszych wątpliwości.",
      "ru": null
    },
    "457359": {
      "pl": "Nie. Są zbyt mali.",
      "ru": null
    },
    "625415": {
      "pl": "Książka jest mała.",
      "ru": "Книга маленькая."
    },
    "675708": {
      "pl": "On jest mały i słaby.",
      "ru": "Он маленький и слабый."
    },
    "702145": {
      "pl": "Ta książka jest najmniejsza ze wszystkich.",
      "ru": null
    },
    "781065": {
      "pl": "Mieszkam w małym mieście.",
      "ru": "Я живу в маленьком городке."
    },
    "787829": {
      "pl": "Nie masz nic mniejszego niż to?",
      "ru": null
    },
    "820801": {
      "pl": "Szukam małej walizki.",
      "ru": null
    },
    "911545": {
      "pl": "Dałem to małemu chłopcu.",
      "ru": null
    },
    "940967": {
      "pl": "Które zwierzę jest małe?",
      "ru": "Какое животное маленькое?"
    },
    "968907": {
      "pl": "Nie mam najmniejszej ochoty uczyć się dziś wieczór.",
      "ru": null
    },
    "1611407": {
      "pl": "Nie widzę małych liter.",
      "ru": null
    },
    "2277694": {
      "pl": "To krzesło jest za małe.",
      "ru": "Этот стул слишком маленький."
    },
    "3261393": {
      "pl": "Nie mam najmniejszego pojęcia.",
      "ru": null
    },
    "3398961": {
      "pl": "Europa ma mniejszą populację niż Azja.",
      "ru": null
    },
    "3660858": {
      "pl": "Znam ją od wtedy, kiedy była małą dziewczynką.",
      "ru": "Я знаю её с тех пор, как она была маленькой девочкой."
    },
    "3744908": {
      "pl": "Czy nie ma mniejszych paczek?",
      "ru": null
    },
    "5652986": {
      "pl": "Koliber to najmniejszy ptak na świecie.",
      "ru": "Колибри - самая маленькая птица в мире."
    },
    "6322301": {
      "pl": "Poproszę dwie małe butelki.",
      "ru": "Две маленькие бутылки, пожалуйста."
    },
    "6324472": {
      "pl": "Macie mniejszy rozmiar?",
      "ru": "У вас есть размер поменьше?"
    },
    "6406060": {
      "pl": "Nie mam najmniejszych wątpliwości.",
      "ru": "У меня нет ни малейших сомнений."
    },
    "6406061": {
      "pl": "Nie miała najmniejszych szans.",
      "ru": "У неё не было ни малейшего шанса."
    },
    "6483087": {
      "pl": "Jeż jest małym zwierzęciem.",
      "ru": "Ёж - это маленькое животное."
    },
    "7727837": {
      "pl": "5 jest mniejsze od 8.",
      "ru": null
    },
    "8617129": {
      "pl": "Mniejsza o to!",
      "ru": null
    },
    "10483325": {
      "pl": "Możesz usunąć żółtko z jajka bez rozbijania go, robiąc małą dziurkę w skorupce igłą.",
      "ru": "Ты можешь удалить желток из яйца и не разбить его, проткнув иголкой маленькую дырочку в скорлупе."
    },
    "11319304": {
      "pl": "Czasami chciałbym być małym ptaszkiem.",
      "ru": "Иногда мне бы хотелось быть маленькой птичкой."
    },
    "12077885": {
      "pl": "Był mniejszy niż myślałem.",
      "ru": null
    },
    "12378803": {
      "pl": "Najmniejszym kontynentem jest Australia.",
      "ru": null
    },
    "12454749": {
      "pl": "Ten aparat jest najmniejszy.",
      "ru": null
    },
    "12710212": {
      "pl": "Rzeka była mała.",
      "ru": "Река была маленькая."
    },
    "12760597": {
      "pl": "To nie to mnie niepokoi. Znaczy, to też, pewnie, ale w mniejszym stopniu.",
      "ru": "Меня не это беспокоит. То есть это тоже, конечно, но в меньшей степени."
    },
    "13225522": {
      "pl": "Teraz zrobię małą przerwę, a potem będę dalej robić angielski.",
      "ru": "Сейчас я сделаю небольшую паузу, а потом продолжу заниматься английским."
    },
    "13788497": {
