  "tatoeba": {
    "351536": {
      "pl": "Z wiekiem zacząłem inaczej patrzeć na różne sprawy.",
      "ru": "Я стал старше, поэтому я стал смотреть на вещи по-другому."
    },
    "442889": {
      "pl": "Stał patrząc w niebo.",
      "ru": null
    },
    "524703": {
      "pl": "Patrz, on idzie.",
      "ru": "Смотри, он идёт."
    },
    "833028": {
      "pl": "Piękno tkwi w oczach patrzącego.",
      "ru": null
    },
    "945782": {
      "pl": "Człowiek robi się nerwowy od samego patrzenia.",
      "ru": null
    },
    "970443": {
      "pl": "Patrz mi w oczy.",
      "ru": "Смотри мне в глаза."
    },
    "1134209": {
      "pl": "Patrzę na ten dom.",
      "ru": null
    },
    "1357069": {
      "pl": "Wszyscy się na nas patrzą.",
      "ru": "Все на нас смотрят."
    },
    "1361837": {
      "pl": "Przestań na mnie patrzeć jak na „normalnego” człowieka.",
      "ru": "Прекрати видеть во мне «нормального» человека!"
    },
    "2298820": {
      "pl": "Nie patrz na nią!",
      "ru": "Не смотри на неё!"
    },
    "2495917": {
      "pl": "Nauczyciele i koledzy ze zdziwieniem patrzą na zmieszanego ucznia, który pomylił Tiutczewa z Fetem.",
      "ru": "Учителя и одноклассники удивлённо смотрят на сконфуженного ученика, перепутавшего Тютчева с Фетом."
    },
    "3086109": {
      "pl": "Nie patrzymy.",
      "ru": null
    },
    "4706810": {
      "pl": "Dlaczego Tom patrzy na mnie?",
      "ru": "Почему Том на меня смотрит?"
    },
    "5377648": {
      "pl": "Patrz pod nogi.",
      "ru": "Смотри под ноги."
    },
    "5398146": {
      "pl": "Tom na nas patrzy.",
      "ru": "Том на нас смотрит."
    },
    "6160580": {
      "pl": "Patrz.",
      "ru": "Смотри."
    },
    "6302074": {
      "pl": "Szanujmy historię, ale patrzmy w przyszłość.",
      "ru": "Давайте чтить историю, но смотреть в будущее."
    },
    "6313576": {
      "pl": "Czy oni na nas patrzą?",
      "ru": "Они смотрят на нас?"
    },
    "6672459": {
      "pl": "Patrz wyżej!",
      "ru": "Смотри выше!"
    },
    "8108754": {
      "pl": "Patrz, śnieg pada!",
      "ru": "Смотри, снег идёт!"
    },
    "11261797": {
      "pl": "Patrzcie!",
      "ru": null
    },
    "12470276": {
      "pl": "Ptak patrzy na ciebie ze swojej grzędy.",
      "ru": "Птица смотрит на тебя со своего насеста."
    },
    "13045915": {
      "pl": "Będziecie tak stali i patrzeli, jak on umiera?",
      "ru": "Вы так и будете стоять и смотреть, как он умирает?"
    },
    "13784970": {
      "pl": "Czemu na mnie tak podejrzliwie patrzysz?",
