  "tatoeba": {
    "364807": {
      "pl": "Zawsze wolałem postacie tajemnicze.",
      "ru": "Мне всегда больше нравились таинственные персонажи."
    },
    "415231": {
      "pl": "Wolę kawę od herbaty.",
      "ru": "Предпочитаю чаю кофе."
    },
    "495073": {
      "pl": "Ona woli piwo od wina.",
      "ru": "Она любит пиво больше, чем вино."
    },
    "529944": {
      "pl": "Wolę kawę.",
      "ru": null
    },
    "691921": {
      "pl": "Wolałby pan herbatę czy kawę?",
      "ru": null
    },
    "733096": {
      "pl": "Jedni wolą morze, inni góry.",
      "ru": "Одни предпочитают море, другие — горы."
    },
    "914997": {
      "pl": "Wszyscy woleliby, by został wybrany na gubernatora.",
      "ru": null
    },
    "1866780": {
      "pl": "Wolisz kapitalizm czy socjalizm?",
      "ru": "Предпочитаешь капитализм или социализм?"
    },
    "2144058": {
      "pl": "Wolę angielski.",
      "ru": "Я предпочитаю английский."
    },
    "3643272": {
      "pl": "Wolisz herbatę z cytryną, czy z mlekiem?",
      "ru": "Тебе больше нравится чай с лимоном или с молоком?"
    },
    "3978503": {
      "pl": "Które wolisz?",
      "ru": null
    },
    "4748403": {
      "pl": "Który wolisz?",
      "ru": null
    },
    "4775900": {
      "pl": "Czy wolałbyś herbatę?",
      "ru": null
    },
    "4837779": {
      "pl": "Wolałabym sama to zrobić.",
      "ru": null
    },
    "5516877": {
      "pl": "Wolą Państwo kawę czy herbatę?",
      "ru": null
    },
    "6301962": {
      "pl": "Pewnie wolałby tego droższego.",
      "ru": null
    },
    "6301971": {
      "pl": "Ale nie, ty wolałaś pojechać do droższego supermarketu.",
      "ru": null
    },
    "6314051": {
      "pl": "Woli ciszę.",
      "ru": "Он предпочитает спокойствие."
    },
    "7582478": {
      "pl": "Wolałbyś kawę czy herbatę?",
      "ru": null
    },
    "8507451": {
      "pl": "Wolałbym zostać.",
      "ru": null
    },
    "8608519": {
      "pl": "Które z tych czasopism byś wolała?",
      "ru": null
    },
    "8746857": {
      "pl": "Wolałbym umrzeć.",
      "ru": null
    },
    "10584468": {
      "pl": "Wolę czerń.",
      "ru": null
    },
    "11324091": {
      "pl": "Wolałabym zostać w domu niż iść na ryby.",
      "ru": null
    },
    "11564858": {
      "pl": "Wolałem poczekać.",
      "ru": null
    },
    "12680261": {
      "pl": "Wolą uczyć się języków martwych.",
      "ru": null
    },
    "12755404": {
      "pl": "Co kogo boli, o tym mówić woli.",
      "ru": "У кого что болит, тот о том и говорит."
    },
    "12950787": {
      "pl": "Tom wolał lecieć za granicę.",
      "ru": null
    },
    "12960446": {
      "pl": "Tomasz wolał jechać za granicę.",
      "ru": null
    },
    "13786623": {
      "pl": "Wolność wyboru, którą nam dano, nie wyklucza naszych prób zmiany, według ludzkich „praw chciwości”, tego, co jest określone jedynie wolą Wszechmogącego. Rosja od stulecia usiłuje wykorzystać tę okoliczność w swojej polityce, tym samym pokazując reszcie świata marność, bezsensowność i grzeszność tej pożądliwej namiętności.",
      "ru": "Свобода выбора, дарованная нам, не исключает и наших попыток изменить по человеческим «законам алчности» то, что определяется только волей Всевышнего. Россия в течение целого века стремится задействовать это обстоятельство в своей политике, тем самым показывая остальному миру тщетность, бессмысленность и греховность этой вожделенной страсти."
    },
    "13951059": {
      "pl": "My wolimy zostać tutaj.",
      "ru": null
    }
  }
