    "358887": {
      "pl": "Nie łap dwóch srok za ogon.",
      "ru": null
    },
    "360189": {
      "pl": "Łapcie tego mężczyznę!",
      "ru": null
    },
    "361325": {
      "pl": "Łapcie go!",
      "ru": null
    },
    "516511": {
      "pl": "Nie wszyscy łapiemy przeziębienie.",
      "ru": null
    },
    "553189": {
      "pl": "Ona łatwo łapie przeziębienie.",
      "ru": "Она быстро подхватывает простуду."
    },
    "558277": {
      "pl": "Ona często łapała przeziębienia.",
      "ru": "Она часто простужалась."
    },
    "563474": {
      "pl": "Często łapię przeziębienia.",
      "ru": null
    },
    "565313": {
      "pl": "On łatwo łapie przeziębienia.",
      "ru": "Он легко простужается."
    },
    "567124": {
      "pl": "Łapać dwie sroki za ogon.",
      "ru": null
    },
    "930182": {
      "pl": "Zawsze zimą łapię katar.",
      "ru": null
    },
    "1481979": {
      "pl": "Kiedy trzeba przenieść pianino, nie łap się za stołek.",
      "ru": null
    },
    "1829458": {
      "pl": "Wszystkie ryby łapane w tej rzecze są pyszne.",
      "ru": null
    },
    "3894937": {
      "pl": "Nie łapiesz?",
      "ru": null
    },
    "4790160": {
      "pl": "Tom tego nie łapie.",
      "ru": null
    },
    "6155783": {
      "pl": "Pajęczyna jest potrzebna pająkom między innymi do łapania owadów.",
      "ru": null
    },
    "8547482": {
      "pl": "Koty łapią myszy.",
      "ru": null
    },
    "8745395": {
      "pl": "Łap!",
      "ru": null
    },
    "12118157": {
      "pl": "Psy nie próbują łapać myszy.",
      "ru": null
    },
    "12470435": {
      "pl": "Łapiesz?",
      "ru": null
    },
    "12951299": {
      "pl": "Już łapię.",
      "ru": null
    },
    "13654041": {
      "pl": "Zaczynam łapać.",
