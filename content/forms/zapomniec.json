  "tatoeba": {
    "353150": {
      "pl": "Jego nazwisko szybko zapomną.",
      "ru": null
    },
    "356527": {
      "pl": "Zapomniałem go zapytać.",
      "ru": "Я забыл его спросить."
    },
    "792356": {
      "pl": "Z upływem czasu o sprawie zapomniano.",
      "ru": null
    },
    "830348": {
      "pl": "Zapomnienie parasola w pociągu wynikło z twojej nieuwagi.",
      "ru": null
    },
    "1181224": {
      "pl": "Ten fakt nie może zostać zapomniany.",
      "ru": "Этот факт не должен быть забыт."
    },
    "1348357": {
      "pl": "Nigdy nie zapomnę ich ciepłych rąk.",
      "ru": "Я никогда не забуду их тёплые руки."
    },
    "2147222": {
      "pl": "Zapomnij o tym.",
      "ru": "Забудь про это."
    },
    "2153670": {
      "pl": "Zapomniał nakarmić psa.",
      "ru": "Он забыл покормить собаку."
    },
    "2835007": {
      "pl": "Zapomniałeś postawić kropki na końcu zdania.",
      "ru": "Ты забыл поставить точку в конце предложения."
    },
    "3363425": {
      "pl": "Jesteś pewien, że niczego nie zapomniałeś?",
      "ru": "Ты уверен, что ничего не забыл?"
    },
    "3415865": {
      "pl": "Zapomnijmy o tym co się dzisiaj stało.",
      "ru": null
    },
    "3421141": {
      "pl": "Musiałem o tym zapomnieć.",
      "ru": "Должно быть, я об этом забыл."
    },
    "3433161": {
      "pl": "Zapomniała, że kupiła mu prezent.",
      "ru": "Она забыла, что купила ему подарок."
    },
    "3460660": {
      "pl": "Zapomniałam ci powiedzieć o Tomku.",
      "ru": "Я забыла рассказать тебе про Тома."
    },
    "3542164": {
      "pl": "Chłopaki, nie warto otwierać tego tematu. Jesteście młodzi, żartobliwi, dla was wszystko jest łatwe. To nie jest. To nie jest Czikatiło i nawet nie archiwa służb specjalnych. Tutaj lepiej nie włazić. Poważnie, każdy z was będzie żałować. Najlepiej zamknijcie temat i zapomnijcie, co się tu pisało. Całkiem rozumiem, że tą wiadomością wywołam dodatkowe zainteresowanie, ale chcę od razu ostrzec dociekliwych - stop. Pozostałych po prostu nie znajdą.",
      "ru": "Ребята, не стоит вскрывать эту тему. Вы молодые, шутливые, вам все легко. Это не то. Это не Чикатило и даже не архивы спецслужб. Сюда лучше не лезть. Серьезно, любой из вас будет жалеть. Лучше закройте тему и забудьте, что тут писалось. Я вполне понимаю, что данным сообщением вызову дополнительный интерес, но хочу сразу предостеречь пытливых – стоп. Остальных просто не найдут."
    },
    "3656717": {
