  "tatoeba": {
    "349117": {
      "pl": "Dobrze mi służył ten nóż.",
      "ru": null
    },
    "357115": {
      "pl": "Jonesowie płacą służącym co tydzień.",
      "ru": null
    },
    "358854": {
      "pl": "Służąca sprzątnęła podłogę.",
      "ru": null
    },
    "440676": {
      "pl": "Jaki władca, taki służący.",
      "ru": null
    },
    "709383": {
      "pl": "W czasie wojny służył w armii.",
      "ru": null
    },
    "719032": {
      "pl": "Służyła w tym domu przez dwadzieścia lat.",
      "ru": null
    },
    "730397": {
      "pl": "Uprzejmie służę pomocą.",
      "ru": null
    },
    "732944": {
      "pl": "Z przyjemnością służę pomocą.",
      "ru": null
    },
    "735861": {
      "pl": "Traktuj swego służącego lepiej.",
      "ru": null
    },
    "751481": {
      "pl": "Służący stopniowo przyzwyczajał się do nowego otoczenia.",
      "ru": null
    },
    "751510": {
      "pl": "Czemu to służy?",
      "ru": null
    },
    "780312": {
      "pl": "On w zasadzie jest jej służącym.",
      "ru": null
    },
    "833016": {
      "pl": "Wieprzowina mi nie służy.",
      "ru": null
    },
    "859680": {
      "pl": "Ten starzec służył królowi przez wiele lat.",
      "ru": null
    },
    "976171": {
      "pl": "On ma służącą.",
      "ru": null
    },
    "1496209": {
      "pl": "Pies ma właścicieli, kot ma służących.",
      "ru": null
    },
    "2045577": {
      "pl": "Służenie ludziom jest jego jedynym celem w życiu.",
      "ru": null
    },
    "3099492": {
      "pl": "Do czego to służy?",
      "ru": null
    },
    "3364659": {
      "pl": "Służyłeś mi wiernie i uczciwie.",
      "ru": null
    },
    "5315947": {
      "pl": "Marek woła swoich służących.",
      "ru": null
    },
    "5320062": {
      "pl": "Kwintus ma dwóch służących.",
      "ru": null
    },
    "6029653": {
      "pl": "Te drogie gadżety służą tylko po to, aby rozpraszać ludzi od ważniejszych rzeczy w życiu.",
      "ru": null
    },
    "7893716": {
      "pl": "Służąca miała właśnie posprzątać pokój, kiedy weszła Carol.",
      "ru": null
    },
    "8359424": {
      "pl": "Jestem gotowy ci służyć.",
      "ru": null
    },
    "10309151": {
      "pl": "Nie jestem twoją służącą.",
      "ru": null
    },
    "10604881": {
      "pl": "Polityk powinien służyć narodowi.",
      "ru": null
    },
    "11570692": {
      "pl": "Służąca kładzie na stole talerze.",
      "ru": null
    },
    "13041688": {
      "pl": "Czym mogę służyć.",
      "ru": null
    },
    "13570149": {
      "pl": "Nigdy też nie nosiłem butów. Prawdę mówiąc, nigdy nie służyłem w wojsku.",
      "ru": null
    },
    "13784902": {
      "pl": "Do czego służą twoje palce?",
      "ru": null
    }
  }
