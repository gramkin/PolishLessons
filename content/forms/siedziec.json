  "tatoeba": {
    "366110": {
      "pl": "Siedzieli w cieniu drzewa.",
      "ru": null
    },
    "393079": {
      "pl": "Siedziała na krześle czytając magazyn.",
      "ru": "Она сидела на стуле и читала журнал."
    },
    "457694": {
      "pl": "W niedziele siedzę w domu.",
      "ru": "По воскресеньям я сижу дома."
    },
    "754201": {
      "pl": "Siedziała pod drzewem.",
      "ru": "Она сидела под деревом."
    },
    "820805": {
      "pl": "Dziewczynki siedziały obok siebie.",
      "ru": null
    },
    "901389": {
      "pl": "A właśnie, ostatnio podpity facet siedzący obok w pociągu poprosił, bym rzucił okiem na napisane przez niego haiku.",
      "ru": null
    },
    "914811": {
      "pl": "Wczoraj siedziałem do późna.",
      "ru": null
    },
    "925917": {
      "pl": "Kot siedzi na krześle.",
      "ru": "Кошка сидит на стуле."
    },
    "965320": {
      "pl": "Żaden ptak nie lubi siedzieć w klatce.",
      "ru": "Ни одна птица не любит сидеть в клетке."
    },
    "1181750": {
      "pl": "Masz nic nie robić poza siedzeniem tu i odpowiadaniem na pytania lekarza.",
      "ru": null
    },
    "1353156": {
      "pl": "Dziewczyna siedząca przy pianinie to moja córka.",
      "ru": null
    },
    "2116626": {
      "pl": "Dziecko siedziało na wysokim krześle i jadło obiad.",
      "ru": null
    },
    "2202155": {
      "pl": "Pod stołem siedzi kot.",
      "ru": "Под столом сидит кот."
    },
    "3065553": {
      "pl": "Gdzie siedzisz?",
      "ru": null
    },
    "3461128": {
      "pl": "Tomek siedział i czytał.",
      "ru": "Том сидел и читал."
    },
    "3710454": {
      "pl": "Siedział tam z fajką w ustach.",
      "ru": "Он сидел там с трубкой во рту."
    },
    "3744788": {
      "pl": "Trzeba działać a nie siedzieć z założonymi rękami.",
      "ru": "Нужно действовать, а не сидеть сложа руки."
    },
    "3750345": {
      "pl": "Siedzieliśmy w kole.",
      "ru": null
    },
    "4716895": {
      "pl": "Ona siedzi na ławce.",
      "ru": "Она сидит на скамейке."
    },
    "4756103": {
      "pl": "Tom siedzi na krześle.",
      "ru": "Том сидит на стуле."
    },
    "4935774": {
      "pl": "Moja mała córka lubi siedzieć na moich ramionach.",
      "ru": "Дочке нравится сидеть у меня на плечах."
    },
    "6156286": {
      "pl": "Na tylnym siedzeniu było mu niewygodnie.",
      "ru": "На заднем сиденье ему было неудобно."
    },
    "6373377": {
      "pl": "Na krześle siedział kot.",
      "ru": "На стуле сидела кошка."
    },
    "8507604": {
      "pl": "Siedzimy na krześle.",
      "ru": null
    },
    "8541108": {
      "pl": "On siedzi w fotelu.",
      "ru": "Он сидит в кресле."
    },
    "8617184": {
      "pl": "Siedź cicho.",
      "ru": null
    },
    "9671444": {
      "pl": "Siedziałyśmy i czekałyśmy.",
      "ru": null
    },
    "10568104": {
      "pl": "Szukam miejsca do siedzenia.",
      "ru": null
    },
    "10667947": {
      "pl": "Widziałem Mary siedzącą na kolanach Toma.",
      "ru": null
    },
    "11505020": {
      "pl": "Pszczoły siedzą na kwiatach.",
      "ru": null
    },
    "12005228": {
      "pl": "Na dachu siedzi gołąb.",
      "ru": "На крыше сидит голубь."
    },
    "12058958": {
      "pl": "Dziadek zasnął siedząc na kanapie.",
      "ru": null
    },
    "12187550": {
      "pl": "Siedziałam tam.",
      "ru": null
    },
    "12476428": {
      "pl": "Tam jest wolne siedzenie.",
