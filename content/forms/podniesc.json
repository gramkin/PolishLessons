    "349341": {
      "pl": "Podniosła kamyk.",
      "ru": null
    },
    "351346": {
      "pl": "Do końca życia się z tego nie podniesie.",
      "ru": "Он не оправится от этого до конца своей жизни."
    },
    "358753": {
      "pl": "Mama przestała szyć i podniosła książkę.",
