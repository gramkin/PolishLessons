  "tatoeba": {
    "801978": {
      "pl": "Poeta wyraził płomienną miłość w stosunku do ukochanej kobiety.",
      "ru": null
    },
    "945802": {
      "pl": "Stracił ukochanego syna.",
      "ru": null
    },
    "956883": {
      "pl": "Ukochana, wróć do mnie!",
      "ru": null
    },
    "956884": {
      "pl": "Miała rozdarte serce, kiedy usłyszała o śmierci ukochanego.",
      "ru": null
    },
    "1060714": {
      "pl": "Augusto jest moim najukochańszym synem.",
      "ru": null
    },
    "1759139": {
      "pl": "Jest też grupa mężczyzn, którzy swój pierwszy raz chcą przeżyć z ukochaną osobą i czekają na odpowiedni moment.",
      "ru": null
    },
    "5221451": {
      "pl": "Jesteś moim ukochanym.",
      "ru": null
    },
    "5221452": {
      "pl": "Jesteś moją ukochaną.",
      "ru": null
    },
    "8580242": {
      "pl": "Wstanę, po mieście chodzić będę, wśród ulic i placów, szukać będę ukochanego mej duszy.",
      "ru": "Встану же я, пойду по городу, по улицам и площадям, и буду искать того, которого любит душа моя."
    },
    "13074660": {
      "pl": "Maria jest moją pasierbicą, ale kocham ją tak, jakby była moją ukochaną córką.",
      "ru": null
    },
    "13203557": {
      "pl": "Wszystkiego najlepszego, mój prawnuku, mój ukochany książę! Masz dopiero 13 lat, rozkwitasz życiem, które twoja uprzywilejowana istota wie, jak przekształcić w wykwintną piosenkę. Niech Bóg cię błogosławi i chroni.",
      "ru": null
    },
    "13591464": {
      "pl": "Wszystkie troski dobrego ojca skupiają się na tym ukochanym dziecku.",
      "ru": null
    }
  }
