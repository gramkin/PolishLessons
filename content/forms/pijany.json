    "6554190": {
      "pl": "Nie jestem aż tak pijana.",
      "ru": "Я не настолько пьяная."
    },
    "6566910": {
      "pl": "Zrobiłem to po pijanemu.",
      "ru": null
    },
    "6935830": {
      "pl": "Myślę, że nigdy wcześniej nie widziałem cię tak pijanego.",
      "ru": null
    },
    "8773758": {
      "pl": "Wszyscy są pijani.",
