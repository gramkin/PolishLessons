    },
    "6154882": {
      "pl": "Wczoraj byłem tak pijany, że nie pamiętam jak doszedłem do domu.",
      "ru": "Вчера я был такой пьяный, что не помню, как дошёл до дома."
    },
    "6320356": {
      "pl": "Nigdy nikt mnie nie widział pijanej.",
