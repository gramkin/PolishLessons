    },
    "4719314": {
      "pl": "Jesteś zbyt pijany, by prowadzić samochód.",
      "ru": "Ты слишком пьян, чтобы вести машину."
    },
    "5223973": {
      "pl": "Nigdy nie kłóć się z pijanym.",
