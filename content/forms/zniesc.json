  "tatoeba": {
    "356446": {
      "pl": "Trzeba znieść karę śmierci.",
      "ru": null
    },
    "362425": {
      "pl": "Moje kury zniosły mniej jajek w zeszłym roku.",
      "ru": null
    },
    "364741": {
      "pl": "Nie mogę go znieść.",
      "ru": null
    },
    "448899": {
      "pl": "Znieś tu książki.",
      "ru": null
    },
    "525311": {
      "pl": "Prezydent zniósł niewolnictwo.",
      "ru": null
    },
    "691830": {
      "pl": "Kara śmierci powinna zostać zniesiona.",
      "ru": null
    },
    "745424": {
      "pl": "W ubiegłym roku zniesiono karę śmierci.",
      "ru": null
    },
    "746184": {
      "pl": "Kilka mostów zostało uszkodzonych lub zniesionych.",
      "ru": null
    },
    "766148": {
      "pl": "Domagał się zniesienia różnic klasowych.",
      "ru": null
    },
    "831715": {
      "pl": "Wielka powódź zniosła kilka domów.",
      "ru": null
    },
    "908090": {
      "pl": "Powódź zniosła most.",
      "ru": null
    },
    "964977": {
      "pl": "To wspaniałe, jak szybko ten lek zniósł ból.",
      "ru": null
    },
    "982851": {
      "pl": "Wiele państw zniosło karę śmierci.",
      "ru": null
    },
    "1170264": {
      "pl": "Nie zniosę pracy z nim.",
      "ru": null
    },
    "1176736": {
      "pl": "Dłużej tego nie zniosę!",
      "ru": null
    },
    "1183481": {
      "pl": "To nie do zniesienia!",
      "ru": null
    },
    "2139041": {
      "pl": "Nie mogę znieść zimna.",
      "ru": null
    },
    "2147273": {
      "pl": "Ten hałas jest nie do zniesienia.",
      "ru": "Этот шум невыносим."
    },
    "2757121": {
      "pl": "Kura zniosła jajko.",
      "ru": null
    },
    "3629751": {
      "pl": "Nie zniosę dłużej tego hałasu.",
      "ru": null
    },
    "3711190": {
      "pl": "Tom mówi, że nie zniesie dłużej tego hałasu.",
      "ru": null
    },
    "3931687": {
      "pl": "Jestem zdania, że podatek powinien być zniesiony.",
      "ru": null
    },
    "8617828": {
      "pl": "Tom został zniesiony z boiska na noszach.",
      "ru": null
    },
    "10559671": {
      "pl": "Emerytury powinny zostać zniesione.",
      "ru": null
    },
    "10773800": {
      "pl": "Idź na górę i znieś mój kufer.",
      "ru": null
    }
