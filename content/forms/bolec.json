    },
    "732927": {
      "pl": "Po kilku godzinach ząb znów zaczął boleć.",
      "ru": null
    },
    "760350": {
      "pl": "Poszedłbym, gdyby nie bolała mnie głowa.",
      "ru": null
    },
    "905901": {
      "pl": "Następnego dnia bolały mnie nogi.",
      "ru": null
    },
    "1605844": {
      "pl": "Boli mnie noga.",
      "ru": "У меня болит нога."
    },
    "3743792": {
      "pl": "Bolą ją plecy.",
      "ru": "У неё болит спина."
    },
    "4270720": {
      "pl": "Bolał ją brzuch.",
      "ru": null
    },
    "4270724": {
      "pl": "Bolał go brzuch.",
      "ru": null
    },
    "6406052": {
      "pl": "Bolą cię nogi?",
      "ru": "У тебя ноги болят?"
    },
    "6406054": {
      "pl": "Okropnie bolała go głowa.",
      "ru": "У него ужасно болела голова."
    },
    "8631929": {
      "pl": "Bolały mnie stopy.",
      "ru": null
    },
    "8665152": {
      "pl": "Bolało, ale nie płakałem.",
      "ru": "Было больно, но я не плакал."
    },
    "10584417": {
      "pl": "Mam silny ból zęba.",
      "ru": "У меня сильно болит зуб."
    },
    "10599079": {
      "pl": "To bolało.",
      "ru": null
    },
    "11266250": {
      "pl": "Zaczął boleć mnie brzuch po zjedzeniu loda.",
