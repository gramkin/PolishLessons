    "349454": {
      "pl": "Boli mnie głowa.",
      "ru": "У меня голова болит."
    },
    "354672": {
      "pl": "Ból był straszny.",
      "ru": "Боль была ужасная."
    },
    "362366": {
      "pl": "Bolące plecy nie pozwoliły mi grać w tenisa.",
      "ru": null
    },
    "362988": {
      "pl": "Ból był nieznośny.",
      "ru": "Боль была невыносима."
    },
    "365697": {
      "pl": "Plecy mnie bolą.",
      "ru": "У меня болит спина."
    },
    "366793": {
      "pl": "Poszła do szkoły mimo bolącej nogi.",
      "ru": null
    },
    "367685": {
      "pl": "Boli cię głowa?",
