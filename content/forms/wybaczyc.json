    },
    "12069378": {
      "pl": "Tom nigdy nam nie wybaczy.",
      "ru": null
    },
    "12454557": {
      "pl": "Myślę, że Tomkowi zostanie to wybaczone.",
      "ru": null
    },
    "12689767": {
      "pl": "Proszę mu wybaczyć, on nie jest niczemu winien!",
