    },
    "5961686": {
      "pl": "Gdyby powiedział mi prawdę, wybaczyłbym mu.",
      "ru": null
    },
    "6015329": {
      "pl": "Wybacz mi, proszę.",
      "ru": "Прости меня, пожалуйста!"
    },
    "8664193": {
      "pl": "Nigdy sobie tego nie wybaczę.",
      "ru": "Никогда себе этого не прощу."
    },
    "10596208": {
      "pl": "Wybaczcie nam.",
