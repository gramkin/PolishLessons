  "tatoeba": {
    "348633": {
      "pl": "On ją kocha.",
      "ru": "Он ее любит."
    },
    "353931": {
      "pl": "To ich dom.",
      "ru": "Это их дом."
    },
    "356049": {
      "pl": "Dała mu zegarek.",
      "ru": "Она дала ему часы."
    },
    "357827": {
      "pl": "Nie wierz mu.",
      "ru": "Не верь ему."
    },
    "360445": {
      "pl": "Zadzwonię do niego później.",
      "ru": "Я ему позже позвоню."
    },
    "361206": {
      "pl": "Słyszałeś kiedyś o nim?",
      "ru": "Ты когда-нибудь слышал о нём?"
    },
    "401168": {
      "pl": "Udało mu się.",
      "ru": "Ему это удалось."
    },
    "418321": {
      "pl": "Rozumiem jego złość.",
      "ru": "Я понимаю его гнев."
    },
    "456922": {
      "pl": "Ona lubi biegać.",
      "ru": "Она любит бегать."
    },
    "522770": {
      "pl": "Usiadł koło niej.",
      "ru": "Он сел возле неё."
    },
    "524587": {
      "pl": "Nie znam nikogo z nich.",
      "ru": "Я никого из них не знаю."
    },
    "524981": {
      "pl": "Rozzłościłem go.",
      "ru": "Я разозлил его."
    },
    "526087": {
      "pl": "Zastrzelę go.",
      "ru": "Я пристрелю его."
    },
    "527538": {
      "pl": "On tyje.",
      "ru": "Он толстеет."
    },
    "532111": {
      "pl": "Znam jego imię.",
      "ru": "Я знаю его имя."
    },
    "561584": {
      "pl": "Znam go.",
      "ru": "Я знаю его."
    },
    "571139": {
      "pl": "Jemu nie można ufać.",
      "ru": "Ему нельзя доверять."
    },
    "831843": {
      "pl": "Oni są pilotami.",
      "ru": "Они пилоты."
    },
    "937888": {
      "pl": "Znam ją.",
      "ru": "Я её знаю."
    },
    "1298420": {
      "pl": "Zakochałem się w niej.",
      "ru": "Я влюбился в неё."
    },
    "1397656": {
      "pl": "Czasy się zmieniają i my zmieniamy się wraz z nimi.",
      "ru": "Времена меняются, и мы меняемся вместе с ними."
    },
    "1862057": {
      "pl": "Znasz ich?",
      "ru": "Ты их знаешь?"
    },
    "2298820": {
      "pl": "Nie patrz na nią!",
      "ru": "Не смотри на неё!"
    },
    "2979528": {
      "pl": "Pomogliśmy im.",
      "ru": "Мы помогли им."
    },
    "3420945": {
      "pl": "Kochaj ją.",
      "ru": "Люби её."
    },
    "3460226": {
      "pl": "Dał jemu książkę.",
      "ru": "Он дал ему книгу."
    },
    "3460717": {
      "pl": "Ona żyje!",
      "ru": "Она жива!"
    },
    "3607056": {
      "pl": "Zabiłem go.",
      "ru": "Я его убил."
    },
    "3660835": {
      "pl": "Nie wszyscy z nich są szczęśliwi.",
      "ru": "Не все из них счастливы."
    },
    "4719298": {
      "pl": "Szukamy jej.",
      "ru": "Мы её ищем."
    },
    "4837896": {
      "pl": "Chciała im pomóc.",
      "ru": "Она хотела им помочь."
    },
    "4916187": {
      "pl": "Oni muszą umrzeć.",
      "ru": "Они должны умереть."
    },
    "5013633": {
      "pl": "On śpi.",
      "ru": "Он спит."
    },
    "5225012": {
      "pl": "Jesteśmy z nimi w dobrych stosunkach.",
      "ru": "Мы с ними в хороших отношениях."
    },
    "5926941": {
      "pl": "Ufacie jej?",
      "ru": "Вы ей доверяете?"
    },
    "5974891": {
      "pl": "Oni piją wodę.",
      "ru": "Они пьют воду."
    },
    "6154894": {
      "pl": "Dużo razy słyszałem to słowo, ale nie wiem co ono znaczy.",
      "ru": "Я много раз слышал это слово, но не знаю, что оно значит."
    },
    "6154912": {
      "pl": "Nigdy wcześniej nie słyszałem tego słowa. Co ono oznacza?",
      "ru": "Я никогда раньше не слышал это слово. Что оно означает?"
    },
    "6155083": {
      "pl": "Daj jej to.",
      "ru": "Дай это ей."
    },
    "6313964": {
      "pl": "Ono nie jest czarne?",
      "ru": "Оно не чёрное?"
    },
    "6320832": {
      "pl": "Czy one są nowe?",
      "ru": "Они новые?"
    },
    "6534220": {
      "pl": "Połamałeś je?",
      "ru": "Ты их сломал?"
    },
    "6554178": {
      "pl": "Dostałeś jego list?",
      "ru": "Ты получил его письмо?"
    },
    "7960528": {
      "pl": "Dużo o niej mówi.",
      "ru": "Он много говорит о ней."
    },
    "8664048": {
      "pl": "Chowam się od nich.",
      "ru": "Я прячусь от них."
    },
    "8675043": {
      "pl": "Polegam na nim.",
      "ru": "Я на него полагаюсь."
    },
    "8763478": {
      "pl": "Ona tęskni za nim.",
      "ru": "Она скучает по нему."
    },
    "8764789": {
      "pl": "Im jest zimno.",
      "ru": "Им холодно."
    },
    "11319363": {
      "pl": "One mają racje.",
      "ru": "Они правы."
    },
    "12476519": {
      "pl": "On czyta.",
      "ru": "Он читает."
    },
    "12567429": {
      "pl": "Co z nią będzie?",
      "ru": "Что с ней будет?"
    },
    "12678632": {
      "pl": "Zagłosuj na nią.",
      "ru": "Проголосуй за неё."
    },
    "13373838": {
      "pl": "Zgadzam się z nimi.",
      "ru": "Я с ними согласен."
    },
    "13420903": {
      "pl": "Ona czyta.",
      "ru": "Она читает."
    },
    "13633152": {
      "pl": "Opowiedziałem jemu historię.",
      "ru": "Я рассказал ему историю."
    },
    "13655677": {
      "pl": "Co one budują?",
      "ru": "Что они строят?"
    },
    "13785998": {
      "pl": "Jak jego ręka?",
      "ru": "Как его рука?"
    },
    "13786022": {
      "pl": "Chronicie ich.",
      "ru": "Вы их защищаете."
    },
    "13786023": {
      "pl": "Chronicie je.",
      "ru": "Вы их защищаете."
    }
  }
