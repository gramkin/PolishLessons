  "tatoeba": {
    "366204": {
      "pl": "Jedni lubią czerwone wino, inni białe.",
      "ru": "Одни любят красное вино, другие белое."
    },
    "403561": {
      "pl": "Jesteśmy z nią w jednej klasie.",
      "ru": "Мы с ней в одном классе."
    },
    "527732": {
      "pl": "Nie było ani jednej żywej duszy.",
      "ru": "Там не было ни одной живой души."
    },
    "531861": {
      "pl": "Jedną chwilę",
      "ru": "Одну минуту."
    },
    "592380": {
      "pl": "Jedna jaskółka nie czyni wiosny.",
      "ru": "Одна ласточка весны не делает."
    },
    "697472": {
      "pl": "Jechałem dwa dni i jedną noc.",
      "ru": "Я ехал два дня и одну ночь."
    },
    "716803": {
      "pl": "Wszystko mi jedno.",
      "ru": "Мне всё равно."
    },
    "733096": {
      "pl": "Jedni wolą morze, inni góry.",
      "ru": "Одни предпочитают море, другие — горы."
    },
    "773289": {
      "pl": "Jedne są czerwone, inne - białe.",
      "ru": null
    },
    "931106": {
      "pl": "Brokuły to jedne z najzdrowszych warzyw.",
      "ru": null
    },
    "1168615": {
      "pl": "Jedna wdowa miała dwie córki.",
      "ru": "У одной вдовы было две дочери."
    },
    "1352082": {
      "pl": "Jest gotowy, pod jednym warunkiem, by do nas dołączyć.",
      "ru": "Он готов присоединиться к нам при одном условии."
    },
    "1801364": {
      "pl": "W naszym życiu wciąż pojawiają się wyzwania. Jedni nazywają je problemami, inni - możliwościami rozwoju.",
      "ru": "Снова и снова в нашей жизни появляются препятствия, некоторые называют их проблемами, другие говорят о возможностях для роста."
    },
    "2186412": {
      "pl": "Co dla jednych jest potrawą, dla innych jest czarną trucizną.",
      "ru": null
    },
    "2314745": {
      "pl": "Tu jest jeden stół.",
      "ru": "Здесь один стол."
    },
    "2810259": {
      "pl": "Zjadła jedno jabłko.",
      "ru": "Она съела одно яблоко."
    },
    "3761551": {
      "pl": "Był jeden świadek.",
      "ru": "Был один свидетель."
    },
    "3835977": {
      "pl": "Jedna jaskółka wiosny nie czyni.",
      "ru": "Одна ласточка весны не делает."
    },
    "4730337": {
      "pl": "Liczi to jedne z moich ulubionych owoców.",
      "ru": null
    },
    "6160520": {
      "pl": "Potrzebuję jeszcze jednej.",
      "ru": "Мне нужна ещё одна."
    },
    "6546485": {
      "pl": "Wszystko zaczęło się od jednego zdania.",
      "ru": "Всё началось с одного предложения."
    },
    "7727827": {
      "pl": "Jest o jeden mniej.",
      "ru": "Одним меньше."
    },
    "8716839": {
      "pl": "Tom jest jednym z moich pacjentów.",
      "ru": "Том - один из моих пациентов."
    },
    "11318581": {
      "pl": "Był to bardzo długi, wąski pokój o jednym oknie.",
      "ru": "Это была очень длинная, узкая комната с одним окном."
    },
    "12960430": {
      "pl": "Mam nadzieję być oddana jednemu mężczyźnie.",
      "ru": null
    },
    "13785845": {
      "pl": "Nie wysyłajcie mi więcej niż jednego.",
      "ru": "Больше одного мне не присылайте."
    },
    "13785901": {
      "pl": "Mam do ciebie jedno pytanie.",
      "ru": "У меня к тебе есть один вопрос."
    },
    "13785904": {
      "pl": "Mam do ciebie jedną prośbę.",
      "ru": "У меня к тебе есть одна просьба."
    }
  }
