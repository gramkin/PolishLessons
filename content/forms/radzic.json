    "1657591": {
      "pl": "Nie umiem sobie radzić w świecie biznesu.",
      "ru": null
    },
    "2992761": {
      "pl": "Metody używane do radzenia sobie ze stresem są różne dla mężczyzn i kobiet: picie alkoholu jest metodą używaną głównie przez mężczyzn, podczas gdy kobiety radzą sobie ze stresem poprzez czatowanie.",
      "ru": null
    },
    "3764791": {
      "pl": "Nigdy ci nie radziłem tego robić.",
      "ru": null
    },
    "4869508": {
      "pl": "Radziła mu, żeby poszedł do dentysty.",
      "ru": null
    },
    "6155001": {
      "pl": "- Nie lubisz Tom'a? - To nie tak, że go nie lubię, mam tylko problem z radzeniem sobie z ludźmi takimi jak on.",
