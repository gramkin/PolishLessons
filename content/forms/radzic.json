    },
    "361723": {
      "pl": "Żałuję, że nie postąpiłem jak radził.",
      "ru": null
    },
    "365099": {
      "pl": "Ona we wszystkim radzi się rodziców.",
      "ru": null
    },
    "366536": {
      "pl": "Jak mi pan radzi, co mam powiedzieć?",
      "ru": null
    },
    "418273": {
      "pl": "Jako przedsiębiorca radzi sobie znakomicie.",
      "ru": null
    },
    "593086": {
      "pl": "Był dobry z każdego przedmiotu ale najlepiej radził sobie z matematyką.",
