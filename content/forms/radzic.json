    },
    "750557": {
      "pl": "Jak sobie radzisz bez pracy?",
      "ru": null
    },
    "838940": {
      "pl": "Nowy kelner powinien sobie lepiej radzić.",
      "ru": null
    },
    "897640": {
      "pl": "Radzę Ci wrócić do domu.",
      "ru": null
    },
    "907996": {
      "pl": "Radziłbym jechać za granicę, póki jest pan młody.",
      "ru": null
