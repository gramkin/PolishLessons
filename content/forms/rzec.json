  "tatoeba": {
    "350107": {
      "pl": "„Wygląda całkiem ciekawie” – rzekł Hiroshi.",
      "ru": null
    },
    "362396": {
      "pl": "Był dobrze zbudowany, by nie rzec gruby.",
      "ru": null
    },
    "440509": {
      "pl": "Odchrząknął i rzekł: „Uwielbiam Tatoeba!”.",
      "ru": null
    },
    "722415": {
      "pl": "Był dobrze zbudowany, by nie rzec tęgi.",
      "ru": null
    },
    "1351871": {
      "pl": "Kobieta ostrożnie przeliczyła pieniądze, a następnie rzekła: - Wciąż brakuje 0.99.",
      "ru": null
    },
    "3643195": {
      "pl": "Cóż możemy rzec?",
      "ru": null
    },
    "8202134": {
      "pl": "– Ot, tak – rzekła, powstając z klęczek i twarz zaru­mienioną od rozdmuchiwania płomienia zwracając ku nie­ruchomej kobiecie – rozpaliłam ogień i zaraz tu będzie pani cieplej i widniej.",
      "ru": null
    },
    "8287810": {
      "pl": "Lekarz rzekł, żeby odpoczęła.",
      "ru": null
    },
    "12692396": {
      "pl": "\"Wiem, czego pragniesz,\" rzekła morska wiedźma. \"To bardzo niemądre z twojej strony, jednakże dostaniesz, czego chcesz, mimo, że sprowadzi to na ciebie smutek, nadobna księżniczko. Chcesz pozbyć się swojego rybiego ogona i mieć dwie nogi, tak jak ludzie na stałym lądzie, żeby młody książę zakochał się w tobie, i żeby uczynić swoją duszę nieśmiertelną.\"",
      "ru": null
    }
  }
}
