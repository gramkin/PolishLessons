    "348785": {
      "pl": "To zdjęcie zrobiono w Narze.",
      "ru": null
    },
    "348937": {
      "pl": "Zrób kawy.",
      "ru": "Сделай кофе."
    },
    "351343": {
      "pl": "Zrobiłem to niechcący.",
      "ru": "Я сделал это нечаянно."
    },
    "351904": {
      "pl": "Nie zostawiaj rzeczy zrobionych w połowie.",
      "ru": null
    },
    "367073": {
      "pl": "Na twoim miejscu zrobiłbym to samo w tak trudnej sytuacji.",
      "ru": "На твоём месте в такой трудной ситуации я сделал бы то же самое."
    },
    "395319": {
      "pl": "Kable elektryczne są zrobione z miedzi.",
