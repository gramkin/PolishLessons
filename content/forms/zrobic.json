    },
    "5927606": {
      "pl": "Moja robota jest zrobiona.",
      "ru": null
    },
    "6109672": {
      "pl": "Już to zrobiłam.",
      "ru": "Я это уже сделала."
    },
    "6308665": {
      "pl": "Niech on to zrobi.",
