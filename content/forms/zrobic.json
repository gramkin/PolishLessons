    "2108478": {
      "pl": "Co zrobiła dzisiaj?",
      "ru": "Что она сегодня сделала?"
    },
    "2151405": {
      "pl": "Ten ser jest zrobiony z owczego mleka.",
      "ru": "Этот сыр изготовлен из овечьего молока."
    },
    "3093099": {
      "pl": "Zróbmy coś innego.",
      "ru": "Давай сделаем что-нибудь другое."
    },
    "3107124": {
      "pl": "Zrobienie tego nie przynosi korzyści.",
      "ru": null
    },
    "3446241": {
      "pl": "W lesie znów zrobiło się cicho.",
      "ru": "В лесу снова стало тихо."
    },
    "3741266": {
      "pl": "Dżentelmen nie zrobiłby czegoś takiego.",
      "ru": null
    },
    "3746042": {
      "pl": "Zrobią to.",
      "ru": null
    },
    "3851405": {
      "pl": "Próbuję cię powstrzymać przed zrobieniem dużego błędu.",
      "ru": null
    },
    "3960505": {
      "pl": "Nie zrobiliśmy nic.",
      "ru": "Мы ничего не сделали."
    },
    "4124211": {
      "pl": "Co zrobili?",
      "ru": "Что они сделали?"
    },
