  "tatoeba": {
    "351350": {
      "pl": "On nosi okulary.",
      "ru": "Он носит очки."
    },
    "351914": {
      "pl": "Nie noszę już okularów.",
      "ru": "Я больше не ношу очки."
    },
    "453569": {
      "pl": "Noszę garnitur, ale nie noszę krawata.",
      "ru": "Я ношу костюм, но не ношу галстук."
    },
    "571141": {
      "pl": "Nosiła włosy splecione w warkocze.",
      "ru": "Она носила волосы, заплетённые в косы."
    },
    "600782": {
      "pl": "Regulamin szkoły nakazuje uczniom noszenie fartuszków.",
      "ru": null
    },
    "669644": {
      "pl": "Jaki rozmiar nosisz?",
