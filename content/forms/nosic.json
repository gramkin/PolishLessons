    },
    "827728": {
      "pl": "Zimą noś ciepłe ubrania.",
      "ru": null
    },
    "927278": {
      "pl": "Chłopak koniecznie upierał się przy noszeniu długich włosów.",
      "ru": null
    },
    "956708": {
      "pl": "Anglia to kraj, w którym policjanci nie noszą broni.",
      "ru": "Англия - это страна, в которой полицейские не носят бронежилеты."
    },
    "956940": {
      "pl": "Czy będą przyjemne w noszeniu?",
      "ru": null
    },
    "960944": {
      "pl": "Noszenie w kieszeni małej latarki może się przydać.",
      "ru": null
    },
    "1359987": {
      "pl": "To pudełko jest za cieżkie do noszenia.",
      "ru": null
    },
    "1366409": {
      "pl": "Najbezpieczniej jest nosić szelki.",
      "ru": null
    },
    "1366411": {
      "pl": "Spodnie nosili Germanowie i Celtowie, Rzymianie nie.",
      "ru": null
    },
    "2827320": {
      "pl": "Nie noś drewna w lesie.",
      "ru": null
    },
    "3051507": {
      "pl": "Czemu nosisz rękawiczki?",
      "ru": null
    },
    "3990242": {
      "pl": "Wszyscy noszą identyfikatory.",
      "ru": null
    },
    "5190302": {
      "pl": "W dalszym ciągu nie jestem przyzwyczajony do noszenia kasku.",
      "ru": null
    },
    "5652046": {
      "pl": "Nosił to Tom.",
      "ru": null
    },
    "6549733": {
      "pl": "Próbuję znaleźć tę czarną spódnicę, którą nosiłam w zeszłym tygodniu.",
      "ru": null
    },
    "7184850": {
      "pl": "Lubisz nosić garnitury?",
      "ru": null
    },
    "7185024": {
      "pl": "Nosiła czarny kapelusz.",
      "ru": "Она носила чёрную шляпу."
    },
    "7868823": {
      "pl": "Noszą drogie pierścionki.",
      "ru": null
    },
    "7969903": {
      "pl": "On nosi wełniany sweter.",
      "ru": "Он носит шерстяной свитер."
    },
    "8734607": {
      "pl": "Nie będę tego nosić.",
