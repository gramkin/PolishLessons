  "tatoeba": {
    "353197": {
      "pl": "Przez pomyłkę wziąłem twój parasol.",
      "ru": "Я по ошибке взял твой зонт."
    },
    "367184": {
      "pl": "Zostali wzięci do niewoli.",
      "ru": null
    },
    "442864": {
      "pl": "Wzięła na siebie zbyt wiele pracy.",
      "ru": "Она взяла на себя слишком много работы."
    },
    "497375": {
      "pl": "Dobrze, wezmę je. Kiedy zaczyna się spektakl?",
      "ru": "Хорошо, я возьму их. Когда начинается спектакль?"
    },
    "560182": {
      "pl": "Wezmę tę parasolkę.",
      "ru": "Я возьму этот зонтик."
    },
    "608571": {
      "pl": "Wziął książkę z regału.",
      "ru": "Он взял книгу с полки."
    },
    "611568": {
      "pl": "Wziąłem prysznic.",
      "ru": "Я принял душ."
    },
    "643811": {
      "pl": "Jego opinia nie została wzięta pod uwagę.",
      "ru": null
    },
    "737232": {
      "pl": "Moją uprzejmość wzięli za przyjaźń.",
      "ru": "Они приняли мою вежливость за дружбу."
    },
    "751795": {
      "pl": "Wzięła z półki książkę na chybił trafił.",
      "ru": "Она взяла с полки случайную книгу."
    },
    "758401": {
      "pl": "Weźmiemy udział w maratonie.",
      "ru": "Мы будем участвовать в марафоне."
    },
    "888195": {
      "pl": "Weźmy taksówkę.",
      "ru": "Давай возьмём такси."
    },
    "951320": {
      "pl": "Za Chiny nie wziąłbym tej roboty.",
      "ru": null
    },
    "960912": {
      "pl": "Te ceny są z księżyca wzięte!",
      "ru": null
    },
    "983039": {
      "pl": "Po wzięciu tego lekarstwa ból brzucha znacznie zelżeje.",
      "ru": null
    },
    "989407": {
      "pl": "Poszedłeś na plażę i nie wziąłeś ręcznika?",
      "ru": "Ты пошёл на пляж и не взял полотенце?"
    },
    "999237": {
      "pl": "Nie wiedział, skąd się to wzięło.",
      "ru": null
    },
    "1192975": {
      "pl": "Weź co chcesz.",
      "ru": "Бери что хочешь."
    },
    "1354277": {
      "pl": "Od takiego drania nie wziąłbym nawet kiełbasy.",
      "ru": "От такого гада мне даже колбасы не надо."
    },
    "1782522": {
      "pl": "Oskarżyli mnie o wzięcie pieniędzy.",
      "ru": null
    },
    "2226158": {
      "pl": "Ja to wezmę.",
      "ru": "Я возьму это."
    },
    "2250148": {
      "pl": "Wzięłyśmy taksówkę, żeby być tam na czas.",
      "ru": null
    },
    "3423249": {
      "pl": "Weźmiemy to pod uwagę.",
      "ru": null
    },
    "3510120": {
      "pl": "Tom chciał wziąć prysznic.",
      "ru": "Том хотел принять душ."
    },
    "3679915": {
      "pl": "Maria i Tom wzięli ślub w kościele niedaleko stąd.",
      "ru": "Мэри и Том поженились в церкви недалеко отсюда."
    },
    "3749525": {
      "pl": "Weźmiesz to?",
      "ru": null
    },
    "4010165": {
      "pl": "Nadal nie mogę uwierzyć, że wzięliście z Tomem ślub.",
      "ru": null
    },
    "4124187": {
      "pl": "Nie wzięliśmy ślubu.",
      "ru": null
    },
    "4124214": {
      "pl": "Co wzięli?",
      "ru": null
    },
    "4516511": {
      "pl": "Wziąłbyś udział w projekcie?",
      "ru": null
    },
    "5714922": {
      "pl": "Tom wziął zimną kąpiel.",
      "ru": "Том принял холодную ванну."
    },
    "5969996": {
      "pl": "Weź to ze sobą.",
      "ru": "Возьми это с собой."
    },
    "6373367": {
      "pl": "Weź inne krzesło!",
      "ru": "Возьми другой стул!"
    },
    "8667380": {
      "pl": "Do wzięcia?",
      "ru": null
    },
    "8745397": {
      "pl": "Weźcie.",
      "ru": null
    },
    "8749678": {
      "pl": "Kto weźmie udział?",
      "ru": null
    },
    "8948454": {
      "pl": "Trzeba wziąć pod uwagę wiele czynników.",
      "ru": "Необходимо учесть многие факторы."
    },
    "9679198": {
      "pl": "Wziąłeś to?",
      "ru": null
    },
    "9679199": {
      "pl": "Wzięłaś to?",
      "ru": null
    },
    "9679206": {
      "pl": "Wzięłam pieniądze.",
      "ru": null
    },
    "10565709": {
      "pl": "Wziąłem to.",
      "ru": null
    },
    "10590047": {
      "pl": "Weźmy rozwód.",
      "ru": null
    },
    "10606321": {
      "pl": "Wzięły ślub.",
      "ru": null
    },
    "12069327": {
      "pl": "„Kiedy wezmą ślub?“ „Nigdy.“",
      "ru": null
    },
    "13067843": {
      "pl": "Wzięła ślub.",
      "ru": null
    },
    "13785996": {
      "pl": "Wziął mnie za mojego brata.",
      "ru": "Он принял меня за моего брата."
    },
    "13786181": {
      "pl": "Chcesz wziąć ze mną prysznic?",
