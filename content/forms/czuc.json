  "tatoeba": {
    "349470": {
      "pl": "Nie mam czucia w palcach.",
      "ru": null
    },
    "352290": {
      "pl": "Mów, co czułeś.",
      "ru": null
    },
    "365728": {
      "pl": "Czuję się już lepiej.",
      "ru": "Мне уже лучше."
    },
    "366539": {
      "pl": "Czuliśmy, jak dom drży.",
      "ru": null
    },
    "441232": {
      "pl": "Czuł się tak nieszczęśliwy, że przeklinał dzień, w którym przyszedł na świat.",
      "ru": "Он чувствовал себя таким несчастным, что проклинал день, в который появился на свет."
    },
    "493161": {
      "pl": "Czuła, jak serce jej wali.",
      "ru": null
    },
    "597663": {
      "pl": "Dziś czuję się dobrze.",
      "ru": "Сегодня я хорошо себя чувствую."
    },
    "710404": {
      "pl": "Tu czuć zgnilizną.",
      "ru": null
    },
    "970259": {
      "pl": "Chciałbym czuć się ważny.",
      "ru": "Я хотел бы чувствовать себя важным."
    },
    "1109960": {
      "pl": "Jak się czujesz?",
      "ru": "Как ты себя чувствуешь?"
    },
    "1772604": {
      "pl": "Marnie się czuję.",
      "ru": "Я плохо себя чувствую."
    },
    "2146115": {
      "pl": "Czułem, że powinienem jej pomóc.",
      "ru": "Я чувствовал, что должен ей помочь."
    },
    "2218982": {
      "pl": "Tom czuł się winny.",
      "ru": null
    },
    "2765418": {
      "pl": "Czułam się jak idiotka.",
      "ru": "Я чувствовала себя идиоткой."
    },
    "3366034": {
      "pl": "Czuję zapach benzyny.",
      "ru": "Я чувствую запах бензина."
    },
    "3460682": {
      "pl": "Czy dobrze się czujesz?",
      "ru": "Ты хорошо себя чувствуешь?"
    },
    "3686374": {
      "pl": "W siodle czuje się pewnie.",
      "ru": "В седле он чувствует себя уверенно."
    },
    "3745085": {
      "pl": "Czuje się jak eksponat w muzeum.",
      "ru": "Я чувствую себя экспонатом в музее."
    },
    "4717708": {
      "pl": "Czujesz jakiś dziwny zapach?",
      "ru": "Чувствуешь какой-то странный запах?"
    },
    "4953244": {
      "pl": "Czujemy się świetnie.",
      "ru": null
    },
    "5014773": {
      "pl": "Czułam się zagubiona bez niego.",
      "ru": "Я чувствовала себя потерянной без него."
    },
    "6313204": {
      "pl": "Jak byście się czuli, gdyby was zostawiła żona?",
      "ru": "Как бы Вы чувствовали себя, если бы Ваша жена ушла от Вас?"
    },
