    },
    "3739648": {
      "pl": "Zwykle mu się udawało.",
      "ru": null
    },
    "3743711": {
      "pl": "Udawajmy, że jesteśmy ninja.",
      "ru": "Давай притворимся, что мы ниндзя."
    },
    "3799113": {
      "pl": "W ostatnich latach nastolatkowie udający otyłych amerykańskich raperów chodzą jak odwrócone wahadła, bujając się z lewa na prawo, co jest jedynym sposobem, aby poruszać się naprzód, kiedy waży się ponad 120 kilogramów, ale zupełnie nieefektywnym, kiedy jest się wątłym małolatem ważącym połowę z tego, ponieważ większość energii jest marnowana na kroki w bok – nie wspominając już o samej absurdalności takiego kołyszącego chodu.",
      "ru": null
    },
    "3853618": {
      "pl": "Uczniowie udawali, że nie słyszą nauczyciela.",
      "ru": null
    },
    "3898910": {
      "pl": "Udawaj mnie.",
      "ru": null
    },
    "4156211": {
      "pl": "Dowiedział się, że udawała że jest w ciąży.",
      "ru": null
    },
    "4544369": {
      "pl": "Nie udawałem twojego przyjaciela.",
      "ru": null
    },
    "5097495": {
      "pl": "Udawajmy, że jesteśmy parą.",
      "ru": null
    },
    "5468515": {
      "pl": "Studenci udają, że studiują, wykładowcy udają, że pracują, a państwo udaje, że za to płaci.",
