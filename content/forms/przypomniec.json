  "tatoeba": {
    "393064": {
      "pl": "Dziękuję za przypomnienie o spotkaniu, na którym muszę być.",
      "ru": null
    },
    "539843": {
      "pl": "Przypomniał mi, abym nie zapomniał mojego paszportu.",
      "ru": null
    },
    "669674": {
      "pl": "Nie mogę sobie przypomnieć.",
      "ru": null
    },
    "728580": {
      "pl": "Dopiero później przypomniałem sobie jego nazwisko.",
      "ru": null
    },
    "737289": {
      "pl": "Kiedy usłyszałem, co opowiada, przypomniały mi się stare, dobre czasy.",
      "ru": null
    },
    "739151": {
      "pl": "Kiedy go usłyszałem, przypomniała mi się młodość.",
      "ru": null
    },
    "751620": {
      "pl": "Nagle przypomniałem sobie, że zostawiłem portfel w domu.",
      "ru": null
    },
    "758426": {
      "pl": "Jej słowa przypomniały mi szczęśliwe dzieciństwo.",
      "ru": null
    },
    "827348": {
      "pl": "O, przypomniałem sobie.",
      "ru": null
    },
    "832623": {
      "pl": "Jej historia przypomniała mi moich rodziców.",
      "ru": null
    },
    "940915": {
      "pl": "Przypomnij mi, bym jutro napisał list.",
      "ru": null
    },
    "956863": {
      "pl": "To zdjęcie przypomniało mi Szkocję.",
      "ru": null
    },
    "999229": {
      "pl": "Przypomnij mi, że mam jutro iść do lekarza.",
      "ru": null
    },
    "2031507": {
      "pl": "Właśnie staram się sobie przypomnieć.",
      "ru": null
    },
    "3019532": {
      "pl": "Przypomnij mi, proszę, o napisaniu listu.",
      "ru": null
    },
    "3706679": {
      "pl": "To jest przypomnienie o zaległej zapłacie.",
      "ru": null
    },
    "3785920": {
      "pl": "Tom poprosił Mary o przypomnienie, żeby zadzwonił rano do Johna.",
      "ru": null
    },
    "5508776": {
      "pl": "Przypomniałam sobie.",
      "ru": null
    },
    "6109715": {
      "pl": "Muszę to sobie przypomnieć.",
      "ru": null
    },
    "8809827": {
      "pl": "Tom przypomniał Mary, żeby to robiła.",
      "ru": null
    },
    "10799426": {
      "pl": "Przypomniał jej o jej ojcu.",
      "ru": null
    },
    "11527891": {
      "pl": "Nagle, z jakiegoś powodu, przypomniały mi się czasy mojej młodości.",
      "ru": null
    },
    "11573484": {
      "pl": "Ta historia przypomniała mi o moim ojcu.",
      "ru": null
    },
    "13352332": {
      "pl": "Przypomnę ci.",
      "ru": null
    },
    "13783069": {
      "pl": "Przypomnisz mi, żebym wysłał te listy?",
      "ru": "Ты напомнишь мне, чтобы я отправил эти письма?"
