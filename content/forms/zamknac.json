  "tatoeba": {
    "352401": {
      "pl": "Siedział z zamkniętymi oczami.",
      "ru": null
    },
    "364636": {
      "pl": "Drzwi zamknięto od zewnątrz.",
      "ru": null
    },
    "410055": {
      "pl": "Bardzo proszę zamknąć drzwi.",
      "ru": "Закрой дверь, пожалуйста."
    },
    "457421": {
      "pl": "Autostrada była zamknięta z powodu poważnego wypadku.",
