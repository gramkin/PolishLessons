  "tatoeba": {
    "352683": {
      "pl": "Warto odwiedzić Kioto.",
      "ru": null
    },
    "362907": {
      "pl": "Odwiedziła męża w więzieniu.",
      "ru": null
    },
    "367663": {
      "pl": "Odwiedziliśmy go wczoraj wieczorem.",
      "ru": null
    },
    "367821": {
      "pl": "Wiosna to najlepsza pora na odwiedzenie Kioto.",
      "ru": null
    },
    "565982": {
      "pl": "Odwiedzę cię jutro.",
      "ru": null
    },
    "569889": {
      "pl": "Odwiedzę go jutro.",
      "ru": null
    },
    "575610": {
      "pl": "Wczoraj odwiedził swojego wujka.",
      "ru": null
    },
    "585856": {
      "pl": "Przyjaciel mnie jutro odwiedzi.",
      "ru": null
    },
    "590785": {
      "pl": "On odwiedził Francję trzy razy.",
      "ru": null
    },
    "591632": {
      "pl": "Odwiedziłem dom mojej babci.",
      "ru": null
    },
    "623354": {
      "pl": "Odwiedźmy go na chwilę w jego domu.",
      "ru": null
    },
    "683802": {
      "pl": "W następną niedzielę odwiedzimy naszą ciotkę.",
      "ru": null
    },
    "770335": {
      "pl": "Gdyby tu był, odwiedziłby nas.",
      "ru": null
    },
    "793599": {
      "pl": "Mam wielką nadzieję, że wkrótce pan nas odwiedzi.",
      "ru": null
    },
    "817203": {
      "pl": "Odwiedziłem grób ojca.",
      "ru": null
    },
    "889229": {
      "pl": "On też odwiedziłby Chiny.",
      "ru": null
    },
    "952251": {
      "pl": "Mamy w Tokio wielu przyjaciół do odwiedzenia.",
      "ru": null
    },
    "964999": {
      "pl": "Nie umiem opisać, jak jestem szczęśliwy, że nas odwiedziłeś.",
      "ru": null
    },
    "969029": {
      "pl": "Odwiedźmy ją w szpitalu.",
      "ru": null
    },
    "982590": {
      "pl": "Czy to prawda, że odwiedziłeś ją tego wieczoru?",
      "ru": null
    },
    "983455": {
      "pl": "Wkrótce cię odwiedzę.",
      "ru": null
    },
    "997674": {
      "pl": "Gdybym wiedział, że jesteś chory, odwiedziłbym cię w szpitalu.",
      "ru": null
    },
    "1100601": {
      "pl": "Prezydent Francji odwiedzi Japonię w przyszłym miesiącu.",
      "ru": "Президент Франции посетит Японию в следующем месяце."
    },
    "1567485": {
      "pl": "Odwiedziła go w Bostonie.",
      "ru": null
    },
    "1644059": {
      "pl": "Gdybym miał czas, z przyjemnością odwiedziłbym cię.",
      "ru": null
    },
    "1782499": {
      "pl": "Wczoraj odwiedzili swoich rodziców.",
      "ru": null
    },
    "1896058": {
      "pl": "Odwiedzicie inne kraje?",
      "ru": null
    },
    "2146145": {
      "pl": "Przyszedł mnie odwiedzić.",
      "ru": "Он пришёл меня навестить."
    },
    "2289963": {
      "pl": "Odwiedziliśmy kilka miejsc.",
      "ru": null
    },
    "2403016": {
      "pl": "Kiedy odwiedziłeś przyjaciół?",
      "ru": null
    },
    "2983816": {
      "pl": "Tomowi udało się znaleźć czas na odwiedzenie Mary podczas jego pobytu w Bostonie.",
      "ru": null
    },
    "3552907": {
      "pl": "Niedługo ich odwiedzimy.",
      "ru": null
    },
    "3621896": {
      "pl": "Odwiedź mnie jeszcze raz!",
      "ru": null
    },
    "3871996": {
      "pl": "To muzeum jest warte odwiedzenia.",
      "ru": null
    },
    "5229192": {
      "pl": "Maria odwiedziła Węgry.",
      "ru": null
    },
    "6535901": {
      "pl": "Rzym jest miastem wartym odwiedzenia.",
      "ru": null
    },
    "6553818": {
      "pl": "Odwiedzę Toma.",
      "ru": null
    },
    "6882270": {
      "pl": "Odwiedzimy Cię jutro.",
      "ru": null
    },
    "7868954": {
      "pl": "Odwiedź nas wkrótce.",
      "ru": null
    },
    "8675038": {
      "pl": "Odwiedziłem go.",
      "ru": "Я его навестил."
    },
    "8730331": {
      "pl": "Odwiedźmy Toma!",
      "ru": null
    },
    "8732633": {
      "pl": "Odwiedzili nas.",
      "ru": null
    },
    "10544231": {
      "pl": "Dlaczego nas nie odwiedzisz?",
      "ru": null
    },
    "10596249": {
      "pl": "Odwiedź nas.",
      "ru": null
    },
    "11492231": {
      "pl": "Turyści odwiedzili dom słynnego malarza.",
      "ru": null
    },
    "11608394": {
      "pl": "Po południu odwiedziłam ją w szpitalu, ale zapomniałam o kwiatach.",
      "ru": null
    },
    "12068986": {
      "pl": "Tom nie odwiedził Mary.",
      "ru": null
    },
    "12453958": {
      "pl": "Podczas podróży po Europie odwiedziliśmy wiele pięknych miast i zabytków.",
