    },
    "989455": {
      "pl": "Pan nie wie, co to znaczy stanąć twarzą w twarz ze śmiercią.",
      "ru": null
    },
    "991170": {
      "pl": "Stanąłem na końcu kolejki.",
      "ru": null
    },
    "2279153": {
      "pl": "Doszli do dzielnicy bogaczy i stanęli przed ładną willą.",
      "ru": null
    },
    "3034164": {
      "pl": "Stanęła przed nim i zażądała przeprosin.",
      "ru": null
    },
    "3495344": {
      "pl": "Stań tam.",
      "ru": null
    },
    "5652537": {
      "pl": "Stań z boku!",
      "ru": null
    },
    "6547712": {
      "pl": "Włosy stanęły mu dęba.",
      "ru": null
    },
    "10695782": {
      "pl": "Stań w kolejce.",
      "ru": "Встаньте в очередь."
    },
    "10776822": {
      "pl": "Szyja mi chrupnęła, gdy stanęłam na głowie.",
