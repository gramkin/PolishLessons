    "352175": {
      "pl": "Silnik stanął.",
      "ru": null
    },
    "356402": {
      "pl": "Stanąłem po jego stronie w dyskusji.",
      "ru": null
    },
    "366774": {
      "pl": "Zobaczyła tak straszny wypadek, że włosy stanęły jej dęba.",
