      "pl": "Samochód stanął unieruchomiony.",
      "ru": null
    },
    "528971": {
      "pl": "Może pan tam stanąć?",
      "ru": null
    },
    "728640": {
      "pl": "Stanęliśmy wobec trudnej sytuacji.",
