  "tatoeba": {
    "383644": {
      "pl": "Wszystko jest do góry nogami.",
      "ru": "Всё вверх ногами."
    },
    "812516": {
      "pl": "Ma piłkę na nodze.",
      "ru": null
    },
    "1591860": {
      "pl": "Motyla noga.",
      "ru": null
    },
    "1605844": {
      "pl": "Boli mnie noga.",
      "ru": "У меня болит нога."
    },
    "3078146": {
      "pl": "Wstałem dziś lewą nogą.",
      "ru": "Я не с той ноги с утра встал."
    },
    "3610598": {
      "pl": "Tom wyglądał jakby był na nogach całą noc.",
      "ru": "Том выглядел так, будто всю ночь провёл на ногах."
    },
    "3745979": {
      "pl": "Czy masz buty na nogach?",
      "ru": null
    },
    "5377648": {
      "pl": "Patrz pod nogi.",
      "ru": "Смотри под ноги."
    },
    "6406052": {
      "pl": "Bolą cię nogi?",
      "ru": "У тебя ноги болят?"
    },
    "6541897": {
      "pl": "Dał nogę.",
      "ru": null
    },
    "6689537": {
      "pl": "Tom ma dwie nogi.",
      "ru": "У Тома две ноги."
    },
    "8608273": {
      "pl": "Padam z nóg!",
      "ru": null
    },
    "11573526": {
      "pl": "Poruszyłem nogami.",
      "ru": null
    },
    "12470138": {
      "pl": "Dosłownie padam z nóg ze zmęczenia.",
      "ru": "Я буквально валился с ног от усталости."
    },
    "12698365": {
      "pl": "Owady mają sześć nóg.",
      "ru": "У насекомых шесть ног."
    },
    "13204811": {
      "pl": "Trzymasz książkę do góry nogami.",
      "ru": "Ты держишь книгу вверх ногами."
