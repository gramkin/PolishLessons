    "547704": {
      "pl": "Śledź go.",
      "ru": null
    },
    "840195": {
      "pl": "Policja śledziła ją aż do Paryża.",
      "ru": null
    },
    "841701": {
      "pl": "Śledzenie gangu było niebezpieczną przygodą.",
      "ru": null
    },
    "901436": {
      "pl": "A więc to tak, śledzisz Hanako! Ostatnio byłeś taki cichy, że nie uważałam na ciebie.",
      "ru": null
    },
    "919650": {
      "pl": "Zatrudniła prywatnego detektywa, żeby śledzić męża.",
      "ru": null
    },
    "1165923": {
      "pl": "Wiem, że on mnie śledzi.",
      "ru": null
    },
    "1351383": {
      "pl": "Śledzenie amerykańskiej polityki jest ciekawe, zwłaszcza podczas wyborów prezydenckich.",
      "ru": null
    },
    "2606968": {
      "pl": "Policjant śledził go.",
      "ru": null
    },
    "3501200": {
      "pl": "Przestań śledzić Toma.",
      "ru": null
    },
    "3637543": {
      "pl": "Śledziłeś mnie?",
      "ru": null
    },
    "3637545": {
      "pl": "Śledziłaś mnie?",
      "ru": null
    },
    "3782947": {
      "pl": "Tom poprosił mnie, żebym śledził Mary.",
      "ru": null
    },
    "3853634": {
      "pl": "Policja mnie śledzi.",
      "ru": null
    },
    "4802004": {
      "pl": "Ktoś nas chyba śledzi.",
      "ru": null
    },
    "4828116": {
      "pl": "Śledzę każdy ich ruch.",
      "ru": null
    },
    "5636912": {
      "pl": "Śledź Toma.",
      "ru": null
    },
    "11254082": {
      "pl": "Zenek zaczął uważnie śledzić przebieg akcji.",
      "ru": null
    },
    "12040341": {
      "pl": "Śledzisz mnie?",
