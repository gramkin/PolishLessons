  "tatoeba": {
    "674717": {
      "pl": "Ze względu na swoje szaleństwo, mężczyzna został uniewinniony.",
      "ru": null
    },
    "975975": {
      "pl": "To szaleństwo.",
      "ru": null
    },
    "1633110": {
      "pl": "Ona doprowadza mnie do szaleństwa.",
      "ru": null
    },
    "3376513": {
      "pl": "Byłoby szaleństwem wspinać się na tą górę zimą.",
      "ru": null
    },
    "3497068": {
      "pl": "To było szaleństwo.",
      "ru": null
    },
    "5608444": {
      "pl": "Ich szaleństwom nie było końca.",
      "ru": null
    },
    "5608466": {
      "pl": "Nie poddawaj się zbytnio szaleństwu, jutro jest twój ślub!",
      "ru": null
    },
    "5608475": {
      "pl": "W tym szaleństwie jest metoda.",
      "ru": null
    },
    "5959901": {
      "pl": "Moja córka gustuje w różnych szaleństwach.",
      "ru": null
    },
    "6155674": {
      "pl": "Skończcie już z tymi szaleństwami!",
      "ru": null
    },
    "6155675": {
      "pl": "W wakacje poza szaleństwami na dworze, czasem trzeba zostać w budynku i przeczekać ulewę.",
      "ru": null
    },
    "6155676": {
      "pl": "Za niektóre błędy płaci się do końca życia, więc lepiej z młodzieńczymi szaleństwami nie przesadzać.",
      "ru": null
    },
    "6155716": {
      "pl": "Mimo sylwestrowych szaleństw, to nie była zbyt pracowita noc w Izbie Wytrzeźwień.",
      "ru": null
    },
    "6155924": {
      "pl": "Jego odwaga graniczyła z szaleństwem.",
      "ru": "Его отвага граничила с безумием."
    },
    "6155927": {
      "pl": "Szaleństwom nie było końca.",
      "ru": "Безумствам не было конца."
    },
    "6155929": {
      "pl": "Daj się ponieść zimowym szaleństwom.",
      "ru": null
    },
    "6156024": {
      "pl": "Dzisiejszy dzień był czystym szaleństwem!",
      "ru": "Сегодняшний день был чистым безумием!"
    },
    "6156290": {
      "pl": "Anka, ty myślisz tylko o szaleństwach.",
      "ru": null
    },
    "6160032": {
      "pl": "Dość już tych szaleństw!",
      "ru": null
    },
    "6160999": {
      "pl": "Nie ulegaj temu szaleństwu.",
      "ru": null
    },
    "6406121": {
      "pl": "Wszyscy ulegli jakiemuś zbiorowemu szaleństwu.",
      "ru": null
    },
    "7053619": {
      "pl": "To było czystym szaleństwem.",
      "ru": null
    },
    "8664477": {
      "pl": "Brat prawie doprowadził mnie do szaleństwa.",
      "ru": "Брат чуть с ума меня не свёл."
    },
    "12201672": {
      "pl": "Szaleństwo!",
      "ru": null
    },
    "12227358": {
      "pl": "Lubię twoje szaleństwa.",
      "ru": null
    },
    "12470047": {
      "pl": "Mam dosyć twoich szaleństw.",
      "ru": null
    },
    "12960008": {
      "pl": "On doprowadza nauczyciela do szaleństwa.",
      "ru": null
    },
    "13006206": {
      "pl": "Zatopić się w szaleństwie jak w bagnie.",
      "ru": null
    },
    "13067881": {
      "pl": "Cała rodzina wiedziała o jej szaleństwach.",
      "ru": null
    },
    "13081660": {
      "pl": "Nie widzę nic dobrego w jego szaleństwie.",
      "ru": null
    }
