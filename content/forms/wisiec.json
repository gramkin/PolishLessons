    "1359961": {
      "pl": "Na ścianie wisiał portret starego mężczyzny.",
      "ru": null
    },
    "1550617": {
      "pl": "Drugie lustro wisi obok drzwi.",
      "ru": "Второе зеркало висит рядом с дверью."
    },
