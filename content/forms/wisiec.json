    "683328": {
      "pl": "Nad dwoma dużymi oknami wiszą jedwabne zasłony.",
      "ru": null
    },
    "716759": {
      "pl": "Obraz wisi nad stołem.",
      "ru": null
    },
    "1350342": {
      "pl": "Ciemnobrązowy kapelusz wisiał na płocie.",
      "ru": null
