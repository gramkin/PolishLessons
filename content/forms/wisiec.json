    },
    "6300535": {
      "pl": "Dłuższą chwilę patrzyłam na obraz wiszący na ścianie.",
      "ru": null
    },
    "6360065": {
      "pl": "Wiszę jej dziesięć dolarów.",
      "ru": null
    },
    "11259785": {
      "pl": "Jego rysunki wisiały na ścianie.",
      "ru": null
    },
    "11570720": {
      "pl": "Tam stał czarny stół i krzesła, a tu wisiał na ścianie zegar.",
