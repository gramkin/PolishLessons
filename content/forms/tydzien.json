  "tatoeba": {
    "351505": {
      "pl": "Przestraszyłbyś się, gdybym ci opowiedział, co mi się śniło kilka tygodni temu.",
      "ru": "Если бы я хотел напугать тебя, я бы рассказал тебе, что мне снилось несколько недель назад."
    },
    "356536": {
      "pl": "Niedziela to ostatni dzień tygodnia.",
      "ru": "Воскресенье - последний день недели."
    },
    "363123": {
      "pl": "Planujemy zostać tam tydzień.",
      "ru": "Мы планируем остаться на неделю."
    },
    "366795": {
      "pl": "Zapłaciłem mu w zeszłym tygodniu.",
