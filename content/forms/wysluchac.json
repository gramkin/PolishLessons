  "tatoeba": {
    "363119": {
      "pl": "Nie był skłonny wysłuchać ich narzekań.",
      "ru": null
    },
    "366263": {
      "pl": "Błagam, wysłuchaj do końca.",
      "ru": null
    },
    "368888": {
      "pl": "Wysłuchałem jej historii.",
      "ru": null
    },
    "369682": {
      "pl": "Należy wysłuchać obu stron.",
      "ru": null
    },
    "416753": {
      "pl": "Wysłuchała tego chłopaka.",
      "ru": "Она выслушала этого парня."
    },
    "531770": {
      "pl": "Chcę wysłuchać Twojego zdania.",
      "ru": null
    },
    "631456": {
      "pl": "Wysłuchaliśmy jej opowieści z dużym zainteresowaniem.",
      "ru": null
    },
    "676732": {
      "pl": "Proszę, wysłuchaj mnie.",
      "ru": null
    },
    "822137": {
      "pl": "Wysłuchałem do końca, co miała do powiedzenia.",
      "ru": null
    },
    "882327": {
      "pl": "Niech będzie wysłuchana i druga strona.",
      "ru": null
    },
    "1002700": {
      "pl": "Dziękuję za wysłuchanie mnie.",
      "ru": null
    },
    "1360010": {
      "pl": "Mam nadzieję że mnie wysłuchasz.",
      "ru": null
    },
    "1605979": {
      "pl": "Wysłucham waszych opinii, szczególnie krytycznych.",
      "ru": null
    },
    "2350619": {
      "pl": "Wysłuchaj mnie, Boże!",
      "ru": null
    },
    "2975732": {
      "pl": "Wysłuchaliśmy jego wykładu w radio.",
      "ru": null
    },
    "3030607": {
      "pl": "Panie i panowie, chciałbym, żebyście wysłuchali mojej opinii.",
      "ru": null
    },
    "3082117": {
      "pl": "Nie mam nikogo, kto by mnie wysłuchał.",
      "ru": null
    },
    "4090902": {
      "pl": "Moje modlitwy zostały wysłuchane.",
      "ru": null
    },
    "4359902": {
      "pl": "Wysłucham ciebie.",
      "ru": null
    },
    "4778178": {
      "pl": "Tom wysłuchał Mary.",
      "ru": null
    },
    "4982370": {
      "pl": "Stanisław Jerzy Lec kiedyś powiedział: \"Czasem trzeba zamilknąć, żeby zostać wysłuchanym.\"",
      "ru": "Станислав Ежи Лец однажды сказал: \"Иногда надо замолчать, чтобы тебя выслушали\"."
    },
    "6312622": {
      "pl": "Wysłuchasz mojej prośby?",
      "ru": null
    },
    "6320317": {
      "pl": "Dziękuję, że porozmawiałaś ze mną, wysłuchałaś mnie.",
      "ru": null
    },
    "10076394": {
      "pl": "Tomek wysłuchał uważnie kazania księdza.",
      "ru": "Том внимательно слушал проповедь священника."
    },
    "10931168": {
      "pl": "Zapewne odmówi wysłuchania jego rady, gdyż go nie lubi.",
      "ru": null
    }
  }
}
