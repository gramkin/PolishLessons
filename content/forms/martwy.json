  "tatoeba": {
    "694384": {
      "pl": "Pies jest martwy.",
      "ru": "Пёс мёртв."
    },
    "821061": {
      "pl": "W jego pokoju wisi martwa natura holenderskiego malarza.",
      "ru": "В его комнате висит натюрморт голландского художника."
    },
    "827797": {
      "pl": "Niedźwiedź nie tknie martwego ciała.",
      "ru": "Медведь не тронет мёртвое тело."
    },
    "1353299": {
      "pl": "Niedźwiedź nie ruszy martwego ciała.",
      "ru": null
    },
    "2707558": {
      "pl": "Martwych jest więcej niż żywych.",
      "ru": null
    },
    "2814691": {
      "pl": "Ona musi być martwa.",
      "ru": "Она, должно быть, мертва."
    },
    "2994934": {
      "pl": "Myślisz, że jest martwy?",
      "ru": "Думаешь, он мёртв?"
    },
    "3599485": {
      "pl": "Są martwi.",
      "ru": null
    },
    "3661076": {
      "pl": "Wszyscy moi przyjaciele i rodzina są martwi.",
      "ru": "Все мои друзья и семья мертвы."
    },
    "5966606": {
      "pl": "To drzewo jest martwe.",
      "ru": null
    },
    "6406109": {
      "pl": "Potem stanął przy martwym borsuku.",
      "ru": null
    },
    "7300007": {
      "pl": "Łacina jest językiem martwym.",
      "ru": null
    },
    "8617795": {
      "pl": "W środku była martwa papuga.",
      "ru": null
    },
    "8774200": {
      "pl": "Byli martwi.",
      "ru": null
    },
    "9677501": {
      "pl": "Chrystus powstał z martwych.",
      "ru": null
    },
    "10571267": {
      "pl": "Obie są martwe.",
      "ru": null
    },
    "10616784": {
      "pl": "Ptak jest martwy.",
      "ru": "Птица мертва."
    },
    "11318421": {
      "pl": "Czy to coś znaczy, gdy kot przynosi ci martwą mysz?",
      "ru": null
    },
    "12471289": {
      "pl": "Wracając do domu, natrafiłem na martwą kunę, leżącą na środku chodnika.",
      "ru": "По пути домой я наткнулся на мёртвую куницу, лежащую посреди тротуара."
    },
    "12759323": {
      "pl": "Żaba zdawała się martwą.",
      "ru": "Лягушка казалась мёртвой."
    },
    "12759347": {
      "pl": "W pracowni wiedźmy stały słoiki z martwymi pająkami.",
      "ru": null
    },
    "13062931": {
      "pl": "Ona znalazła martwego.",
      "ru": null
    }
  }
