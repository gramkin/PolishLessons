    "349109": {
      "pl": "Bez wątpienia Wszechświat jest nieskończony.",
      "ru": "Нет сомненья: вселенная бесконечна."
    },
    "351451": {
      "pl": "Wątpić w siebie – oto pierwszy przejaw rozumu.",
      "ru": "Сомневаться в себе есть первый признак ума."
    },
    "351488": {
      "pl": "Wątpię w jego sukces.",
