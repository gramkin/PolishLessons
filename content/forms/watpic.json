    },
    "3452341": {
      "pl": "Nigdy w to nie wątpiłem.",
      "ru": null
    },
    "3897640": {
      "pl": "Wątpił w prawdziwość jej opowieści.",
      "ru": null
    },
    "4111381": {
      "pl": "Nadal wątpisz w to co powiedziałem?",
      "ru": null
    },
    "4769692": {
      "pl": "Chciałabym, żebyś przestała we mnie wątpić.",
