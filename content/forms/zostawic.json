  "tatoeba": {
    "361292": {
      "pl": "Nie zostawię cię.",
      "ru": null
    },
    "363639": {
      "pl": "W klasie zostawiono drogi aparat.",
      "ru": null
    },
    "440543": {
      "pl": "Szli po śladach zostawionych przez ten samochód.",
      "ru": null
    },
    "578061": {
      "pl": "Czy zostawiłeś napiwek?",
      "ru": null
    },
    "636061": {
      "pl": "Zostawiłem parasol.",
      "ru": null
    },
    "691979": {
      "pl": "Zostaw mnie w spokoju!",
      "ru": "Оставь меня в покое!"
    },
    "705297": {
      "pl": "Jedno z dzieci zostawiło otwarte drzwi.",
      "ru": null
    },
    "930109": {
      "pl": "Zostawiłem swój słownik na dole.",
      "ru": "Я оставил свой словарь внизу."
    },
    "1112979": {
      "pl": "Próbuję zostawić miejsce na deser.",
      "ru": "Я хочу оставить место для десерта."
    },
    "1351165": {
      "pl": "Rower zardzewieje, jeżeli zostawisz go na deszczu.",
      "ru": null
    },
    "1353789": {
      "pl": "Zostaw miejsce pomiędzy liniami.",
      "ru": "Оставь место между линиями."
    },
    "2838226": {
      "pl": "Prosiłem cię o zostawienie Toma w spokoju.",
      "ru": null
    },
    "3604029": {
      "pl": "Może zostawiłyście to w samochodzie.",
      "ru": null
    },
    "3616557": {
      "pl": "Zostaw jedzenie na stole.",
      "ru": "Оставь еду на столе."
    },
    "3631020": {
      "pl": "Czy zostawisz mi trochę ciasteczek?",
      "ru": "Оставишь мне немного печенек?"
    },
    "3662226": {
      "pl": "Zostawimy cię samego.",
      "ru": null
    },
    "3975399": {
      "pl": "Zostawiony sam, chłopiec nie wiedział, co ze sobą zrobić.",
      "ru": null
    },
    "3992315": {
      "pl": "Tom zostawił na stoliku spory napiwek.",
      "ru": "Том оставил на столе большие чаевые."
    },
    "4459584": {
      "pl": "Dlaczego mnie zostawiłaś?",
      "ru": null
    },
    "5016689": {
      "pl": "Zostawiliście otwarte okno?",
      "ru": null
    },
    "5652038": {
      "pl": "Zostawił to Tom.",
      "ru": null
    },
    "5660043": {
      "pl": "Zostawić wszystko.",
      "ru": null
    },
    "6154828": {
      "pl": "Zostaw przeszłość za sobą.",
      "ru": "Оставь прошлое позади."
    },
    "6155758": {
      "pl": "Zostawcie borsuki w spokoju.",
      "ru": "Оставьте барсуков в покое."
    },
    "6313204": {
      "pl": "Jak byście się czuli, gdyby was zostawiła żona?",
      "ru": "Как бы Вы чувствовали себя, если бы Ваша жена ушла от Вас?"
    },
    "6313208": {
