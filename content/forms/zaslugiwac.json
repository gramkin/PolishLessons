  "tatoeba": {
    "368967": {
      "pl": "Ten polityk zasługuje na szacunek.",
      "ru": null
    },
    "589381": {
      "pl": "Zasługujesz na nagrodę.",
      "ru": null
    },
    "1165261": {
      "pl": "Był znudzony swoją żoną, doskonałą kobietą, na którą nie zasługiwał.",
      "ru": null
    },
    "1515211": {
      "pl": "Kto kradnie, zasługuje na karę.",
      "ru": null
    },
    "3084469": {
      "pl": "Zasługują na coś lepszego.",
      "ru": "Они заслуживают лучшего."
    },
    "3598690": {
      "pl": "Zasługuję na to.",
      "ru": null
    },
    "3706562": {
      "pl": "Zasługujemy na trochę zabawy.",
      "ru": null
    },
    "3972645": {
      "pl": "Tom na to zasługuje.",
      "ru": null
    },
    "4827984": {
      "pl": "Starsi ludzie zasługują na szacunek.",
      "ru": null
    },
    "5909134": {
      "pl": "Nie wszystkie teksty zasługują na publikację.",
      "ru": "Не все тексты заслуживают публикации."
    },
    "6157087": {
      "pl": "Zasługuję na prawdę.",
      "ru": null
    },
    "6671580": {
      "pl": "Zasługuję na kolejną szansę.",
      "ru": null
    },
    "9686072": {
      "pl": "Mary nie zasługiwała na twoje zaufanie.",
      "ru": null
    },
    "12351188": {
      "pl": "Zasługujesz na sukces.",
      "ru": null
    },
    "12351190": {
      "pl": "Zasługujecie na sukces.",
      "ru": null
    },
    "12351191": {
      "pl": "Zasługujecie na powodzenie.",
      "ru": null
    },
    "13225499": {
      "pl": "Zasługujesz na miłość po prostu dlatego, że jesteś.",
      "ru": "Ты достоин любви просто потому, что ты есть."
    },
    "13616101": {
      "pl": "Tom zasługiwał na karę, którą otrzymał.",
      "ru": null
    }
