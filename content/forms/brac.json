  "tatoeba": {
    "352958": {
      "pl": "Bierzesz aparat?",
      "ru": null
    },
    "361216": {
      "pl": "Nie bierz tego na serio. Tylko żartuję.",
      "ru": "Не воспринимайте это всерьёз. Я же шучу."
    },
    "403190": {
      "pl": "Ogólnie rzecz biorąc, kobiety żyją dłużej niż mężczyźni.",
      "ru": "Вообще говоря, женщины живут дольше, чем мужчины."
    },
    "497590": {
      "pl": "Brałeś dziś prysznic?",
      "ru": null
    },
    "501975": {
      "pl": "Koniec gadania, bierzemy się do roboty.",
      "ru": "Кончай разговоры, давай работать."
    },
    "524343": {
      "pl": "On bierze kąpiel każdego ranka.",
      "ru": "Он принимает ванну каждое утро."
    },
    "592695": {
      "pl": "Zdolności to jedyny czynnik brany pod uwagę przy awansowaniu pracowników.",
      "ru": null
    },
    "599720": {
      "pl": "Właśnie brałem prysznic.",
      "ru": null
    },
    "739022": {
      "pl": "Ceny nie braliśmy pod uwagę.",
      "ru": "Мы не обращали внимание на цены."
    },
    "744244": {
      "pl": "Zaprzeczyła, by brała udział w spisku.",
      "ru": null
    },
    "756486": {
      "pl": "Ich powodzenie brało się z ich przedsiębiorczości.",
      "ru": null
    },
    "881982": {
      "pl": "Bierzemy udział w pogrzebie.",
      "ru": null
    },
    "960716": {
      "pl": "Czy związek brał udział w demonstracji?",
      "ru": "Профсоюз принимал участие в демонстрации?"
    },
    "1353468": {
      "pl": "Bierze kąpiel każdego ranka.",
      "ru": "Он принимает ванну каждое утро."
    },
    "1645409": {
      "pl": "Zawsze biorę kąpiel przed snem.",
      "ru": "Я всегда принимаю ванну перед сном."
    },
    "1735729": {
      "pl": "Wiesz co, ogólnie rzecz biorąc, to pizda tutaj jest.",
      "ru": "Знаешь, в общем, здесь полный пиздец."
    },
    "1846963": {
      "pl": "W czasie trwania projektu biorące udział kraje i regiony będą porównywać i wymieniać doświadczenia w celu ulepszenia kompetencji społecznych ludności i współpracowników służby zdrowia.",
      "ru": "В течение срока действия проекта участвующие страны и регионы смогут сравнить и обменяться опытом в области национальных и региональных стратегий для улучшения социальной компетенции населения и сотрудников здравоохранения."
    },
    "3603506": {
      "pl": "Odświeżyłem się biorąc kąpiel.",
      "ru": null
    },
    "3660664": {
      "pl": "Chłopcy biorą pozostałe cztery róże i odchodzą z nimi.",
      "ru": "Мальчики берут оставшиеся четыре розы и уходят с ними."
    },
    "3743649": {
      "pl": "Tom dzwonił, kiedy brałaś prysznic.",
      "ru": null
    },
    "4438977": {
      "pl": "Matka Johna wygląda bardzo młodo, więc często jest brana za jego starszą siostrę.",
      "ru": null
    },
    "5468276": {
      "pl": "W żadnym z 27 krajów biorących udział w badaniu różnica w percepcji szkoły, jako miejsca kształtującego autonomię myślenia, przez uczniów i nauczycieli nie była tak znaczna, jak w Polsce.",
      "ru": null
    },
    "6554104": {
      "pl": "Bierzmy się do roboty.",
      "ru": null
    },
    "8458000": {
      "pl": "Ryby dziś nie biorą.",
      "ru": null
    },
    "8500416": {
      "pl": "Kiedy bierzecie ślub?",
      "ru": null
    },
    "8506633": {
      "pl": "Bierze kąpiel.",
      "ru": null
    },
    "8617443": {
      "pl": "Kto brał udział?",
      "ru": null
    },
    "8721574": {
      "pl": "Biorę go.",
      "ru": null
    },
    "10548465": {
      "pl": "Muszę brać lekarstwa.",
      "ru": null
    },
    "12470027": {
      "pl": "Ufaj ludziom, ale nie bierz cukierków od nieznajomych.",
      "ru": "Доверяй людям, но не бери конфеты у незнакомцев."
    },
    "12564333": {
      "pl": "Lepiej jest dawać, niż brać.",
      "ru": "Лучше давать, чем брать."
    },
    "12569794": {
      "pl": "Bierz!",
      "ru": "Бери!"
    },
    "12680309": {
      "pl": "Nie bierzcie jeńców.",
