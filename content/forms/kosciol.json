    "349195": {
      "pl": "Jest tyle kościołów, co muzeów.",
      "ru": null
    },
    "352169": {
      "pl": "Na całej wyspie pobudowano kościoły.",
      "ru": null
    },
    "587522": {
      "pl": "On rzadko chodzi do kościoła.",
