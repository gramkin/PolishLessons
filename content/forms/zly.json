  "tatoeba": {
    "349019": {
      "pl": "To był zły królik.",
      "ru": "Это был злой кролик."
    },
    "357714": {
      "pl": "To najgorszy hotel w mieście.",
      "ru": null
    },
    "393075": {
      "pl": "Wysiadłem na złej stacji.",
      "ru": null
    },
    "442969": {
      "pl": "Przyszedł w najgorszym momencie.",
      "ru": null
    },
    "534071": {
      "pl": "Najgorsze jeszcze przed nami.",
      "ru": "Самое худшее ещё впереди."
    },
    "601120": {
      "pl": "Jesteś złym chłopcem.",
      "ru": null
    },
    "975963": {
      "pl": "Jesteś zły?",
      "ru": "Ты сердишься?"
    },
    "1581452": {
      "pl": "Najgorsze minęło.",
      "ru": null
    },
    "1589548": {
      "pl": "Lepiej być samemu niż w złym towarzystwie.",
      "ru": "Лучше быть одному, чем в плохой компании."
    },
    "2131896": {
      "pl": "Albowiem korzeniem wszystkiego złego jest miłość pieniędzy, których niektórzy pragnąc, pobłądzili od wiary i poprzebijali się wieloma boleściami.",
      "ru": "Ибо корень всех зол есть сребролюбие, которому предавшись, некоторые уклонились от веры и сами себя подвергли многим скорбям."
    },
    "2158073": {
      "pl": "Prawdziwi przyjaciele trzymają się razem na dobre i na złe.",
      "ru": "Настоящие друзья держатся вместе и в добре, и во зле."
    },
    "2684362": {
      "pl": "Nie miał złych intencji.",
      "ru": null
    },
    "2793185": {
      "pl": "Powodem dla którego dostałem złą ocenę jest to, że się nie uczyłem.",
      "ru": "Причина, почему я получил плохую оценку в том, что я не учил."
    },
    "3743818": {
      "pl": "Mam dla ciebie złe wieści.",
      "ru": "У меня для тебя плохие новости."
    },
    "3743820": {
      "pl": "Mam dla was złe wieści.",
      "ru": "У меня для вас плохие новости."
    },
    "3853608": {
      "pl": "Jest wiele rzeczy gorszych od śmierci.",
      "ru": null
    },
    "4558210": {
      "pl": "Co najgorszego mogliby zrobić?",
      "ru": null
    },
