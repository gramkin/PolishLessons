  "tatoeba": {
    "362989": {
      "pl": "Wydawał się uczciwy.",
      "ru": null
    },
    "363548": {
      "pl": "Wydaję na ubrania mniej niż moja siostra.",
      "ru": "Я трачу меньше денег на одежду, чем моя сестра."
    },
    "541460": {
      "pl": "Wydaje się, że był bogaty.",
      "ru": "Кажется, он был богат."
    },
    "566288": {
      "pl": "Podatnicy są wściekli na marnotrawstwo w wydawaniu pieniędzy przez rząd.",
      "ru": null
    },
    "728445": {
      "pl": "Oni łatwo wydają pieniądze.",
      "ru": null
    },
    "900862": {
      "pl": "Może wydawać pieniądze na co chce.",
      "ru": null
    },
    "903531": {
      "pl": "Jej mąż planuje wydawanie nowego miesięcznika.",
      "ru": null
    },
    "2493634": {
      "pl": "Nawet nie chcę wiedzieć, na co wydajesz wszystkie zarobione pieniądze.",
      "ru": "Даже знать не хочу, куда ты спускаешь все заработанные деньги."
    },
    "2772105": {
      "pl": "Prawie każde czasopismo jest wydawane w stolicy.",
      "ru": null
    },
    "3518439": {
      "pl": "To trudniejsze, niż się wydaje.",
      "ru": "Это труднее, чем кажется."
    },
    "3744932": {
      "pl": "Trąbka wydawała jasny dźwięk.",
      "ru": null
    },
    "5516891": {
      "pl": "Wydaje mi się, że tak.",
      "ru": "Мне кажется, да."
    },
    "6154769": {
      "pl": "Wydawało się tanie.",
      "ru": null
    },
    "6155679": {
      "pl": "Pierdnięcie to odgłos wydawany podczas wypuszczania gazów trawiennych.",
      "ru": null
    },
    "6155773": {
      "pl": "Płazy i gady zawsze wydawały mi się trochę obrzydliwe.",
      "ru": null
    },
    "6304226": {
      "pl": "Wydawałaś się zajęta.",
      "ru": null
    },
    "6328309": {
      "pl": "Tylko ci się tak wydaje.",
      "ru": "Только тебе так кажется."
    },
    "7183286": {
      "pl": "Tom i Mary wydawali się bardzo zajęci, nie sądzisz?",
      "ru": null
    },
    "11250043": {
      "pl": "W wielu językach koty domowe są nazwane po wydawanym przez nie odgłosie \"miau\".",
      "ru": null
    },
    "12948536": {
      "pl": "Niewiele wydaję.",
      "ru": null
    },
    "13225493": {
      "pl": "Nie zrozum mnie źle, ale wydajesz mi się dziwna.",
      "ru": "Не пойми меня неправильно, но ты кажешься мне странной."
    },
    "13225495": {
      "pl": "Nie zrozum mnie źle, ale wydajesz mi się dziwny.",
      "ru": "Не пойми меня неправильно, но ты кажешься мне странным."
    },
    "13309811": {
      "pl": "Zaprzestań wydawania pieniędzy na głupie rzeczy.",
      "ru": null
    },
    "13573555": {
      "pl": "Proszę, bądź cicho! Nie wydawaj dźwięków.",
      "ru": null
    },
    "13784956": {
      "pl": "Wydawało mi się, że jestem nikomu niepotrzebna.",
      "ru": "Мне казалось, что я никому не нужна."
    },
    "13784958": {
