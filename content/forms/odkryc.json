  "tatoeba": {
    "365682": {
      "pl": "To zadziwiające odkrycie.",
      "ru": null
    },
    "366215": {
      "pl": "Właśnie odkryto dziwne stworzenie morskie.",
      "ru": null
    },
    "366958": {
      "pl": "Niespodziewanie odkryto nową wyspę.",
      "ru": null
    },
    "368947": {
      "pl": "Byłem zdziwiony tym odkryciem.",
      "ru": null
    },
    "393340": {
      "pl": "Naukowiec próbował odkryć prawa natury.",
      "ru": null
    },
    "525214": {
      "pl": "Przez kogo została odkryta ta wyspa?",
      "ru": null
    },
    "572872": {
      "pl": "Dokonał ważnego odkrycia.",
      "ru": null
    },
    "603221": {
      "pl": "Gdy to odkryje, na pewno będzie bardzo zły.",
      "ru": null
    },
    "608667": {
      "pl": "Musimy odkryć skuteczny lek na raka.",
      "ru": null
    },
    "696472": {
      "pl": "Odkryliśmy tajemne przejście do tego budynku.",
      "ru": null
    },
    "790799": {
      "pl": "Lepiej pozwól studentom odkryć to samemu.",
      "ru": null
    },
    "904228": {
      "pl": "Odkryliśmy pozostałości starożytnej cywilizacji.",
      "ru": null
    },
    "929403": {
      "pl": "Dokonałem odkrycia.",
      "ru": null
    },
    "972946": {
      "pl": "To Maria Skłodowska-Curie odkryła rad.",
      "ru": null
    },
    "1085683": {
      "pl": "Zrobiłem odkrycie.",
      "ru": null
    },
    "1086567": {
      "pl": "Odkryliśmy ostatnio, że tu na tej górze żyją jakieś lisy.",
      "ru": null
    },
    "1233569": {
      "pl": "Kto odkrył rad?",
      "ru": null
    },
    "1863913": {
      "pl": "Mówią, że wikingowie odkryli Amerykę jeszcze przed Kolumbem.",
      "ru": "Говорят, что викинги открыли Америку ещё до Колумба."
    },
    "2205813": {
      "pl": "Tom odkrył prawdę.",
      "ru": null
    },
    "2244442": {
      "pl": "Ameryka została odkryta przez Kolumba.",
      "ru": null
    },
    "2256102": {
      "pl": "Odkryli nowy sposób.",
      "ru": null
    },
    "3239726": {
      "pl": "Dokonaliśmy odkrycia stulecia.",
      "ru": null
    },
    "3897325": {
      "pl": "Odkryłem tajemnicę.",
      "ru": null
    },
    "4270719": {
      "pl": "Basen odkryty powinien zostać zamknięty.",
      "ru": null
    },
    "4725777": {
      "pl": "Policja odkryła ich sztuczki.",
      "ru": null
    },
    "4816971": {
      "pl": "Myślałem, że Tom odkryje to samemu.",
      "ru": null
    },
    "5215226": {
      "pl": "Odkryłem prawdę.",
      "ru": null
    },
    "5488007": {
      "pl": "Odkryłem nowy i ciekawy świat.",
      "ru": "Я открыл новый и интересный мир."
    },
    "6541911": {
      "pl": "Odkryła nowy, kolorowy świat.",
      "ru": null
    },
    "6554275": {
      "pl": "Odkrył sekret.",
      "ru": null
    },
    "8537497": {
      "pl": "Badacze odkryli szkielet w jaskini.",
      "ru": null
    },
    "8819903": {
      "pl": "Odkryto tam złoto.",
      "ru": null
    },
    "10472067": {
      "pl": "To odkrycie stało się sensacją.",
      "ru": null
    },
    "10574756": {
      "pl": "Odkryłem, że mnie obgadujesz.",
      "ru": null
    },
    "10597717": {
      "pl": "Kto odkrył Amerykę?",
