  "tatoeba": {
    "603193": {
      "pl": "Malowanie obrazka sprawiało chłopcu przyjemność.",
      "ru": null
    },
    "756917": {
      "pl": "Nie sprawiaj więcej kłopotu niż teraz.",
      "ru": null
    },
    "766108": {
      "pl": "Jego umiejętności sprawiają, że jest idealny do tej pracy.",
      "ru": null
    },
    "936067": {
      "pl": "Widać było bezchmurne niebo, co sprawiało mi wielką radość.",
      "ru": null
    },
    "1295016": {
      "pl": "Nie chciałbym ci sprawiać przykrości.",
      "ru": null
    },
    "1349130": {
      "pl": "Jego dobre maniery sprawiają, że ludzie go lubią.",
      "ru": null
    },
    "1561272": {
      "pl": "Przepraszam, że sprawiam ci tyle kłopotów.",
      "ru": null
    },
    "1696726": {
      "pl": "Jej ręce sprawiały wrażenie zimnych jak marmur.",
      "ru": null
    },
    "2684363": {
      "pl": "Nie chcieliśmy sprawiać bólu.",
      "ru": null
    },
    "3093197": {
      "pl": "Nie sprawiaj, żebym był smutny.",
      "ru": null
    },
    "3172245": {
      "pl": "Herbata jest jak smar sprawiający, że praca przebiega płynnie.",
      "ru": null
    },
    "3410008": {
      "pl": "To sprawia mi radość.",
      "ru": null
    },
    "3634735": {
      "pl": "Przestań! Sprawiasz, że czuje się niezręcznie!",
      "ru": null
    },
    "4768970": {
      "pl": "Przestań! Sprawiasz, że ona czuje się nieswojo!",
      "ru": null
    },
    "4885148": {
      "pl": "Sprawiacie wrażenie że to dla was trudne.",
      "ru": null
    },
    "4885163": {
      "pl": "Sprawiał wrażenie, że nie wie o tej sprawie.",
      "ru": null
    },
    "4917224": {
      "pl": "Kwiaty sprawiają, że jest szczęśliwa.",
      "ru": null
    },
    "6441454": {
      "pl": "Co sprawia, że tak myślisz?",
      "ru": null
    },
    "6553989": {
      "pl": "Tom nie będzie sprawiał problemów.",
      "ru": null
    },
    "6639871": {
      "pl": "Sprawiasz, że czuję się winny.",
      "ru": null
    },
    "7663699": {
      "pl": "Sprawiała wrażenie, że to lubi.",
      "ru": null
    },
    "7868984": {
      "pl": "Sprawiam, że się uśmiechasz.",
      "ru": null
    },
    "8224776": {
      "pl": "Z upływem czasu drewniane drzwi mogą się wypaczyć lub napuchnąć, sprawiając że drzwi będzie ciężko zamknąć.",
      "ru": null
    },
    "12045078": {
      "pl": "Tom sprawiał wrażenie bogatego.",
      "ru": null
    },
    "12097163": {
      "pl": "Tom sprawia, że jestem lepszy.",
      "ru": null
    },
    "12454039": {
      "pl": "Sprawiało mi to przyjemność.",
      "ru": null
    },
    "13806385": {
      "pl": "Musi ci to naprawdę sprawiać przyjemność.",
      "ru": null
    }
  }
