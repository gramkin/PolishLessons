  "tatoeba": {
    "756576": {
      "pl": "To wasze zwycięstwo.",
      "ru": "Это ваша победа."
    },
    "3460230": {
      "pl": "To wasz pies. A gdzie mój?",
      "ru": "Вот ваша собака. А моя где?"
    },
    "3464069": {
      "pl": "Teraz jestem waszym szefem.",
      "ru": "Теперь я ваш начальник."
    },
    "3486181": {
      "pl": "Nasz dom jest waszym domem.",
      "ru": "Наш дом — ваш дом."
    },
    "3657570": {
      "pl": "Liczymy na waszą pomoc.",
      "ru": "Мы рассчитываем на вашу помощь."
    },
    "3660631": {
      "pl": "Mam nadzieję, rozpocząć naukę waszego pięknego języka w najbliższym czasie.",
      "ru": "Я надеюсь начать изучение в ближайшем будущем вашего прекрасного языка."
    },
    "4353979": {
      "pl": "Czytam waszą książkę.",
      "ru": null
    },
    "4716833": {
      "pl": "Gdzie jest wasza sypialnia?",
      "ru": "Где ваша спальня?"
    },
    "4952999": {
      "pl": "Chcę waszej pomocy.",
      "ru": null
    },
    "5528891": {
      "pl": "Mam wasze bilety.",
      "ru": "Ваши билеты у меня."
    },
    "6553627": {
      "pl": "Jestem waszym tatą.",
      "ru": "Я ваш папа."
    },
    "8730388": {
      "pl": "Wasza kolej.",
      "ru": null
    },
    "10236877": {
      "pl": "Do diabła z waszymi problemami.",
      "ru": null
    },
    "10572795": {
      "pl": "Znam waszego ojca.",
      "ru": null
    },
    "10574171": {
      "pl": "Nie chcę waszych pieniędzy.",
      "ru": null
    },
    "10747402": {
      "pl": "A gdzie wasze rzeczy?",
      "ru": "А где ваши вещи?"
    },
    "13472055": {
      "pl": "Za naszą i waszą wolność.",
      "ru": "За нашу и вашу свободу."
    },
    "13607070": {
      "pl": "Jakiej narodowości są wasi rodzice?",
      "ru": null
    },
    "13657509": {
      "pl": "Wasz ruch.",
      "ru": null
    },
    "13865805": {
      "pl": "To nie wasza sprawa.",
      "ru": "Это не ваше дело."
