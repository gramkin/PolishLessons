    "366263": {
      "pl": "Błagam, wysłuchaj do końca.",
      "ru": null
    },
    "1590890": {
      "pl": "Tom błagał o jedzenie.",
      "ru": null
    },
    "3294985": {
      "pl": "Tom błagał mnie, żebym nie robił mu krzywdy.",
      "ru": null
    },
    "3502809": {
      "pl": "Starszy człowiek błagał mnie o pieniądze.",
      "ru": null
    },
    "4122289": {
      "pl": "Tom błagał nas, żebyśmy zostali.",
      "ru": null
    },
    "6301938": {
      "pl": "Błagam, kupcie ode mnie tę głupią sukienkę!",
      "ru": null
    },
    "6729640": {
      "pl": "Błagam cię!",
      "ru": null
    },
    "7682108": {
      "pl": "Błagał, żeby wróciła.",
      "ru": null
    },
    "7802539": {
      "pl": "Błagałem Toma żeby tego nie robił.",
      "ru": null
    },
    "9190636": {
      "pl": "Błagam, nie mów mamie!",
      "ru": null
    },
    "11003277": {
      "pl": "Błagała mnie, abym z nią poszedł.",
      "ru": null
    },
    "11741396": {
      "pl": "Błagam o przebaczenie.",
      "ru": "Я молю о прощении."
    },
    "12353509": {
      "pl": "Z wyciągniętymi rękami błagali o pokój.",
      "ru": null
    },
    "12353703": {
      "pl": "Błagał mnie, abym go bronił.",
      "ru": null
    },
    "12359914": {
      "pl": "Tom błagał Mary o jeszcze jedną szansę.",
      "ru": null
    }
  }
