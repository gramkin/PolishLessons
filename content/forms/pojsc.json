    },
    "1889756": {
      "pl": "Tom namówił Mary na pójście.",
      "ru": null
    },
    "2120203": {
      "pl": "Jeśli jutro będzie padać, nie pójdą.",
      "ru": "Если завтра будет дождь, они не пойдут."
    },
    "2145381": {
      "pl": "Piotr poszedł do domu.",
      "ru": "Пётр пошёл домой."
    },
    "2147210": {
      "pl": "Powiedział mi, dokąd pójść.",
      "ru": "Он сказал мне, куда идти."
    },
    "2205260": {
      "pl": "Poszła na spacer do parku.",
      "ru": "Она пошла в парк на прогулку."
    },
    "2282524": {
      "pl": "Gdzie poszłaś?",
      "ru": null
    },
    "2467072": {
      "pl": "Poszedł do dentysty.",
      "ru": "Он пошёл к зубному врачу."
    },
    "2734062": {
      "pl": "Mama poszła na rynek.",
      "ru": "Мама пошла на рынок."
    },
    "2778613": {
      "pl": "Poszłyśmy do muzeum.",
      "ru": "Мы пошли в музей."
    },
    "3649428": {
      "pl": "Nie pójdziemy, jeżeli będzie padać.",
      "ru": "Мы не пойдём, если будет дождь."
    },
    "4328342": {
      "pl": "Też tam poszłam.",
