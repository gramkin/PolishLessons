    "989407": {
      "pl": "Poszedłeś na plażę i nie wziąłeś ręcznika?",
      "ru": "Ты пошёл на пляж и не взял полотенце?"
    },
    "1217900": {
      "pl": "Łatwo przyszło, łatwo poszło.",
      "ru": "Легко полученное легко теряется."
    },
    "1349207": {
      "pl": "Pójdę na wycieczkę.",
      "ru": "Я поеду в путешествие."
