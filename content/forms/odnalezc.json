    "361748": {
      "pl": "Zaginione dziecko odnalazło się po dwóch dniach.",
      "ru": null
    },
    "403154": {
      "pl": "Wciąż nie porzucała nadziei, że jej pies odnajdzie się żywy.",
      "ru": null
    },
    "527062": {
      "pl": "Odnalazł swoich rodziców.",
      "ru": null
    },
    "535454": {
      "pl": "W końcu odnalazł swego zaginionego brata.",
      "ru": null
    },
    "629940": {
      "pl": "Przypadkiem odnalazł skarb.",
      "ru": null
    },
    "830443": {
      "pl": "Kiedy odnalazłem swoją tożsamość, życie nabrało sensu.",
      "ru": "Когда я обрёл своё истинное \"я\", моя жизнь стала наполняться смыслом."
    },
    "1618169": {
      "pl": "Wielka Niedźwiedzica jest łatwa do odnalezienia.",
      "ru": null
    },
    "1673891": {
      "pl": "Muszę ją odnaleźć.",
      "ru": null
    },
    "2587071": {
      "pl": "Policja odnalazła rower Toma.",
      "ru": null
    },
    "3499993": {
      "pl": "Jego ciała nigdy nie odnaleziono.",
      "ru": null
    },
    "3757045": {
      "pl": "Najpierw musimy odnaleźć Toma.",
      "ru": null
    },
    "6769109": {
      "pl": "Jeśli poszukasz w swoim sercu, odnajdziesz tam bohatera.",
      "ru": null
    },
    "7886554": {
      "pl": "Zrobimy wszystko, żeby odnaleźć Toma.",
      "ru": null
    },
    "10999943": {
      "pl": "Będzie nagroda dla osoby, która odnajdzie mojego psa.",
      "ru": null
    },
    "11360572": {
      "pl": "Dzieci, które zaginęły, zostały odnalezione.",
      "ru": null
    },
    "12044182": {
      "pl": "Powiedział, że spędził cały dzień na próbie jej odnalezienia.",
      "ru": null
    },
    "12470392": {
      "pl": "Przeszukaliśmy las w celu odnalezienia zaginionego dziecka.",
      "ru": null
    },
    "12885316": {
      "pl": "Tomasz był martwy przez trzy tygodnie, kiedy jego ciało zostało odnalezione.",
      "ru": null
    },
    "13684061": {
      "pl": "Pieniędzy nigdy nie odnaleziono.",
