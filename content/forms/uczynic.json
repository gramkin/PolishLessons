  "tatoeba": {
    "600408": {
      "pl": "Ojciec uczynił ze mnie tego kim jestem.",
      "ru": null
    },
    "600959": {
      "pl": "Uczynił to z uprzejmości.",
      "ru": null
    },
    "676685": {
      "pl": "Chciałbym wyrazić swą wdzięczność za to, co uczyniłeś dla tego miasta.",
      "ru": "Я хотел бы выразить свою благодарность за то, что Вы сделали для нашего города."
    },
    "923117": {
      "pl": "To on uczynił tę firmę tym, czym jest obecnie.",
      "ru": null
    },
    "1350332": {
      "pl": "Po uczynieniu tego kroku nie było już odwrotu.",
      "ru": null
    },
    "2838214": {
      "pl": "Urządzenia elektryczne uczyniły prace domowe łatwiejszymi.",
      "ru": null
    },
    "3430629": {
      "pl": "By uczynić życie szczęśliwym, musisz kochać codzienne błahostki.",
