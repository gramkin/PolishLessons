      "ru": null
    },
    "6305722": {
      "pl": "Ustanowienie rekordu uczyniło go jeszcze popularniejszym.",
      "ru": null
    },
    "7962579": {
      "pl": "Niech Wszechmogący Bóg uczyni cię bardzo szczęśliwym.",
      "ru": null
    },
    "8948718": {
      "pl": "Nowoczesna technologia uczyniła nasze życia wygodniejszymi.",
      "ru": null
    },
    "10160025": {
      "pl": "Uczyniłaś mnie najszczęśliwszym mężczyzną na świecie.",
