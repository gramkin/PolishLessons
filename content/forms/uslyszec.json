  "tatoeba": {
    "350027": {
      "pl": "Płakała z radości, kiedy usłyszała, że jej syn przeżył katastrofę samolotu.",
      "ru": "Она заплакала от радости, когда услышала, что ее сын выжил в авиакатастрофе."
    },
    "352863": {
      "pl": "Odpowiedzcie, kiedy usłyszycie swoje imię.",
      "ru": null
    },
    "361311": {
      "pl": "Boże, usłysz mnie!",
      "ru": null
    },
    "364898": {
      "pl": "Po prostu chciałem usłyszeć dźwięk twojego głosu.",
      "ru": "Мне просто хотелось услышать звук твоего голоса."
    },
    "411510": {
      "pl": "Usłyszeli hałas za plecami.",
      "ru": null
    },
    "725360": {
      "pl": "Kiedy usłyszałem swoje nazwisko, machinalnie odpowiedziałem.",
      "ru": "Услышав своё имя, я машинально ответил."
    },
    "732962": {
      "pl": "Usłyszeliśmy huk gromu.",
      "ru": null
    },
    "765876": {
      "pl": "Skąd mam wiedzieć, co mówię, zanim nie usłyszę tego, co myślę?",
      "ru": "Откуда я должен знать, что говорю, пока не услышу того, что думаю?"
    },
    "814183": {
      "pl": "Usłyszawszy to, byłem mocno zawiedziony.",
      "ru": null
    },
    "1348446": {
      "pl": "Zamknąłem drzwi, by nas nie usłyszeli.",
      "ru": "Я закрыл дверь, чтобы нас не услышали."
    },
    "1361806": {
      "pl": "Po usłyszeniu wiadomości, wybiegł z domu.",
      "ru": null
    },
    "1399763": {
      "pl": "Dotknij zwierzę aby usłyszeć dźwięk.",
      "ru": "Дотронься до животного, чтобы услышать звук."
    },
    "1729249": {
      "pl": "Usłyszałem wczoraj piękną piosenkę.",
      "ru": "Вчера я слышал красивую песню."
    },
    "2135868": {
      "pl": "Jeśli usłyszysz alarm, idź, nie biegnij.",
      "ru": null
    },
    "5710525": {
      "pl": "Każdy usłyszy.",
      "ru": null
    },
    "5975471": {
      "pl": "Usłyszawszy to wszystko, zapłakał.",
      "ru": "Услышав всё это, он заплакал."
    },
    "6157065": {
      "pl": "Jeśli przez resztę nocy usłyszę choćby pierdnięcie myszy, to przysięgam na Boga, wszyscy wylądujecie w szpitalu.",
      "ru": null
    },
    "6312668": {
      "pl": "Usłyszała jak płacze.",
      "ru": "Она услышала, как он плачет."
    },
    "6312669": {
      "pl": "Usłyszała jego płacz.",
      "ru": "Она услышала его плач."
    },
    "6602797": {
      "pl": "Co usłyszałeś?",
      "ru": null
    },
    "10604936": {
      "pl": "Usłyszano trzy wystrzały.",
      "ru": null
    },
    "10671004": {
      "pl": "Usłyszał to.",
      "ru": null
    },
    "11266020": {
      "pl": "Do usłyszenia zaraz!",
      "ru": null
    },
    "12351218": {
      "pl": "Usłyszałam to od was.",
      "ru": null
    },
    "12955859": {
      "pl": "Co chcesz usłyszeć?",
      "ru": "Что ты хочешь услышать?"
    },
    "13528098": {
      "pl": "Czy usłyszałaś jej imię?",
      "ru": null
    },
    "13660032": {
      "pl": "Myślę, że usłyszałem wystarczająco.",
      "ru": "Думаю, я услышал достаточно."
    }
  }
