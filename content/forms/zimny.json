  "tatoeba": {
    "362427": {
      "pl": "Wiał zimny wiatr.",
      "ru": null
    },
    "362936": {
      "pl": "Poproszę zimną wodę.",
      "ru": null
    },
    "372494": {
      "pl": "Styczeń jest zwykle najzimniejszym miesiącem.",
      "ru": null
    },
    "524399": {
      "pl": "Nie lubię zimnej kawy.",
      "ru": "Я не люблю холодный кофе."
    },
    "924466": {
      "pl": "Kiedy przyszła jesień, dni stały się coraz krótsze, a noce – coraz zimniejsze. Patrzyła, jak po pierwszym przymrozku żółkną i czerwienieją liście na drzewach.",
      "ru": null
    },
    "1696726": {
      "pl": "Jej ręce sprawiały wrażenie zimnych jak marmur.",
      "ru": null
    },
    "2239473": {
      "pl": "Nie chcę pić zimnej herbaty.",
      "ru": "Я не хочу пить холодный чай."
    },
    "2246970": {
      "pl": "Szybko się przyzwyczaisz do zimnego klimatu.",
      "ru": "Ты быстро привыкнешь к холодному климату."
    },
    "2576076": {
      "pl": "W tym roku mamy podobno najzimniejszą zimę na przestrzeni 20 lat.",
      "ru": null
    },
    "2809463": {
      "pl": "Im głębiej się zanurzamy, tym zimniejsza jest woda.",
      "ru": null
    },
    "3991042": {
      "pl": "Tom oblał się zimną wodą, żeby się obudzić.",
      "ru": "Том облился холодной водой, чтобы проснуться."
    },
    "5654482": {
      "pl": "Drżał z zimna.",
      "ru": "Он дрожал от холода."
    },
    "5714922": {
      "pl": "Tom wziął zimną kąpiel.",
      "ru": "Том принял холодную ванну."
    },
    "6157993": {
      "pl": "Jest coś zimnego do picia?",
      "ru": "Есть что-нибудь холодное попить?"
    },
    "6541943": {
      "pl": "Jej policzki były zimne jak lód.",
      "ru": "Её щёки были холодными как лёд."
    },
    "6541944": {
      "pl": "Miała policzki zimne jak lód.",
      "ru": "Щёки у неё были холодные как лёд."
    },
    "7165581": {
      "pl": "Potrzebuję zimnego prysznica.",
      "ru": null
    },
    "8448609": {
      "pl": "Woda jest zimna.",
      "ru": "Вода холодная."
    },
    "8743695": {
      "pl": "Są zimne.",
      "ru": null
    },
    "9534640": {
      "pl": "Był jasny, zimny dzień kwietniowy i zegary biły trzynastą.",
      "ru": "Это был яркий холодный апрельский день, и часы показывали час дня."
    },
    "10565665": {
      "pl": "Są zimni.",
      "ru": null
    },
    "12678722": {
      "pl": "Ogień jest gorący, a lód zimny.",
      "ru": "Огонь горячий, а лёд холодный."
    },
    "13875387": {
      "pl": "Nie lubię zimnej pogody.",
