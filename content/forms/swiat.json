  "tatoeba": {
    "361624": {
      "pl": "Czy jest życie na innych światach?",
      "ru": null
    },
    "533534": {
      "pl": "Świat jest pełen głupców.",
      "ru": "Мир полон дураков."
    },
    "775907": {
      "pl": "Nikt na świecie nie chce wojny.",
      "ru": "Никто в мире не хочет войны."
    },
    "908081": {
      "pl": "Kiedy będzie koniec świata?",
      "ru": "Когда будет конец света?"
    },
    "1591104": {
      "pl": "Do odważnych świat należy.",
      "ru": "Смелость города берёт."
    },
    "2153740": {
      "pl": "Kiedy nastąpi koniec świata?",
      "ru": "Когда наступит конец света?"
    },
    "2194700": {
      "pl": "Chcemy zmieniać świat.",
      "ru": "Мы хотим изменить мир."
    },
    "2535358": {
      "pl": "Ile jest krajów na świecie?",
      "ru": "Сколько стран в мире?"
    },
    "3409740": {
      "pl": "Teraz stałem się śmiercią, niszczycielem światów.",
      "ru": null
    },
    "4724894": {
      "pl": "On podróżował dookoła świata.",
      "ru": "Он путешествовал по миру."
    },
    "6154983": {
      "pl": "Cały świat pragnie pokoju.",
      "ru": "Весь мир желает мира."
    },
    "6156425": {
      "pl": "To największy królik na świecie!",
      "ru": "Это самый большой кролик в мире!"
    },
    "9952244": {
      "pl": "Koty rządzą światem.",
      "ru": "Коты правят миром."
    },
    "12624949": {
      "pl": "Miał ochotę podzielić się swoim żalem z całym światem.",
      "ru": "Ему хотелось поделиться своим горем со всем миром."
    },
    "12624951": {
      "pl": "Miał ochotę podzielić się swoim smutkiem z całym światem.",
      "ru": "Ему хотелось поделиться своим горем со всем миром."
