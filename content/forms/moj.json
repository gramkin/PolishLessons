  "tatoeba": {
    "352681": {
      "pl": "Jeden z mych kuzynów ma żonę pisarkę.",
      "ru": null
    },
    "352957": {
      "pl": "Mieszkam teraz u mego wuja.",
      "ru": null
    },
    "361301": {
      "pl": "Nie sposób opisać mych uczuć.",
      "ru": null
    },
    "363783": {
      "pl": "Wynocha z mego życia!",
      "ru": "Вон из моей жизни!"
    },
    "544763": {
      "pl": "To moja szkoła.",
      "ru": "Это моя школа."
    },
    "557441": {
      "pl": "To moja praca.",
      "ru": "Это моя работа."
    },
    "605929": {
      "pl": "Wspomniał o mej książce.",
      "ru": null
    },
    "665859": {
      "pl": "To mój dom.",
      "ru": "Это мой дом."
    },
    "705351": {
      "pl": "Ku memu zdziwieniu, on pięknie śpiewał.",
      "ru": null
    },
    "713495": {
      "pl": "Jesteś miłością mego życia.",
      "ru": null
    },
    "735802": {
      "pl": "Po moim trupie!",
      "ru": "Только через мой труп!"
    },
    "868045": {
      "pl": "Wczoraj pomogłem memu ojcu.",
      "ru": null
    },
    "1088759": {
      "pl": "Moi rodzice nie żyją.",
      "ru": "Моих родителей нет в живых."
    },
    "2122198": {
      "pl": "Moja kolej?",
      "ru": "Моя очередь?"
    },
    "2194298": {
      "pl": "To mój pokój.",
      "ru": "Это моя комната."
    },
    "2277691": {
      "pl": "Kelner, w mojej zupie pływa mucha!",
      "ru": "Официант, в моём супе плавает муха!"
    },
    "2399296": {
      "pl": "To moje dziecko.",
      "ru": "Это мой ребёнок."
    },
    "2408325": {
      "pl": "Bądź moją prawą ręką.",
      "ru": "Будь моей правой рукой."
    },
    "2408660": {
      "pl": "Jest moim ideałem.",
      "ru": "Он мой идеал."
    },
    "2630829": {
      "pl": "Ona jest moją żoną.",
      "ru": "Она моя жена."
    },
    "2665441": {
      "pl": "Siostra mojej mamy to moja ciocia.",
      "ru": "Сестра моей матери - моя тётя."
    },
    "2679945": {
      "pl": "Pomagam mojemu dziadkowi.",
      "ru": null
    },
    "3051206": {
      "pl": "To mój pies.",
      "ru": "Это моя собака."
    },
    "3450255": {
      "pl": "Nikt nie widzi moich łez.",
      "ru": "Никто не видит моих слёз."
    },
    "3524678": {
      "pl": "Są moimi przyjaciółmi.",
      "ru": null
    },
    "3660783": {
      "pl": "On chwycił moją rękę.",
      "ru": "Он ухватился за мою руку."
    },
    "5183854": {
      "pl": "Nie mów mojemu mężowi.",
      "ru": null
    },
    "5511027": {
      "pl": "To nie moje.",
      "ru": "Это не моё."
    },
    "5988866": {
      "pl": "Mama kazała mi pracować wbrew mej woli.",
      "ru": null
    },
    "6017174": {
      "pl": "Są w moim domu.",
      "ru": "Они в моём доме."
    },
    "6134524": {
      "pl": "Możesz używać mojego słownika.",
      "ru": "Можешь пользоваться моим словарём."
    },
    "6155146": {
      "pl": "Pomogłam memu ojcu umyć samochód.",
      "ru": null
    },
    "6156049": {
      "pl": "Kocham moich braci i siostry.",
      "ru": "Я люблю своих братьев и сестёр."
    },
    "6313676": {
      "pl": "Przywitałem się z moimi sąsiadami.",
      "ru": "Я поздоровался с моими соседями."
    },
    "7960744": {
      "pl": "To moi rodzice.",
      "ru": "Это мои родители."
    },
    "7983146": {
      "pl": "Nie lubię mojego imienia.",
      "ru": "Мне не нравится моё имя."
    },
    "7983770": {
      "pl": "Są moimi braćmi.",
      "ru": null
    },
    "8108571": {
      "pl": "To moje córki.",
      "ru": "Это мои дочери."
    },
    "8580242": {
      "pl": "Wstanę, po mieście chodzić będę, wśród ulic i placów, szukać będę ukochanego mej duszy.",
      "ru": "Встану же я, пойду по городу, по улицам и площадям, и буду искать того, которого любит душа моя."
    },
    "10952445": {
      "pl": "Powiem mojemu ojcu.",
      "ru": null
    },
    "12569758": {
      "pl": "Zapomniał o moich urodzinach.",
      "ru": "Он забыл про мой день рождения."
    },
    "12680499": {
      "pl": "To są moi synowie.",
      "ru": "Это мои сыновья."
    },
    "13084357": {
      "pl": "To książka z mojej biblioteki.",
      "ru": "Это книга из моей библиотеки."
    },
    "13785995": {
      "pl": "Wynocha z mojego auta!",
      "ru": "Вон из моей машины!"
    }
  }
}
