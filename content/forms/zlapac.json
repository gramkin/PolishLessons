  "tatoeba": {
    "353170": {
      "pl": "Złapałeś mnie.",
      "ru": null
    },
    "355491": {
      "pl": "Pospiesz się, to złapiesz autobus.",
      "ru": null
    },
    "363220": {
      "pl": "Złapali lwa żywcem.",
      "ru": null
    },
    "365737": {
      "pl": "Pospiesz się, bo nie złapiemy pociągu!",
      "ru": null
    },
    "368445": {
      "pl": "Złapano wszystkich, którzy przyszli.",
      "ru": null
    },
    "563499": {
      "pl": "Złapali lisa w pułapkę.",
      "ru": null
    },
    "567123": {
      "pl": "Kto ściga dwa zające, nie złapie żadnego.",
      "ru": null
    },
    "609458": {
      "pl": "Wypadek samochodowy przeszkodził mi w złapaniu pociągu.",
      "ru": null
    },
    "624775": {
      "pl": "Złapałem okropne przeziębienie.",
      "ru": "Я схватил ужасную простуду."
    },
    "669606": {
      "pl": "Bądźmy ostrożni i nie złapmy kataru.",
      "ru": null
    },
    "712431": {
      "pl": "Złapaliśmy złodzieja.",
      "ru": null
    },
    "933510": {
      "pl": "Złapała nas burza.",
      "ru": null
    },
    "1060667": {
      "pl": "Minutę szybciej i złapałbym autobus.",
      "ru": null
    },
    "2250188": {
      "pl": "Dwa dni temu złapałem przeziębienie.",
      "ru": "Два дня назад я подхватил простуду."
    },
    "3243625": {
      "pl": "Nikt cię nie złapie, bo ten koń biegnie szybciej niż wiatr.",
      "ru": "Никто не поймает тебя, потому что этот конь скачет быстрее ветра."
    },
    "3423242": {
      "pl": "Złapiemy cię.",
      "ru": null
    },
    "3435362": {
      "pl": "Co jeśli cię złapią?",
      "ru": null
    },
    "3660791": {
      "pl": "On złapał mnie za rękę.",
      "ru": "Он взял меня за руку."
    },
    "3781348": {
      "pl": "Wiesz, gdzie policja złapała Toma?",
      "ru": null
    },
    "4104335": {
      "pl": "Złapaliśmy dwa lisy.",
      "ru": null
    },
    "4106104": {
      "pl": "Złapałam psa za obrożę.",
      "ru": null
    },
    "4134041": {
      "pl": "Kilkoro odważnych pasażerów złapało tego kieszonkowca i przekazało go policji.",
      "ru": null
    },
    "4716839": {
      "pl": "Nie daj się złapać.",
      "ru": "Не дай себя поймать."
    },
    "5336515": {
      "pl": "Złap go!",
      "ru": null
    },
    "5627120": {
      "pl": "Złap go.",
      "ru": null
    },
    "5879317": {
      "pl": "Złapałem mysz.",
      "ru": "Я поймал мышь."
    },
    "6304254": {
      "pl": "Usiądźmy i złapmy oddech.",
      "ru": null
    },
    "7151424": {
      "pl": "Gdybym rozważał możliwość złapania grypy za każdym razem, gdy całuję dziewczynę, której nie znam,to nie miał bym żadnych szans z kobietami.",
      "ru": null
    },
    "7164852": {
      "pl": "Spróbuję złapać tego królika.",
      "ru": "Я попробую поймать этого кролика."
    },
    "7880468": {
      "pl": "Złapano ich.",
      "ru": null
    },
    "8716684": {
      "pl": "Czy Tom był złapany?",
      "ru": null
    },
    "8762678": {
      "pl": "Zostałem złapany.",
      "ru": null
    },
    "10091405": {
      "pl": "John złapał tygrysa i zastrzelił dwa lwy.",
      "ru": "Джон поймал тигра и застрелил двух львов."
    },
    "10234062": {
      "pl": "Złapałam pstrąga.",
      "ru": null
    },
    "10469339": {
      "pl": "Złapał osę.",
      "ru": null
    },
    "10599754": {
      "pl": "Złapcie mnie.",
      "ru": null
    },
    "10605195": {
      "pl": "Zostałam złapana.",
      "ru": null
    },
    "12188899": {
      "pl": "Złapał muchę.",
      "ru": null
    },
    "12470161": {
      "pl": "Czy można złapać rybę gołymi rękoma?",
      "ru": "Можно ли поймать рыбу голыми руками?"
    },
    "13225404": {
      "pl": "Przyjdę i cię złapię.",
