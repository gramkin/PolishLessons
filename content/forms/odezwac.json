    "11319350": {
      "pl": "Nie wiedziałam co powiedzieć, więc nie odezwałam się wcale.",
      "ru": null
    },
    "12045070": {
      "pl": "Odezwę się, gdy tylko uzyskam bardziej szczegółowe informacje.",
