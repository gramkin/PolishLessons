  "tatoeba": {
    "352454": {
      "pl": "Mówi po francusku z błędami.",
      "ru": null
    },
    "364803": {
      "pl": "Nie szukaj błędów w innych.",
      "ru": "Не ищи недостатки у других."
    },
    "564939": {
      "pl": "Nie ma błędu.",
      "ru": null
    },
    "588377": {
      "pl": "To częsty błąd.",
      "ru": "Это частая ошибка."
    },
    "765767": {
      "pl": "Ucz się na własnych błędach.",
      "ru": null
    },
    "872338": {
      "pl": "Doświadczenie to nazwa, którą każdy nadaje swoim błędom.",
      "ru": null
    },
    "908023": {
      "pl": "Każdy pogląd to mieszanka prawdy i błędów.",
      "ru": "Каждое из мнений — это смесь из истины и ошибок."
    },
    "940927": {
      "pl": "Rozmyślał nad swoimi błędami.",
      "ru": null
    },
    "1353418": {
      "pl": "Błąd został zrobiony.",
      "ru": "Была допущена ошибка."
    },
    "2178490": {
      "pl": "W twojej pracy jest błąd na błędzie i błędem pogania.",
      "ru": "В твоей работе ошибка на ошибке и ошибкой погоняет."
    },
    "3571719": {
      "pl": "Musicie się uczyć na błędach.",
      "ru": null
    },
    "3655616": {
      "pl": "Byłoby błędem zignorowanie rady Toma.",
      "ru": null
    },
    "3656686": {
      "pl": "Nie powinieneś bać się popełniać błędów, kiedy uczysz się języka.",
      "ru": "Ты не должен бояться совершать ошибки, когда изучаешь языки."
    },
    "3656757": {
      "pl": "Tutaj nie ma błędu.",
      "ru": "Тут нет ошибки."
    },
    "3951182": {
      "pl": "To był twój błąd.",
      "ru": "Это была твоя ошибка."
    },
    "4658535": {
      "pl": "Pomoc jemu była błędem.",
      "ru": null
    },
    "7680880": {
      "pl": "Nie zrób błędu.",
      "ru": null
    },
    "8662750": {
      "pl": "Tom rzadko robi błędy, kiedy pisze po francusku.",
      "ru": "Том редко делает ошибки, когда пишет по-французски."
    },
    "10768376": {
      "pl": "Musimy naprawić swoje błędy.",
      "ru": "Нам надо исправить свои ошибки."
    },
    "11331700": {
      "pl": "Cieszę się, że byłem w błędzie.",
      "ru": "Я рад, что ошибался."
    },
    "12359835": {
      "pl": "Nie popełniaj tego samego błędu, co ja.",
      "ru": "Не совершай той же ошибки, что и я."
    },
    "13000432": {
      "pl": "Czy naprawdę myślisz, że tom jest w błędzie?",
      "ru": "Вы действительно думаете, что Том не прав?"
    },
    "13084409": {
      "pl": "To najczęściej spotykany błąd.",
      "ru": "Это наиболее часто встречающаяся ошибка."
    },
    "13582738": {
      "pl": "Sztuczna inteligencja może popełniać błędy.",
      "ru": "ИИ может ошибаться."
    }
