  "tatoeba": {
    "363776": {
      "pl": "Całe życie mieszkam w tej dzielnicy, z tymi samymi sąsiadami.",
      "ru": null
    },
    "567473": {
      "pl": "Zostaw mnie samą!",
      "ru": null
    },
    "623167": {
      "pl": "Mogę to zrobić sam.",
      "ru": "Я сам могу это сделать."
    },
    "705240": {
      "pl": "Zagadałem do samej aktorki.",
      "ru": null
    },
    "838949": {
      "pl": "Nasza drużyna jest na samym dole tabeli.",
      "ru": "Наша команда находится в подвале турнирной таблицы."
    },
    "936097": {
      "pl": "Dzieci tej samej matki, lecz innego ojca, nazywa się braćmi lub siostrami przyrodnimi.",
      "ru": "Дети от одной матери, но разных отцов, называются сводными братьями или сёстрами."
    },
    "959809": {
      "pl": "Wszyscy jedli to samo.",
      "ru": "Все ели одно и то же."
    },
    "2118979": {
      "pl": "Nie ufam nikomu, nawet samemu sobie",
      "ru": "Я не доверяю никому, даже самому себе."
    },
    "2148492": {
      "pl": "Trzeba było tam pójść samemu.",
      "ru": "Надо было самому туда зайти."
    },
    "3108086": {
      "pl": "Nie zostawiaj ich samych.",
      "ru": null
    },
    "3141061": {
      "pl": "Nie zostawiaj mnie samej!",
      "ru": null
    },
    "3660731": {
      "pl": "Pozwól mu zrobić to samemu.",
      "ru": "Позволь сделать это ему самому."
    },
    "3701835": {
      "pl": "Jestem tego samego zdania, co Tom.",
      "ru": "Я того же мнения, что и Том."
    },
    "4719246": {
      "pl": "Mary była w samych szortach.",
      "ru": "Мэри была в одних шортах."
    },
    "5514964": {
      "pl": "Byłyście tu same?",
      "ru": null
    },
    "5891215": {
      "pl": "Czemu nie możemy łaskotać sami siebie?",
      "ru": "Почему мы не можем щекотать самих себя?"
    },
    "6329826": {
      "pl": "Nie chcę iść sama.",
      "ru": "Я не хочу идти одна."
    },
    "6534365": {
      "pl": "Tom był w samych majtkach.",
      "ru": null
    },
    "6684251": {
      "pl": "Nigdy nie zostawiłbym go samego.",
      "ru": "Я бы никогда не оставил его одного."
    },
    "6995442": {
      "pl": "Obaj są w tym samym wieku.",
      "ru": "Они оба одного возраста."
    },
    "7960589": {
      "pl": "Zostały mamami tego samego dnia.",
      "ru": "Они стали мамами в один и тот же день."
    },
    "8617195": {
      "pl": "W samą porę.",
      "ru": null
    },
    "8760922": {
      "pl": "Czy jest pan sam?",
      "ru": "Вы один?"
    },
    "8989734": {
      "pl": "Jesteśmy same?",
      "ru": null
    },
    "10568864": {
      "pl": "Jesteś sama?",
      "ru": "Вы одна?"
    },
    "12470516": {
      "pl": "Bywasz czasem sama?",
      "ru": "Ты когда-нибудь бываешь одна?"
    },
    "12470532": {
      "pl": "Jesteś tak samo winna jak on.",
      "ru": "Ты так же виновата, как и он."
    },
    "12476525": {
      "pl": "Tom szedł sam.",
      "ru": "Том шёл один."
    },
    "12567517": {
      "pl": "Przyszedłeś w samą porę.",
      "ru": "Ты пришёл как раз вовремя."
    },
    "13239013": {
      "pl": "Groch i fasola to nie to samo.",
      "ru": "Горох и фасоль — это не одно и то же."
    },
    "13785274": {
      "pl": "Tom bardzo chce spać i jego oczy same się zamykają.",
      "ru": "Том очень хочет спать, и глаза у него закрываются."
    },
    "13785413": {
      "pl": "Oni wszyscy są w tym samym wieku.",
      "ru": "Они все ровесники."
    }
