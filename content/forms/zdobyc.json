  "tatoeba": {
    "351312": {
      "pl": "Co zdobyłeś?",
      "ru": null
    },
    "367003": {
      "pl": "Możliwe, że Luciano zdobędzie głosy, ale wciąż brak mu doświadczenia.",
      "ru": null
    },
    "403735": {
      "pl": "Chwalił się zdobyciem pierwszej nagrody.",
      "ru": null
    },
    "403736": {
      "pl": "Zdobycie pracy to dla niego ważna sprawa.",
      "ru": null
    },
    "410000": {
      "pl": "Zdołałem zdobyć pierwszą nagrodę.",
      "ru": null
    },
    "412995": {
      "pl": "Zdobył duże pieniądze.",
      "ru": null
    },
    "479998": {
      "pl": "Cała drużyna była w siódmym niebie po zdobyciu mistrzostwa w piłce nożnej.",
      "ru": null
    },
    "527440": {
      "pl": "Michiko gada tak, jakby sama zdobyła biegun północny.",
      "ru": null
    },
    "567088": {
      "pl": "Jak tylko zdobędę bilety, prześlę ci je.",
      "ru": null
    },
    "657360": {
      "pl": "Nigdy nie myślałem, że zdobędę tę nagrodę.",
      "ru": null
    },
    "728418": {
      "pl": "W końcu zdobyłem tę książkę.",
      "ru": null
    },
    "817197": {
      "pl": "To pierwszy złoty medal, jaki zdobyła.",
      "ru": null
    },
    "880356": {
      "pl": "Chciałem zdobyć duże pieniądze.",
      "ru": null
    },
    "907937": {
      "pl": "Zupełnie nie oczekiwałem, że zdobędę nagrodę.",
      "ru": null
    },
    "944189": {
      "pl": "Wielu wielkich myślicieli, którzy byli nieznani za życia, zdobyło sławę po śmierci.",
      "ru": null
    },
    "957165": {
      "pl": "Te pieniądze nie zostały zdobyte uczciwie.",
      "ru": null
    },
    "976150": {
      "pl": "Jeśli nie zdobędziemy szybko czegoś do jedzenia, wszyscy umrzemy z głodu.",
      "ru": null
    },
    "1086555": {
      "pl": "Już kiedyś zdobyłem Górę Fudżi.",
      "ru": null
    },
    "1349043": {
      "pl": "Chcę zdobyć papierosy.",
      "ru": null
    },
    "1729043": {
      "pl": "Chyba zdobędzie pierwszą nagrodę.",
      "ru": null
    },
    "1982548": {
      "pl": "Jestem zaskoczony że zdobyłaś tę nagrodę.",
      "ru": null
    },
    "2246974": {
      "pl": "Gdzie to zdobyłeś?",
      "ru": null
    },
    "2576139": {
      "pl": "Dziesięć drużyn walczyło o zdobycie nagrody.",
      "ru": null
    },
    "3127244": {
      "pl": "Zdobyłeś przyjaciół?",
      "ru": null
    },
    "3850203": {
      "pl": "Zdobyłem to.",
      "ru": null
    },
    "6324394": {
      "pl": "Zdobyłyśmy to dzięki niej.",
      "ru": null
    },
    "8679399": {
      "pl": "Słowaccy pszczelarze zdobyli sześć medali na międzynarodowej konferencji w Argentynie.",
      "ru": "На Международном конгрессе в Аргентине словацкие пчеловоды завоевали шесть медалей."
    },
    "10458835": {
      "pl": "Było ono łatwe do zdobycia.",
      "ru": null
    },
