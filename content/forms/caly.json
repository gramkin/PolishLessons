  "tatoeba": {
    "352530": {
      "pl": "Płakała całą noc.",
      "ru": "Она рыдала всю ночь."
    },
    "367609": {
      "pl": "Zabawmy się na całego.",
      "ru": null
    },
    "416249": {
      "pl": "Gnał z całych sił.",
      "ru": null
    },
    "531623": {
      "pl": "Całą noc padał śnieg.",
      "ru": "Всю ночь шёл снег."
    },
    "661292": {
      "pl": "Biegł z całych sił.",
      "ru": "Он бежал во всю прыть."
    },
    "675373": {
      "pl": "Śnieg padał cały dzień.",
      "ru": "Снег шёл весь день."
    },
    "933113": {
      "pl": "Dziękuję z całego serca.",
      "ru": null
    },
    "1165159": {
      "pl": "Mam cały dom dla siebie.",
      "ru": "Дом принадлежит мне одному."
    },
    "1188563": {
      "pl": "Boli mnie całe ciało.",
      "ru": "У меня болит всё тело."
    },
    "1355023": {
      "pl": "Starała się z całych sił, ale nie udało się/, ale na próżno.",
      "ru": "Она старалась изо всех сил, и у неё не получилось."
    },
    "1473509": {
      "pl": "Była piękniejsza niż cała reszta.",
      "ru": "Она была красивее, чем все другие."
    },
    "2164558": {
      "pl": "Całe miasto było w ogniu.",
      "ru": "Весь город был в огне."
    },
    "3520418": {
      "pl": "Wilk syty i owca cała.",
      "ru": "Охраняемую овцу и волк опасается."
    },
    "3599503": {
      "pl": "Cała jego rodzina została rozstrzelana przez Niemców.",
      "ru": "Всю его семью расстреляли немцы."
    },
    "3656241": {
      "pl": "Tomek chciał wykrzyczeć całemu światu, że kocha się w Marii.",
      "ru": null
    },
    "3743858": {
      "pl": "Skóra odpada całymi płatami.",
      "ru": null
    },
    "4719310": {
      "pl": "Mary była jedną z najpiękniejszych dziewczyn w całej szkole. Ale mimo tego nigdy nie miała chłopaka.",
      "ru": "Мэри — одна из самых красивых девчонок во всей школе. Но несмотря на это, у неё никогда не было парня."
    },
    "4790288": {
      "pl": "Szukam mapy nie Polski, a całej Europy.",
      "ru": "Я ищу карту не Польши, а всей Европы."
    },
    "6305633": {
      "pl": "Tłumaczę całymi dniami.",
      "ru": null
    },
    "8666083": {
      "pl": "Całe miasto pokryte było żółtym pyłem.",
      "ru": "Весь город был покрыт жёлтой пылью."
    },
    "10698013": {
      "pl": "Psy szczekały całą noc.",
      "ru": "Собаки лаяли всю ночь."
    },
    "12076173": {
      "pl": "Bawiliśmy się na całego.",
      "ru": null
    },
    "12624949": {
      "pl": "Miał ochotę podzielić się swoim żalem z całym światem.",
      "ru": "Ему хотелось поделиться своим горем со всем миром."
    },
    "12624951": {
      "pl": "Miał ochotę podzielić się swoim smutkiem z całym światem.",
      "ru": "Ему хотелось поделиться своим горем со всем миром."
    },
    "12624954": {
      "pl": "Miał ochotę podzielić się swoją radością z całym światem.",
      "ru": "Ему хотелось поделиться своей радостью со всем миром."
    },
    "12950803": {
      "pl": "Cały tydzień pracowałem.",
      "ru": "Я всю неделю работал."
    },
    "12955969": {
      "pl": "Całymi dniami płaczę.",
      "ru": null
    },
    "13014661": {
      "pl": "Dlaczego ludzie opuścili Afrykę i zaczęli rozprzestrzeniać się po całej planecie?",
      "ru": "Почему человек покинул Африку и начал расселяться по планете?"
    }
  }
